                </operatingObjectChanges>
				
				<operatingSounds>
					<work linkNode="soundNode" file="sound/objElectricGenerator_01.wav" innerRadius="7" outerRadius="10" loops="0" fadeIn="0.1" fadeOut="0.1" volumeScale="0.7">
						<volume indoor="0.35" outdoor="0.85" />
						<pitch indoor="1" outdoor="1"/>
						<lowpassGain indoor="0.5" outdoor="1"/>
					</work>
				</operatingSounds>
				
				<playerTrigger menuAction="INTERACT" node="playerTrigger"/>
            </production>
        </productions>
		
