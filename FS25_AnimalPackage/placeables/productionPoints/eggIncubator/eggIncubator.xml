	</placement>
	
	<hotspots/>
       
	<animatedObjects>
		<animatedObject saveId="incubatorDoors" >
            <animation duration="1.0">
                <part node="doorLeft">
                    <keyFrame time="0.0" rotation="0 0 0"/>
                    <keyFrame time="1.0" rotation="0 -105 0"/>
                </part>
				
				<part node="doorRight">
                    <keyFrame time="0.0" rotation="0 0 0"/>
                    <keyFrame time="1.0" rotation="0 100 0"/>
                </part>
				
				<part node="unloading">
                    <keyFrame time="0.0" translation="0 -100 0"/>
                    <keyFrame time="1.0" translation="0 0 0"/>
                </part>
				
				<part node="loading">
                    <keyFrame time="0.0" translation="0 -100 0"/>
                    <keyFrame time="1.0" translation="0 0 0"/>
                </part>
            </animation>
            <controls triggerNode="eggIncubatorDoors_trigger" posAction="INTERACT" posText="Open" negText="Close" />
			
			<sounds>
                <moving template="fenceMetalLoop"   linkNode="eggIncubatorDoors_trigger" pitchScale="0.7" volumeScale="0.2"/>
                <posEnd template="fenceMetalOpen"   linkNode="eggIncubatorDoors_trigger" pitchScale="0.7" volumeScale="0.1"/>
                <negEnd template="fenceMetalClose"  linkNode="eggIncubatorDoors_trigger" pitchScale="0.7" volumeScale="0.1"/>
            </sounds>
        </animatedObject>
    </animatedObjects>

