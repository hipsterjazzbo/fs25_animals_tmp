        <clearArea startNode="0>13|1" widthNode="0>13|1|0" heightNode="0>13|1|1"/>
        <clearArea startNode="0>13|2" widthNode="0>13|2|0" heightNode="0>13|2|1"/>
    </clearAreas>
	
	<leveling requireLeveling="true" maxSmoothDistance="1" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="0>14|0" widthNode="0>14|0|0" heightNode="0>14|0|1" groundType="grass"/>
        </levelAreas>
		<paintAreas> 
             <paintArea startNode="0>17|2" widthNode="0>17|2|0" heightNode="0>17|2|1" groundType="dirt" /> 
             <paintArea startNode="0>13|3" widthNode="0>13|3|0" heightNode="0>13|3|1" groundType="dirt" /> 
             <paintArea startNode="0>17|3" widthNode="0>17|3|0" heightNode="0>17|3|1" groundType="mud" /> 
		</paintAreas>
    </leveling>
	
	<indoorAreas>
        <indoorArea startNode="0>17|0" widthNode="0>17|0|0" heightNode="0>17|0|1" />
        <indoorArea startNode="0>17|1" widthNode="0>17|1|0" heightNode="0>17|1|1" />
    </indoorAreas>
	
	<ai>
        <updateAreas>
            <updateArea startNode="0>16|0" endNode="0>16|0|0" />
        </updateAreas>
    </ai>
	
</placeable>