<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="livestockTrailerPushable" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">
	<storeData>
        <name>$l10n_shopItem_oldAnimalTrailer</name>
		
		<functions>
            <function>$l10n_function_oldAnimalTrailer</function>
        </functions>
        <image>transport/store_oldAnimalTrailer.png</image>
        <price>350</price>
        <lifetime>600</lifetime>
        <rotation>180</rotation>
        <brand>LIZARD</brand>
        <category>misc</category>
        <shopHeight>1.2</shopHeight>
        <shopTranslationOffset>0 -0.004 0</shopTranslationOffset>
        <shopRotationOffset>-0.216 0 0</shopRotationOffset>
    </storeData>
    
	<base>
        <typeDesc>$l10n_shopItem_oldAnimalTrailer</typeDesc>
        <filename>transport/oldAnimalTrailer.i3d</filename>
        <size width="1.05" length="3.366" height="1.4" />
		<supportsRadio>false</supportsRadio>
		<canBeReset>true</canBeReset>
		<supportsPickUp>true</supportsPickUp>
        <components>
            <component centerOfMass="0 0.1 -0.4" solverIterationCount="10" mass="150"/>
        </components>
        <schemaOverlay attacherJointPosition="0 0" name="TRAILER" />
		<mapHotspot type="TRAILER" />
    </base>

	<wheels>
        <wheelConfigurations>
			<wheelConfiguration name="$l10n_configuration_valueDefault" price="0">
				<wheels autoRotateBackSpeed="1.6">
					<wheel filename="$data/shared/wheels/tires/bkt/TF8181/5_50__16.xml" hasTireTracks="true" hasParticles="true" isCareWheel="true">
                        <physics rotSpeed="1" restLoad="0.5" repr="frontWheelBase" driveNode="wheelMiddle" useReprDirection="false" radius="0.12" width="0.1" initialCompression="25" suspTravel="0.05" spring="10" damper="20" mass="0.05"/>
                        <outerRim filename="$data/shared/wheels/rims/volvo/rim02.i3d" node="0|0" widthAndDiam="21 18"/>
						<innerRim filename="-" />
						<tire maxDeformation="0.02" />
					</wheel>
					
                    <wheel filename="$data/shared/wheels/tires/bkt/TF8181/5_50__16.xml" hasTireTracks="true" hasParticles="true" isCareWheel="true">
                        <physics rotSpeed="1" restLoad="0.5" repr="wheelLeft" useReprDirection="false" radius="0.21" width="0.13" initialCompression="25" suspTravel="0.15" spring="25" damper="30" mass="0.1"/>
                        <outerRim filename="$data/shared/wheels/rims/volvo/rim02.i3d" node="0|0" widthAndDiam="21 18"/>
						<innerRim filename="-" />
						<tire maxDeformation="0.02" />					
					</wheel>
                    
					<wheel filename="$data/shared/wheels/tires/bkt/TF8181/5_50__16.xml" isLeft="false" hasTireTracks="true" hasParticles="true" isCareWheel="true">
					    <physics rotSpeed="1" restLoad="0.5" repr="wheelRight" useReprDirection="false" radius="0.21" width="0.13" initialCompression="25" suspTravel="0.15" spring="25" damper="30" mass="0.1"/>
                        <outerRim filename="$data/shared/wheels/rims/volvo/rim02.i3d" node="0|1" widthAndDiam="21 18"/>
						<innerRim filename="-" />
						<tire maxDeformation="0.02" />
					</wheel>
				</wheels>
            </wheelConfiguration>
        </wheelConfigurations>

        <ackermannSteeringConfigurations>
            <ackermannSteering rotSpeed="65" rotMax="35" rotCenterWheel1="2" rotCenterWheel2="3" rotCenterNode="frontWheelBase"/>
        </ackermannSteeringConfigurations>

		<hubs>
            <color0>FENDT_BLACK1</color0>
            <color1>FENDT_BLACK1</color1>
            <hub linkNode="wheelLeft"  filename="$data/shared/wheels/hubs/hub_n10_5.xml" isLeft="true"  scale="0.15 0.22 0.22" />
            <hub linkNode="wheelRight" filename="$data/shared/wheels/hubs/hub_n10_5.xml" isLeft="false" scale="0.15 0.22 0.22" />
			<hub linkNode="wheelMiddle" filename="$data/shared/wheels/hubs/hub_n10_5.xml" isLeft="true"  scale="0.2 0.22 0.22" />
        </hubs>
    </wheels>

	<attachable>
        <inputAttacherJoints>
            <inputAttacherJoint node="attacherJoint" jointType="trailer" attacherHeight="0.58" />
        </inputAttacherJoints>
        <!-- <support animationName="moveSupport"/> -->
        <brakeForce force="0.1"/>
		
		<sounds>
            <active file="$data/sounds/tools/trailer/trailerRattle_02.wav" innerRadius="10" outerRadius="50" volumeScale="5" isLocalSound="true" pitchScale="0.9">
                <volume indoor="0.6" outdoor="0.9" >
                    <modifier type="WHEEL_SUSPENSION" value="-0.07" modifiedValue="0.4"/>
                    <modifier type="WHEEL_SUSPENSION" value="-0.00" modifiedValue="0.0"/>
                    <modifier type="WHEEL_SUSPENSION" value="0.07" modifiedValue="0.4"/>

                    <modifier type="SPEED" value="0.0" modifiedValue="0.0"/>
                    <modifier type="SPEED" value="1.0" modifiedValue="1.0"/>
                    <modifier type="SPEED" value="10.0" modifiedValue="1.0"/>
                </volume>
                <lowpassCutoffFrequency indoor="300" outdoor="20000" />
                <lowpassGain indoor="0.7" outdoor="1" />
            </active>
        </sounds>
    </attachable>
	
	<enterable isTabbable="false" enterText="$l10n_enterText_oldAnimalTrailer">
        <enterReferenceNode node="enterReferenceNode" interactionRadius="2.0"/>
        <exitPoint node="enterReferenceNode"/>
		<nicknameRenderNode node="playerNode" offset="0 2 0"/>
        
		<cameras>
            <camera node="outdoorCamera" rotatable="true" rotateNode="outdoorCameraTarget" limit="true" useWorldXZRotation="true" rotMinX="-1.4" rotMaxX="1" transMin="3" transMax="20">
                <raycastNode node="cameraRaycastNode1"/>
                <raycastNode node="cameraRaycastNode2"/>
            </camera>
            <camera node="indoorCamera" rotatable="true" limit="true" rotMinX="-1.1" rotMaxX="0.4" transMin="0" transMax="0" useMirror="true" isInside="false" />
        </cameras>

		<characterNode node="skeleton" animationNode="2" cameraMinDistance="1.75" spineRotation="270 0 90" useAnimation="true" />
    </enterable>

	<motorized turnOnText="$l10n_action_oldAnimalTrailerOnText" turnOffText="$l10n_action_oldAnimalTrailerOffText" forceSpeedHudDisplay="true">
        <differentialConfigurations>
            <differentialConfiguration>
                <differentials>
                    <differential torqueRatio="0.2" maxSpeedRatio="3.0" wheelIndex1="2" wheelIndex2="3"/>
                </differentials>
            </differentialConfiguration>
        </differentialConfigurations>
       	
		<motorConfigurations>
			<motorConfiguration price="0" hp="8.7">
                <motor torqueScale="0.077" minRpm="850" maxRpm="2200" maxForwardSpeed="7" maxBackwardSpeed="5" brakeForce="0.1" lowBrakeForceScale="0.1" accelerationLimit="1.6" dampingRateScale="0.08">
                    <torque normRpm="0.45" torque="0.9"/>
                    <torque normRpm="0.5" torque="0.97"/>
                    <torque normRpm="0.59" torque="1"/>
                    <torque normRpm="0.72" torque="1"/>
                    <torque normRpm="0.86" torque="0.88"/>
                    <torque normRpm="1" torque="0.72"/>
                </motor>
                <transmission minForwardGearRatio="118" maxForwardGearRatio="320" minBackwardGearRatio="165" maxBackwardGearRatio="320"/>
            </motorConfiguration>
        </motorConfigurations>
    </motorized>

	<pushHandTool>
        <raycast node1="raycast01" node2="raycast02" playerNode="playerNode" positionSmoothnessFactor="0.65" positionSmoothnessFactorSteering="0"/>
        <wheels front="2 3" back="1"/>
		<spine rotationForward="-10" rotationBackward="-10" rotationIdle="-5" speed="40"/> <!-- ratio="0.6 0.2 0.2" -->
        
		<ikChains>
            <target ikChain="rightArm"  targetNode="playerRightHandTarget" poseId="wideFingers" /> 
            <target ikChain="leftArm"   targetNode="playerLeftHandTarget" poseId="wideFingers"/>
        </ikChains>

		<customChainLimits>
            <customChainLimit chainId="leftArm" nodeIndex="1" minRx="-50" maxRx="50" minRy="-80" maxRy="80" minRz="-75" maxRz="10" localLimits="true"/>
            <customChainLimit chainId="leftArm" nodeIndex="2" minRx="-25" maxRx="25" minRy="-144" maxRy="-25" minRz="-10" maxRz="10" localLimits="true"/>

            <customChainLimit chainId="rightArm" nodeIndex="1" minRx="-50" maxRx="50" minRy="-80" maxRy="80" minRz="-75" maxRz="10" localLimits="true"/>
            <customChainLimit chainId="rightArm" nodeIndex="2" minRx="-25" maxRx="25" minRy="-144" maxRy="-25" minRz="-10" maxRz="10" localLimits="true"/>
        </customChainLimits>

        <playerConditionalAnimation>
            <item id="idle" entryTransitionDuration="0.25" exitTransitionDuration="0.25" >
                <clips>
                    <clip clipName="idle1Source" />
                </clips>
                <conditions>
                    <conditionGroup>
                        <condition parameter="absSmoothedForwardVelocity" lower="0.2" />
                    </conditionGroup>
                </conditions>
            </item>
            <item id="walk" entryTransitionDuration="0.25" exitTransitionDuration="0.25" >
                <clips speedScaleType="distance" speedScaleParameter="1.8">
					<clip clipName="NPCWalkMale03Source" />
                </clips>
                <conditions>
                    <conditionGroup>
                        <condition parameter="smoothedForwardVelocity" between="0.3, 4"/>
                    </conditionGroup>
                </conditions>
            </item>
            <item id="walkBack" entryTransitionDuration="0.5" exitTransitionDuration="0.25" >
                <clips speedScaleType="distance" speedScaleParameter="2.25">
                    <clip clipName="walkBwdLoopSource" />
                </clips>
                <conditions>
                    <conditionGroup>
                        <condition parameter="smoothedForwardVelocity" between="-3, -0.3" />
                    </conditionGroup>
                </conditions>
            </item>
        </playerConditionalAnimation>
    </pushHandTool>

	<lights>
	</lights>

	<ai supportsAIJobs="false">
        <agentAttachment />
    </ai>
    
	<drivable>
        <sounds>
            <waterSplash template="waterSplash01"/>
        </sounds>
        <cruiseControl enabled="false"/>
    </drivable> 

	<animations>
		<animation name="backDoorAnim">
            <part node="doorLocks"  startTime="0.0" endTime="1.5" startRot="76.717 0 0" endRot="-180 0 0" />
            <part node="backDoor"   startTime="1.5" endTime="3.5" startRot="0 0 0" endRot="-110 0 0" />

			<sound template="clackVar6"          startTime="0.1"                direction="1"  volumeScale="1.3" pitchScale="1.4" linkNode="doorLocks"/>
			<sound template="clackVar1"          startTime="0.0"                direction="-1"  volumeScale="1.3" pitchScale="1.4" linkNode="doorLocks"/>
            
			<sound template="metalOpen"          startTime="1.5"                direction="0"  volumeScale="1.3" pitchScale="1.4" />
            <sound template="metalDoorsLoop"     startTime="1.5"  endTime="3.5" direction="0"  volumeScale="1"   pitchScale="0.7" linkNode="backDoor"/>
            <sound template="hingeMedium"        startTime="1.5"                direction="1"  volumeScale="1"   pitchScale="0.7" linkNode="backDoor"/>
            <sound template="sheetImp02"         startTime="3.5"                direction="1"  volumeScale="1.3" pitchScale="1.6" linkNode="backDoor"/>
            <sound template="sheetImp02"         startTime="0.0"                direction="-1"  volumeScale="1.3" pitchScale="1.6" linkNode="backDoor"/>
			<sound template="metalClose"         startTime="1.7"                direction="-1" volumeScale="1"   pitchScale="1.3" linkNode="backDoor"/>
        </animation>
		
		<animation name="fillAnimation">
            <!-- <part node="strawPlane" startTime="0" endTime="1.0" startScale="0 0 0" endScale="1 1 1" /> -->
			<part node="strawPlane"  startTime="0"    endTime="0.05" visibility="false" />
            <part node="strawPlane"  startTime="0.05" endTime="0.1"  visibility="true" />
        </animation>
		
		<animation name="tipAnimationBack">
            <part node="doorLocks"  startTime="0.0" endTime="1.5" startRot="76.717 0 0" endRot="-180 0 0" />
            <part node="backDoor"   startTime="1.5" endTime="3.5" startRot="0 0 0" endRot="-110 0 0" />
			
			<part node="broomActive"  startTime="3.5"  endTime="3.55"  visibility="false" />
            <part node="broomActive"  startTime="3.55" endTime="3.56"  visibility="true" />
			<part node="broomActive"  startTime="3.57" endTime="4.57"  startTrans="-0.07 -1.425 -0.683" endTrans="-0.07 -1.425 -3.426" />
			<part node="broomActive"  startTime="4.57" endTime="5.0"  startTrans="-0.07 -1.425 -3.426" endTrans="-0.07 -1.425 -0.683" />
						
			<sound template="metalOpen"          startTime="1.5"                direction="0"  volumeScale="1.3" pitchScale="1.4" />
            <sound template="metalDoorsLoop"     startTime="1.5"  endTime="3.5" direction="0"  volumeScale="1"   pitchScale="0.7" linkNode="backDoor"/>
            <sound template="hingeMedium"        startTime="1.5"                direction="1"  volumeScale="1"   pitchScale="0.7" linkNode="backDoor"/>
            <sound template="sheetImp02"         startTime="3.5"                direction="1"  volumeScale="1.3" pitchScale="1.6" linkNode="backDoor"/>
            <sound template="sheetImp02"         startTime="0.0"                direction="-1"  volumeScale="1.3" pitchScale="1.6" linkNode="backDoor"/>
			<sound template="metalClose"         startTime="1.7"                direction="-1" volumeScale="1"   pitchScale="1.3" linkNode="backDoor"/>
        </animation>
	</animations>
	
	<foldable>
        <foldingConfigurations>
            <foldingConfiguration>
                <foldingParts startMoveDirection="-1" requiresPower="false">
                    <foldingPart animationName="backDoorAnim" speedScale="1.0" />
                </foldingParts>
            </foldingConfiguration>
        </foldingConfigurations>
    </foldable>
	
	<tensionBeltObject>
        <meshNodes>
            <meshNode node="oldAnimalTrailer_vis"/>
        </meshNodes>
    </tensionBeltObject>	

	<turnOnVehicle isAlwaysTurnedOn="false"/>
	
	<fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits removeVehicleIfEmpty="false">
                    <fillUnit unitTextOverride="$l10n_unit_liter" fillTypes="STRAW MANURE" capacity="700" updateMass="false" showOnHud="true" showOnInfoHud="true" showInShop="false">
						<exactFillRootNode node="exactFillRootNode" />
						<fillLevelAnimation name="fillAnimation" resetOnEmpty="true" />
					</fillUnit>	
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <dischargeable requiresTipOcclusionArea="false">
        <dischargeNode node="dischargeNode" emptySpeed="80" fillUnitIndex="1" maxDistance="3" canStartDischargeAutomatically="false" playSound="false" canDischargeToGround="true" canDischargeToGroundAnywhere="true"/>
    </dischargeable>
	
	<trailer>
        <trailerConfigurations>
            <trailerConfiguration>
                <trailer>
                    <tipSide name="$l10n_info_tipSideBack" dischargeNodeIndex="1">
                        <animation name="tipAnimationBack" speedScale="1.0" startTipTime="0.35"/>
                    </tipSide>
                </trailer>
            </trailerConfiguration>
        </trailerConfigurations>
    </trailer>
	
	<livestockTrailer>
		<animal type="cow" 		node="cows" numSlots="4" />
        <animal type="pig" 		node="pigs" numSlots="7" />
        <animal type="sheep" 	node="sheeps" numSlots="4" />
        <animal type="chicken" 	node="chickens" numSlots="12" />
        <animal type="rabbit" 	node="chickens" numSlots="12" />
		
        <baleTrigger node="baleTrigger" inputLitresPerSecond="200" fillUnitIndex="1"/>
        <bedding conversionSeconds="60" minimumAnimals="1" fillType="STRAW" convertedFillType="MANURE"/>
    </livestockTrailer>

    <animatedLivestockTrailer
        alignToTerrain="false"
        useSpeedAnimations="false"
        maximumLoadAge="6"
        unsupportedAgeWarningText="$l10n_warning_animalAgeNotSupportedByTrailer"
        randomIdleStart="true"
        showOnHud="true"
        useAnimalSounds="true"
        animalSoundVolumeScale="0.22"
        animalSoundMinInterval="8000"
        animalSoundMaxInterval="22000"
        animalSoundMinimumInterval="3500"
        groundOffset="0.00"
        walkSpeed="0.5"
        runSpeed="9"
        idleClip="idle1Source"
        walkClip="walkFwdLSource"
        runClip="runFwdLSource"
        playbackScale="1"
        referenceWalkSpeed="4"
        referenceRunSpeed="12">
    </animatedLivestockTrailer>
    
	<foliageBending>
        <bendingNode minX="-0.5" maxX="0.5" minZ="-1.125" maxZ="1.101" yOffset="0.2"/>
    </foliageBending>

	<rimColorConfigurations price="0" useDefaultColors="true" >
        <rimColorConfiguration color="0.065 0.085 0.054" name="STANDARD"/>
		<rimColorConfiguration color="FENDT_RED1"/>
    </rimColorConfigurations>

	<wearable wearDuration="480" workMultiplier="5" fieldMultiplier="2"/>
    <washable dirtDuration="90" washDuration="1" workMultiplier="6" fieldMultiplier="2"/>
       
	<i3dMappings>
		<i3dMapping id="oldAnimalTrailer_main_component1" node="0>" />
