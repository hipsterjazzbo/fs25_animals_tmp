		<i3dMapping id="cameraRaycastNode2" node="0>6|3" />
		<i3dMapping id="playerNode" node="0>7|0" />
		<i3dMapping id="skeleton" node="0>7|0|0" />
		<i3dMapping id="raycast01" node="0>7|1" />
		<i3dMapping id="raycast02" node="0>7|2" />
		<i3dMapping id="broomActive" node="0>2|6|0" />
		<i3dMapping id="exactFillRootNode" node="0>8|0" />
		<i3dMapping id="baleTrigger" node="0>8|1" />
