		<i3dMapping id="oldAnimalTrailer_vis" node="0>2" />
		<i3dMapping id="backDoor" node="0>2|0" />
		<i3dMapping id="doorLocks" node="0>2|0|0" />
		<i3dMapping id="backDoorCol" node="0>2|0|1" />
		<i3dMapping id="animals" node="0>3" />
		<i3dMapping id="cows" node="0>3|0" />
		<i3dMapping id="cow" node="0>3|0|0" />
		<i3dMapping id="pigs" node="0>3|1" />
		<i3dMapping id="pig" node="0>3|1|0" />
		<i3dMapping id="sheeps" node="0>3|2" />
		<i3dMapping id="sheep" node="0>3|2|0" />
		<i3dMapping id="chickens" node="0>3|3" />
		<i3dMapping id="chicken" node="0>3|3|0" />
		<i3dMapping id="steeringBase" node="0>2|3" />
		<i3dMapping id="steeringWheel" node="0>2|3|0" />
		<i3dMapping id="playerRightHandTarget" node="0>2|3|0|0" />
		<i3dMapping id="playerLeftHandTarget" node="0>2|3|0|1" />
		<i3dMapping id="enterReferenceNode" node="0>5" />
		<i3dMapping id="cameras" node="0>6" />
		<i3dMapping id="outdoorCameraTarget" node="0>6|0" />
		<i3dMapping id="outdoorCamera" node="0>6|0|0" />
