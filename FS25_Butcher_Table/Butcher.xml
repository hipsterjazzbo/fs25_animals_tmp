<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="extendedProductionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/placeable.xsd">
    <storeData>
        <name>$l10n_shopItem_Butcher</name>
        <functions>
            <function>$l10n_function_Butcher</function>
        </functions>
        <image>store_ButcherRock.dds</image>
        <price>25000</price>
        <dailyUpkeep>10</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>factories</tab>
        </brush>
        
            </storeData>

    <base>
        <filename>DairyRock.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
        <canBeDeleted>true</canBeDeleted>
        <boughtWithFarmland>false</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>
        <sounds>
            <place template="smallImp"/>
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30" >
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="asphalt"/>
        </levelAreas>
        <paintAreas>
            <paintArea startNode="paintAreaStart01" widthNode="paintAreaWidth01" heightNode="paintAreaHeight01" groundType="asphalt"/>
        </paintAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01" />
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger"/>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker" teleportNode="playerTriggerMarker" />
    </hotspots>

    <dynamicallyLoadedParts>
        <dynamicallyLoadedPart node="0" linkNode="lightSwitch01" filename="$data/shared/assets/lights/rudolfHormann/powerSwitch.i3d" />
    </dynamicallyLoadedParts>

    <triggerMarkers>
        <triggerMarker node="warningStripes01"/>
        <triggerMarker node="warningStripes02"/>
        <triggerMarker node="unloadTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconUnload.i3d"/>
        <triggerMarker node="playerTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
    </triggerMarkers>

    <lights>
        <sharedLight filename="$data/shared/assets/lights/terraLed/fluorescentTube50W.xml" linkNode="lightNode01" groupIndex="1"/>

        <realLights>
            <low>
                <light node="realLightsLow" groupIndex="1"/>
            </low>
            <high>
                <light node="realLightsHigh" groupIndex="1"/>
            </high>
        </realLights>

        <group name="$l10n_action_placeableLightShed" triggerNode="lightTrigger01">
            <sounds>
                <toggle template="lizardFloodLight" innerRadius="3" outerRadius="15" volumeScale="0.2"/>
            </sounds>
        </group>
    </lights>

<extendedProductionPoint>
       

  <productions sharedThroughputCapacity="false">
            <production id="PIG" name="$l10n_Pig_Processing" cyclesPerHour="0.8" costsPerActiveHour="2.0" >
                <inputs>
                    <input fillType="PIGS" amount="0.2">
					</input>
                </inputs>

                <outputs>
                    <output fillType="JAMBON" amount="500">
                    </output>
                </outputs>
            </production>
			
			<production id="COW" name="$l10n_Cow_Processing" cyclesPerHour="0.5" costsPerActiveHour="2.0" >
                <inputs>
                    <input fillType="BEEF" amount="0.2">
					</input>
                </inputs>

                <outputs>
                    <output fillType="MEAT" amount="1000">
                    </output>
                </outputs>
            </production>
			
			<production id="CHICKEN" name="$l10n_Chicken_Processing" cyclesPerHour="2" costsPerActiveHour="2.0" >
                <inputs>
                    <input fillType="POULTRY" amount="0.5">
					</input>	
                </inputs>

                <outputs>
                    <output fillType="POULTRYMEAT" amount="300">
                    </output>
                </outputs>
            </production>
			
			<production id="SHEEPGOAT" name="$l10n_Sheep/Goat_Processing" cyclesPerHour="0.5" costsPerActiveHour="2.0" >
                <inputs>
                    <input fillType="SHEEPGOAT" amount="0.3">
					</input>
                </inputs>

                <outputs>
                    <output fillType="SHEEPGOATMEAT" amount="600">
                    </output>
                </outputs>
            </production>
			
			<production id="HORSE" name="$l10n_Horse_Processing" cyclesPerHour="2" costsPerActiveHour="2.0" >
                <inputs>
                    <input fillType="HORSE" amount="0.2">
					</input>	
                </inputs>

                <outputs>
                    <output fillType="HORSEMEAT" amount="600">
                    </output>
                </outputs>
            </production>
        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="5">
            <capacity fillType="PIGS" capacity="100" />
            <capacity fillType="BEEF" capacity="100" />
            <capacity fillType="POULTRY" capacity="500" />
            <capacity fillType="SHEEPGOAT" capacity="100" />
			<capacity fillType="HORSE" capacity="100" />

            <capacity fillType="JAMBON" capacity="15000" />
            <capacity fillType="MEAT" capacity="15000" />
            <capacity fillType="POULTRYMEAT" capacity="15000" />
            <capacity fillType="SHEEPGOATMEAT" capacity="15000" />
			<capacity fillType="HORSEMEAT" capacity="15000" />
        </storage>

        <animalInput triggerNode="animalTrigger" unloadSuccessText="message_unloadAnimalSuccess" unloadConfirmationText="message_unloadAnimalConfirmation" moveButtonText="button_moveAnimal" animalMinimumAgeText="message_animalTooYoung" animalMaximumAgeText="message_animalTooOld">
            <animal type="PIG" 		fillType="PIGS" minimumAge="6" maximumAge="60"/>
            <animal type="COW" 		fillType="BEEF" minimumAge="12" maximumAge="60"/>
            <animal type="CHICKEN" 	fillType="POULTRY" minimumAge="6" maximumAge="60"/>
            <animal type="SHEEP" 	fillType="SHEEPGOAT" minimumAge="14" maximumAge="60"/>
			<animal type="HORSE" 	fillType="HORSE" minimumAge="6" maximumAge="60"/>
        </animalInput>

        <sellingStation node="sellingStation" stationName="Butcher Shop" appearsOnStats="false" allowMissions="false" supportsExtension="true" hideFromPricesMenu="true">
            <unloadTrigger exactFillRootNode="unloadTrigger" fillTypes="PIGS BEEF POULTRY SHEEPGOAT HORSE"/>
			<!-- <palletTrigger triggerNode="palletTrigger" fillTypes="WOODCHIPS" />
            <baleTrigger triggerNode="baleTrigger" deleteLitersPerSecond="10000" fillTypes="WOODCHIPS" /> -->
        </sellingStation>
  <palletSpawner>
            <spawnPlaces>
                <spawnPlace startNode="palletAreaStart01" endNode="palletAreaEnd01"/>
            </spawnPlaces>
        </palletSpawner>

        <playerTrigger node="playerTrigger" />

<sounds>
            <idle   template="placeableSmallIdleGeneric" linkNode="0>"/>
            <active template="raisinIdle" linkNode="0>" pitchScale="1.2" innerRadius="2" outerRadius="15" volumeScale="0.9"/>
        </sounds>

   </extendedProductionPoint>


<animatedObjects>
<animatedObject saveId="door" >
            <animation duration="3">
                <part node="door">
                    <keyFrame time="0.1" rotation="0 0 0"/>
                    <keyFrame time="1.0" rotation="0 -100 0"/>
                </part>
                
            </animation>
            <controls triggerNode="door1Trigger" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor" />
            <sounds>
                <moving linkNode="door" template="glassDoorLoop" />
                <negEnd linkNode="door" template="metalDoorsClose" />
            </sounds>
        </animatedObject>
        </animatedObjects>


<solarPanels>
        <solarPanelsConfigurations title="$l10n_storeItem_title_Walls">
            <solarPanelsConfiguration name="$l10n_storeItem_rustic_walls" isActive="false">
                <objectChange node="building2" visibilityActive="false"/>
            </solarPanelsConfiguration>
            <solarPanelsConfiguration name="$l10n_storeItem_plastered_walls" isActive="true">
                <objectChange node="building" visibilityActive="false"/>
            </solarPanelsConfiguration>

           
            
            
        </solarPanelsConfigurations>
    </solarPanels>




    <i3dMappings>
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="levelAreaStart01" node="0>1|0" />
        <i3dMapping id="levelAreaWidth01" node="0>1|0|0" />
        <i3dMapping id="levelAreaHeight01" node="0>1|0|1" />
        <i3dMapping id="paintAreaStart01" node="0>2|0" />
        <i3dMapping id="paintAreaWidth01" node="0>2|0|0" />
        <i3dMapping id="paintAreaHeight01" node="0>2|0|1" />
        <i3dMapping id="indoorAreaStart01" node="0>3|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>3|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>3|0|1" />
        <i3dMapping id="testAreaStart01" node="0>4|0" />
        <i3dMapping id="testAreaEnd01" node="0>4|0|0" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>5|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>5|0|0" />
        <i3dMapping id="realLightsLow" node="0>6|0|0" />
        <i3dMapping id="realLightsHigh" node="0>6|0|1" />
        <i3dMapping id="lightNode01" node="0>6|1|0" />
        <i3dMapping id="lightSwitch01" node="0>6|2" />
        <i3dMapping id="lightTrigger01" node="0>6|3" />
        <i3dMapping id="infoTrigger" node="0>7" />
        <i3dMapping id="sellingStation" node="0>8" />
        <i3dMapping id="unloadTrigger" node="0>8|0" />
        <i3dMapping id="palletTrigger" node="0>8|1" />
        <i3dMapping id="unloadTriggerMarker" node="0>8|2" />
        <i3dMapping id="unloadTriggerAINode" node="0>8|3" />
        
        <i3dMapping id="playerTrigger" node="0>9|0" />
        <i3dMapping id="playerTriggerMarker" node="0>9|1" />
        <i3dMapping id="warningStripes01" node="0>10|0" />
        <i3dMapping id="warningStripes02" node="0>10|1" />
        <i3dMapping id="palletSpawner" node="0>11" />
        <i3dMapping id="palletAreaStart01" node="0>11|0" />
        <i3dMapping id="palletAreaEnd01" node="0>11|0|0" />
        <i3dMapping id="animalTrigger" node="0>9|2"/>

        <i3dMapping id="door" node="0>12|0|5" />
        <i3dMapping id="door1Trigger" node="0>12|0|6" />
        <i3dMapping id="building2" node="0>12|0|8" />
        <i3dMapping id="building" node="0>12|0|0" />

    </i3dMappings>
</placeable>
