<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_shopItem_pizzaFactory</name>
        <functions>
            <function>$l10n_function_productionPoint</function>
        </functions>
        <image>$data/store/store_empty.png</image>
        <price>50000</price>
        <showInStore>false</showInStore>
        <canBeSold>true</canBeSold>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>factories</tab>
        </brush>
        <vertexBufferMemoryUsage>0</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>0</indexBufferMemoryUsage>
        <textureMemoryUsage>0</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <filename>placeables/productionPoints/PizzaPlaceUS.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
        <canBeDeleted>false</canBeDeleted>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
    </placement>

    <clearAreas>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30" >
    </leveling>

    <indoorAreas>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger"/>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker" teleportNode="playerTriggerMarker" />
    </hotspots>

    <dynamicallyLoadedParts>
    </dynamicallyLoadedParts>

    <triggerMarkers>
        <triggerMarker node="warningStripes01"/>
        <triggerMarker node="warningStripes02"/>
        <triggerMarker node="playerTriggerMarker" filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
        <triggerMarker node="unloadTriggerMarker" filename="$data/shared/assets/marker/markerIconUnload.i3d" adjustToGround="true"/>
    </triggerMarkers>

    <productionPoint>
        <productions sharedThroughputCapacity="false">
			
<production id="pizza1" name="Pizza QuatroFromagi" cyclesPerHour="20" costsPerActiveHour="5">
                <inputs>
                    <input fillType="FLOUR"  amount="8" />
                    <input fillType="CHEESE" amount="6" />
                    <input fillType="TOMATO" amount="7" />
                    <input fillType="CHILLI" amount="3" /> 
                </inputs>
                <outputs>
                    <output fillType="PIZZA" amount="22" /> 
                </outputs>
            </production>
            
	<production id="pizza2" name="Pizza Fungi" cyclesPerHour="20" costsPerActiveHour="5">
                <inputs>
                    <input fillType="FLOUR"  amount="8" />
                    <input fillType="CHEESE" amount="4" />
                    <input fillType="TOMATO" amount="5" />
                    <input fillType="CHILLI" amount="2" />
                    <input fillType="GARLIC" amount="2" />
                    <input fillType="ENOKI"  amount="4" />
                </inputs>
                <outputs>
                    <output fillType="PIZZA" amount="23" />
                </outputs>
            </production>

	<production id="pizza3" name="Pizza con Carne" cyclesPerHour="20" costsPerActiveHour="5">
                <inputs>
                    <input fillType="FLOUR"  amount="8" />
                    <input fillType="CHEESE" amount="4" />
                    <input fillType="TOMATO" amount="6" />
                    <input fillType="CHILLI" amount="2" />
                    <input fillType="BEEF" amount="5" /> 
                </inputs>
                <outputs>
                    <output fillType="PIZZA" amount="25" /> 
                </outputs>
            </production>
 
	<production id="pizza4" name="Pizza Vegetariana" cyclesPerHour="17" costsPerActiveHour="5">
                <inputs>
                    <input fillType="FLOUR"  		amount="8" />
                    <input fillType="TOMATO" 		amount="8" />
                    <input fillType="CHILLI" 		amount="3" />
                    <input fillType="GARLIC" 		amount="2" />
                    <input fillType="ENOKI"  		amount="4" />
                    <input fillType="EGGPLANT"  	amount="4" />
                </inputs>
                <outputs>
                    <output fillType="PIZZA" amount="20" /> 
                </outputs>
            </production>

        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <capacity fillType="FLOUR"        		capacity="210000" />
            <capacity fillType="CHEESE"        		capacity="50000" />
            <capacity fillType="TOMATO"    		capacity="50000" />
            <capacity fillType="CHILLI"        		capacity="15000" />
            <capacity fillType="GARLIC" 		capacity="15000" />
            <capacity fillType="ENOKI"          	capacity="15000" />
            <capacity fillType="EGGPLANT"          	capacity="15000" />
            <capacity fillType="BEEF"          		capacity="15000" />
            <capacity fillType="PIZZA"       		capacity="25000" />
        </storage>

        <sellingStation node="sellingStation" appearsOnStats="true" supportsExtension="false">
            <unloadTrigger exactFillRootNode="exactFillRootNode" aiNode="unloadTriggerAINode" fillTypes="FLOUR" />
            <palletTrigger triggerNode="palletTrigger" aiNode="unloadTriggerAINode" fillTypes="TOMATO PEPPER CHILLI GARLIC BEEF EGGPLANT ENOKI CHEESE BUFFALOMOZZARELLA GOATCHEESE FLOUR BUCKWHEATFLOUR GRAMFLOUR RYEFLOUR CORNFLOUR MILLETFLOUR SORGHUMFLOUR RICEFLOUR PEANUTFLOUR" >
		<fillTypeConversion ratio="1.2" incomingFillType="RICEFLOUR" 		outgoingFillType="FLOUR" />
		<fillTypeConversion ratio="0.9" incomingFillType="RYEFLOUR" 		outgoingFillType="FLOUR" />
		<fillTypeConversion ratio="1.3" incomingFillType="GRAMFLOUR" 		outgoingFillType="FLOUR" />
		<fillTypeConversion ratio="1.1" incomingFillType="SORGHUMFLOUR" 	outgoingFillType="FLOUR" />
		<fillTypeConversion ratio="1.1" incomingFillType="MILLETFLOUR" 		outgoingFillType="FLOUR" />
		<fillTypeConversion ratio="0.7" incomingFillType="BUCKWHEATFLOUR" 	outgoingFillType="FLOUR" />
		<fillTypeConversion ratio="0.8" incomingFillType="CORNFLOUR" 		outgoingFillType="FLOUR" />
		<fillTypeConversion ratio="1.3" incomingFillType="PEANUTFLOUR" 		outgoingFillType="FLOUR" />
		<fillTypeConversion ratio="1.3" incomingFillType="GOATCHEESE" 		outgoingFillType="CHEESE" />
		<fillTypeConversion ratio="1.5" incomingFillType="BUFFALOMOZZARELLA" 	outgoingFillType="CHEESE" />
		<fillTypeConversion ratio="0.8" incomingFillType="PORK" 		outgoingFillType="BEEF" />
		<fillTypeConversion ratio="0.6" incomingFillType="POULTRYMEAT" 		outgoingFillType="BEEF" />
		<fillTypeConversion ratio="0.9" incomingFillType="LAMB" 		outgoingFillType="BEEF" />
		<fillTypeConversion ratio="0.9" incomingFillType="OYSTER" 		outgoingFillType="ENOKI" />
		<fillTypeConversion ratio="0.8" incomingFillType="PEPPER" 		outgoingFillType="CHILLI" />
		<fillTypeConversion ratio="1"   incomingFillType="SESAME" 		outgoingFillType="POPPY" />
	</palletTrigger>
        </sellingStation>

        <palletSpawner>
            <spawnPlaces>
                <spawnPlace startNode="palletAreaStart01" endNode="palletAreaEnd01"/>
                <spawnPlace startNode="palletAreaStart02" endNode="palletAreaEnd02"/>
            </spawnPlaces>
        </palletSpawner>

        <playerTrigger node="playerTrigger" />
        <sounds>
            <idle   template="bakeryIdle" linkNode="0>" outerRadius="50"/>
            <active template="bakeryWork" linkNode="0>" outerRadius="50"/>
        </sounds>
    </productionPoint>

    <i3dMappings>
        <i3dMapping id="bakeryUS" node="0>" />
        <i3dMapping id="infoTrigger" node="0>7" />
        <i3dMapping id="sellingStation" node="0>8" />
        <i3dMapping id="exactFillRootNode" node="0>8|0" />
        <i3dMapping id="palletTrigger" node="0>8|1" />
        <i3dMapping id="unloadTriggerMarker" node="0>8|2" />
        <i3dMapping id="unloadTriggerAINode" node="0>8|3" />
        <i3dMapping id="warningStripes01" node="0>8|4" />
        <i3dMapping id="playerTrigger" node="0>9|0" />
        <i3dMapping id="playerTriggerMarker" node="0>9|1" />
        <i3dMapping id="palletSpawner" node="0>10" />
        <i3dMapping id="palletAreaStart01" node="0>10|0" />
        <i3dMapping id="palletAreaEnd01" node="0>10|0|0" />
        <i3dMapping id="palletAreaStart02" node="0>10|1" />
        <i3dMapping id="palletAreaEnd02" node="0>10|1|0" />
        <i3dMapping id="warningStripes02" node="0>10|2" />
    </i3dMappings>
</placeable>
