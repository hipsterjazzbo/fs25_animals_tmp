<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_shopItem_spinnery</name>
        <functions>
            <function>$l10n_function_productionPoint</function>
        </functions>
        <image>$data/placeables/brandless/productionPointsGeneric/spinnery/store_spinnery.png</image>
        <price>180000</price>
        <showInStore>false</showInStore>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>factories</tab>
        </brush>
        <vertexBufferMemoryUsage>336896</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>95232</indexBufferMemoryUsage>
        <textureMemoryUsage>2949120</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <filename>placeables/productionPoints/spinnery.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
        </testAreas>
        <sounds>
            <place template="smallImp" />
        </sounds>
    </placement>

    <clearAreas>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30" >
        <levelAreas>
        </levelAreas>
        <paintAreas>
        </paintAreas>
    </leveling>

    <indoorAreas>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger" />

    <triggerMarkers>
        <triggerMarker node="warningStripes01"/>
        <triggerMarker node="warningStripes02"/>
        <triggerMarker node="playerTriggerMarker" filename="$data/shared/assets/marker/markerIconWrench.i3d" adjustToGround="true"/>
        <triggerMarker node="unloadTriggerMarker" filename="$data/shared/assets/marker/markerIconUnload.i3d" adjustToGround="true"/>
    </triggerMarkers>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker" teleportNode="playerTrigger" />
    </hotspots>

    <dynamicallyLoadedParts>
        <dynamicallyLoadedPart filename="$data/effects/chimneySmoke/smokeTrailSubUV.i3d" node="1" linkNode="smokeBig1" shaderParameterName="colorAlpha" shaderParameter="1 1 1 1"/>
        <dynamicallyLoadedPart filename="$data/effects/chimneySmoke/smokeTrailSubUV.i3d" node="1" linkNode="smokeBig2" shaderParameterName="colorAlpha" shaderParameter="1 1 1 1"/>
    </dynamicallyLoadedParts>

    <productionPoint>
        <productions>
            <production id="fabric_wool" name="%s (%s)" params="$l10n_fillType_fabric|$l10n_fillType_wool" cyclesPerHour="60" costsPerActiveHour="5">
                <inputs>
                    <input fillType="WOOL" amount="6" />
                </inputs>
                <outputs>
                    <output fillType="FABRIC" amount="2" />
                </outputs>
            </production>
            <production id="fabric_cotton" name="%s (%s)" params="$l10n_fillType_fabric|$l10n_fillType_cotton" cyclesPerHour="100" costsPerActiveHour="5">
                <inputs>
                    <input fillType="COTTON" amount="12" />
                </inputs>
                <outputs>
                    <output fillType="FABRIC" amount="4" />
                </outputs>
            </production>
            <production id="fabric_hempFiber" name="%s (%s)" params="$l10n_fillType_fabric|$l10n_fillType_hempFiber" cyclesPerHour="100" costsPerActiveHour="5">
                <inputs>
                    <input fillType="HEMP_FIBER" amount="12" />
                </inputs>
                <outputs>
                    <output fillType="FABRIC" amount="4" />
                </outputs>
            </production>
            <production id="fabric_flaxFiber" name="%s (%s)" params="$l10n_fillType_fabric|$l10n_fillType_flaxFiber" cyclesPerHour="100" costsPerActiveHour="5">
                <inputs>
                    <input fillType="FLAX_FIBER" amount="12" />
                </inputs>
                <outputs>
                    <output fillType="FABRIC" amount="4" />
                </outputs>
            </production>
	   <production id="rope1" name="%s (%s)" params="$l10n_fillType_rope|$l10n_fillType_wool" cyclesPerHour="410" costsPerActiveHour="1.25">
                <inputs>
                    <input fillType="WOOL" amount="20" />
                </inputs>
                <outputs>
                    <output fillType="ROPE" amount="4" />
                </outputs>
            </production>

            <production id="rope2" name="%s (%s)" params="$l10n_fillType_rope|$l10n_fillType_cotton" cyclesPerHour="8" costsPerActiveHour="1">
                <inputs>
                    <input fillType="COTTON" amount="150" />
                </inputs>
                <outputs>
                    <output fillType="ROPE" amount="40" />
                </outputs>
            </production>
	    <production id="rope3" name="%s (%s)" params="$l10n_fillType_rope|$l10n_fillType_flaxFiber" cyclesPerHour="8" costsPerActiveHour="1">
                <inputs>
                    <input fillType="FLAX_FIBER" amount="140" />
                </inputs>
                <outputs>
                    <output fillType="ROPE" amount="45" />
                </outputs>
            </production>

            <production id="rope4" name="%s (%s)" params="$l10n_fillType_rope|$l10n_fillType_hempFiber" cyclesPerHour="8" costsPerActiveHour="1">
                <inputs>
                    <input fillType="HEMP_FIBER" amount="140" />
                </inputs>
                <outputs>
                    <output fillType="ROPE" amount="40" />
                </outputs>
            </production>
	</productions>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <capacity fillType="WOOL"   		capacity="95000" />
            <capacity fillType="COTTON" 		capacity="900000" />
            <capacity fillType="HEMP_FIBER" 		capacity="900000" />
            <capacity fillType="FLAX_FIBER" 		capacity="900000" />
            <capacity fillType="FABRIC" 		capacity="90000" />
            <capacity fillType="ROPE" 			capacity="90000" />
        </storage>

        <sellingStation node="sellingStation" supportsExtension="false" appearsOnStats="true">
            <palletTrigger triggerNode="palletTrigger" aiNode="unloadTriggerAINode" fillTypes="WOOL COTTON" />
            <baleTrigger aiNode="unloadTriggerAINode" fillTypes="WOOL COTTON HEMP_FIBER FLAX_FIBER" triggerNode="baleTrigger" deleteLitersPerSecond="4000" />
        </sellingStation>

        <palletSpawner>
            <spawnPlaces>
                <spawnPlace startNode="palletAreaStart01" endNode="palletAreaEnd01"/>
                <spawnPlace startNode="palletAreaStart02" endNode="palletAreaEnd02"/>
            </spawnPlaces>
        </palletSpawner>

        <playerTrigger node="playerTrigger" />
        <sounds>
            <idle   template="spinneryIdle" linkNode="0>" pitchScale="1.0"/>
            <active template="spinneryWork" linkNode="0>" pitchScale="1.0"/>
        </sounds>
    </productionPoint>

    <i3dMappings>
        <i3dMapping id="spinnery" node="0>" />
        <i3dMapping id="infoTrigger" node="0>6" />
        <i3dMapping id="sellingStation" node="0>7" />
        <i3dMapping id="palletTrigger" node="0>7|0" />
        <i3dMapping id="baleTrigger" node="0>7|1" />
        <i3dMapping id="unloadTriggerMarker" node="0>7|2" />
        <i3dMapping id="unloadTriggerAINode" node="0>7|3" />
        <i3dMapping id="warningStripes01" node="0>8|0" />
        <i3dMapping id="warningStripes02" node="0>8|1" />
        <i3dMapping id="playerTrigger" node="0>9|0" />
        <i3dMapping id="playerTriggerMarker" node="0>9|1" />
        <i3dMapping id="palletSpawner" node="0>10" />
        <i3dMapping id="palletAreaStart01" node="0>10|0" />
        <i3dMapping id="palletAreaEnd01" node="0>10|0|0" />
        <i3dMapping id="palletAreaStart02" node="0>10|1" />
        <i3dMapping id="palletAreaEnd02" node="0>10|1|0" />
        <i3dMapping id="smokeBig1" node="0>11|0" />
        <i3dMapping id="smokeBig2" node="0>11|1" />
    </i3dMappings>
</placeable>
