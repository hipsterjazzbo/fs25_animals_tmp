<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_shopItem_oilFactory</name>
        <functions>
            <function>$l10n_function_productionPoint</function>
        </functions>
        <image>$data/store/store_empty.png</image>
        <price>240000</price>
        <showInStore>false</showInStore>
        <canBeSold>true</canBeSold>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>JINKOU</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>factories</tab>
        </brush>
        <vertexBufferMemoryUsage>0</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>0</indexBufferMemoryUsage>
        <textureMemoryUsage>0</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <filename>$data/placeables/mapUS/oilPlantUS/oilPlantUS.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
        <canBeDeleted>false</canBeDeleted>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" />

    <clearAreas></clearAreas>

    <leveling></leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01"/>
        <indoorArea startNode="indoorAreaStart02" widthNode="indoorAreaWidth02" heightNode="indoorAreaHeight02"/>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
            <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
        <splines>
            <spline node="unloadTriggerAISpline"/>
        </splines>
    </ai>

    <infoTrigger triggerNode="infoTrigger" />

    <triggerMarkers>
        <triggerMarker node="warningStripes01"/>
        <triggerMarker node="unloadTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconUnload.i3d"/>
        <triggerMarker node="playerTriggerMarker"                       filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
    </triggerMarkers>

    <dynamicallyLoadedParts>
        <dynamicallyLoadedPart filename="$data/placeables/shared/sellingStationGeneric/sellingStationGenericNoCover.i3d" linkNode="unloadTriggerLinkNode" />
        <dynamicallyLoadedPart filename="$data/placeables/mapUS/oilPlantUS/oilPlantUSProps.i3d" node="0" linkNode="props" />
    </dynamicallyLoadedParts>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker" teleportNode="playerTriggerMarker" />
    </hotspots>

    <lights>
        <group weatherRequiredFlags="NIGHT" />

        <lightShape node="interior"               groupIndex="1"/>
        <lightShape node="interior_smallBuilding" groupIndex="1"/>

        <realLights>
            <low>
                <light node="realLightsLow" groupIndex="1"/>
            </low>
            <high>
                <light node="realLightsHigh" groupIndex="1"/>
            </high>
        </realLights>
    </lights>

<productionPoint>
        <productions>
            
<production id="sunflower_oil" name="$l10n_fillType_sunflowerOil" cyclesPerHour="40" costsPerActiveHour="2.5">
                <inputs>
                    <input fillType="SUNFLOWER" amount="20" />
                </inputs>
                <outputs>
                    <output fillType="SUNFLOWER_OIL" amount="10" />
                    <output fillType="ORGANICWASTE" amount="2" />
                </outputs>
            </production>

<production id="mustard_oil" name="$l10n_fillType_mustardOil" cyclesPerHour="40" costsPerActiveHour="2.5">
                <inputs>
                    <input fillType="MUSTARD" amount="25" />
                </inputs>
                <outputs>
                    <output fillType="MUSTARD_OIL" amount="8" />
                    <output fillType="ORGANICWASTE" amount="2" />
                </outputs>
            </production>
            
<production id="canola_oil" name="$l10n_fillType_canolaOil" cyclesPerHour="40" costsPerActiveHour="2.5">
                <inputs>
                    <input fillType="CANOLA" amount="20" />
                </inputs>
                <outputs>
                    <output fillType="CANOLA_OIL" amount="10" />
                    <output fillType="ORGANICWASTE" amount="2" />
                </outputs>
            </production>
            
<production id="safflower_oil" name="$l10n_fillType_safflowerOil" cyclesPerHour="40" costsPerActiveHour="2.5">
                <inputs>
                    <input fillType="SAFFLOWER" amount="20" />
                </inputs>
                <outputs>
                    <output fillType="SAFFLOWER_OIL" amount="9" />
                    <output fillType="ORGANICWASTE" amount="5" />
                </outputs>
            </production>

<production id="linseed_oil" name="$l10n_fillType_linseedOil" cyclesPerHour="40" costsPerActiveHour="2.5">
                <inputs>
                    <input fillType="LINSEED" amount="20" />
                </inputs>
                <outputs>
                    <output fillType="LINSEED_OIL" amount="12" />
                    <output fillType="ORGANICWASTE" amount="2" />
                </outputs>
            </production>

<production id="poppy_oil" name="$l10n_fillType_poppyOil" cyclesPerHour="40" costsPerActiveHour="2.5">
                <inputs>
                    <input fillType="POPPY" amount="40" />
                </inputs>
                <outputs>
                    <output fillType="POPPY_OIL" amount="14" />
                    <output fillType="ORGANICWASTE" amount="4" />
                </outputs>
            </production>
            
<production id="sesame_oil" name="$l10n_fillType_sesameOil" cyclesPerHour="40" costsPerActiveHour="2.5">
                <inputs>
                    <input fillType="SESAME" amount="40" />
                </inputs>
                <outputs>
                    <output fillType="SESAME_OIL" amount="15" />
                    <output fillType="ORGANICWASTE" amount="4" />
                </outputs>
            </production>

<production id="peanut_oil" name="$l10n_fillType_peanutOil" cyclesPerHour="40" costsPerActiveHour="2.5">
                <inputs>
                    <input fillType="PEANUT" amount="60" />
                </inputs>
                <outputs>
                    <output fillType="PEANUT_OIL" amount="12" />
                    <output fillType="ORGANICWASTE" amount="4" />
                </outputs>
            </production>
			
<production id="corn_oil" name="$l10n_fillType_cornOil" cyclesPerHour="40" costsPerActiveHour="2.5">
                <inputs>
                    <input fillType="MAIZE" amount="20" />
                </inputs>
                <outputs>
                    <output fillType="CORN_OIL" amount="5" />
                    <output fillType="ORGANICWASTE" amount="5" />
                </outputs>
            </production>
            
<production id="olive_oil" name="$l10n_fillType_oliveOil" cyclesPerHour="20" costsPerActiveHour="2.5">
                <inputs>
                    <input fillType="OLIVE" amount="25" />
                </inputs>
                <outputs>
                    <output fillType="OLIVE_OIL" amount="10" />
                    <output fillType="ORGANICWASTE" amount="2" />
                </outputs>
            </production>
            
<production id="rice_oil_longGrainRice" name="%s (%s)" params="$l10n_fillType_riceOil|$l10n_fillType_riceLongGrain" cyclesPerHour="40" costsPerActiveHour="2.5">
                <inputs>
                    <input fillType="RICELONGGRAIN" amount="25" />
                </inputs>
                <outputs>
                    <output fillType="RICE_OIL" amount="10" />
                    <output fillType="ORGANICWASTE" amount="2" />
                </outputs>
            </production>
            
<production id="rice_oil_rice" name="%s (%s)" params="$l10n_fillType_riceOil|$l10n_fillType_rice" cyclesPerHour="40" costsPerActiveHour="2.5">
                <inputs>
                    <input fillType="RICE" amount="12" />
                </inputs>
                <outputs>
                    <output fillType="RICE_OIL" amount="10" />
                    <output fillType="ORGANICWASTE" amount="2" />
                </outputs>
            </production>
        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <capacity fillType="SUNFLOWER"     		capacity="960000" />
            <capacity fillType="CANOLA"        		capacity="960000" />
            <capacity fillType="SAFFLOWER"     		capacity="960000" />
            <capacity fillType="MAIZE"        		capacity="1200000" />
            <capacity fillType="MUSTARD"        	capacity="1200000" />
            <capacity fillType="LINSEED"        	capacity="1200000" />
            <capacity fillType="POPPY"        		capacity="1200000" />
            <capacity fillType="SESAME"        		capacity="960000" />
            <capacity fillType="PEANUT"        		capacity="1200000" />
            <capacity fillType="OLIVE"         		capacity="600000" />
            <capacity fillType="RICELONGGRAIN" 		capacity="1200000" />
            <capacity fillType="RICE"          		capacity="580000" />
            <capacity fillType="SUNFLOWER_OIL" 		capacity="90000" />
            <capacity fillType="CANOLA_OIL"    		capacity="90000" />
            <capacity fillType="CORN_OIL"    		capacity="90000" />
            <capacity fillType="LINSEED_OIL"    	capacity="90000" />
            <capacity fillType="MUSTARD_OIL"    	capacity="90000" />
            <capacity fillType="POPPY_OIL"    		capacity="90000" />
            <capacity fillType="OLIVE_OIL"     		capacity="55000" />
            <capacity fillType="RICE_OIL"      		capacity="90000" />
            <capacity fillType="PEANUT_OIL"      	capacity="90000" />
            <capacity fillType="SESAME_OIL"    		capacity="90000" />
            <capacity fillType="SAFFLOWER_OIL" 		capacity="90000" />
            <capacity fillType="ORGANICWASTE"         	capacity="600000" />
        </storage>

        <sellingStation node="sellingStation" supportsExtension="false">
            <unloadTrigger exactFillRootNode="unloadTrigger" aiNode="unloadTriggerAINode" fillTypes="SAFFLOWER SUNFLOWER SESAME CANOLA MAIZE LINSEED MUSTARD POPPY OLIVE RICELONGGRAIN RICE PEANUT"/>
        </sellingStation>

        <palletSpawner>
            <spawnPlaces>
                <spawnPlace startNode="palletAreaStart01" endNode="palletAreaEnd01"/>
                <spawnPlace startNode="palletAreaStart02" endNode="palletAreaEnd02"/>
            </spawnPlaces>
        </palletSpawner>

        <playerTrigger node="playerTrigger" />
		
		<sounds>
            <idle template="cerealFactoryIdle" linkNode="0>" />
            <active template="cerealFactoryWork" linkNode="0>" />
        </sounds>
    </productionPoint>

    <i3dMappings>
        <i3dMapping id="indoorAreaStart01" node="0>0|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="indoorAreaStart02" node="0>0|1" />
        <i3dMapping id="indoorAreaWidth02" node="0>0|1|0" />
        <i3dMapping id="indoorAreaHeight02" node="0>0|1|1" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>1|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>1|0|0" />
        <i3dMapping id="realLightsLow" node="0>2|0|0" />
        <i3dMapping id="realLightsHigh" node="0>2|0|1" />
        <i3dMapping id="interior" node="0>2|1|0" />
        <i3dMapping id="interior_smallBuilding" node="0>2|1|1" />
        <i3dMapping id="infoTrigger" node="0>3" />
        <i3dMapping id="sellingStation" node="0>4" />
        <i3dMapping id="unloadTrigger" node="0>4|0" />
        <i3dMapping id="unloadTriggerMarker" node="0>4|1" />
        <i3dMapping id="unloadTriggerAINode" node="0>4|2" />
        <i3dMapping id="unloadTriggerLinkNode" node="0>4|3" />
        <i3dMapping id="unloadTriggerAISpline" node="0>4|4" />
        <i3dMapping id="playerTrigger" node="0>5|0" />
        <i3dMapping id="playerTriggerMarker" node="0>5|1" />
        <i3dMapping id="warningStripes01" node="0>6|0" />
        <i3dMapping id="palletSpawner" node="0>7" />
        <i3dMapping id="palletAreaStart01" node="0>7|0" />
        <i3dMapping id="palletAreaEnd01" node="0>7|0|0" />
        <i3dMapping id="palletAreaStart02" node="0>7|1" />
        <i3dMapping id="palletAreaEnd02" node="0>7|1|0" />
        <i3dMapping id="props" node="0>8|0" />
    </i3dMappings>
</placeable>
