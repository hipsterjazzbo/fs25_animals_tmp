        <showInStore>true</showInStore>
        <lifetime>1000</lifetime>
        <dailyUpkeep>85</dailyUpkeep>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>farmhouses</category>
        <brush>
            <type>placeable</type>
            <category>buildings</category>
            <tab>constructibles</tab>
        </brush>
        <vertexBufferMemoryUsage>3512064</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>891904</indexBufferMemoryUsage>
        <textureMemoryUsage>1572864</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>

        <storeIconRendering>
            <objectBundle>
                <object filename="$data/placeables/brandless/constructibles/buildableFarmHouse01/buildableFarmHouse01.i3d">
                    <node node="0|10|0|0"/>
                </object>
            </objectBundle>
        </storeIconRendering>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <filename>placeables/buildableFarmHouse01.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
		<boughtWithFarmland>true</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true">
