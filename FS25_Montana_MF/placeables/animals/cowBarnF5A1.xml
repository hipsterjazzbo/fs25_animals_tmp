<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="cowHusbandryBarnMilk" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>Bison Ridge Cow Stall</name>
        <image>$data/placeables/rudolfHormann/cowBarnMedium/store_cowBarnMedium.png</image>
        <price>254000</price>
		<canBeSold>false</canBeSold>
        <showInStore>false</showInStore>
        <functions>
            <function>$l10n_function_animalPenCow</function>
        </functions>
        <lifetime>1000</lifetime>
        <dailyUpkeep>150</dailyUpkeep>
        <rotation>0</rotation>
        <brand>RUDOLFHOERMANN</brand>
        <species>PLACEABLE</species>
        <category>animalpens</category>
        <brush>
            <type>husbandry</type>
            <category>animals</category>
            <tab>cows</tab>
        </brush>
        <vertexBufferMemoryUsage>2459904</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>453888</indexBufferMemoryUsage>
        <textureMemoryUsage>3407872</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <filename>placeables/animals/cowBarnF5A1.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
		<boughtWithFarmland>true</boughtWithFarmland>
    </base>

    <placement>
    </placement>

    <clearAreas>
    </clearAreas>

    <leveling>
    </leveling>

    <indoorAreas>
    </indoorAreas>
	
	<tipOcclusionUpdateAreas>
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
        </updateAreas>
    </ai>

    <triggerMarkers>
        <triggerMarker node="markerMilk"         filename="$data/shared/assets/marker/markerIconMilk.i3d" />
        <triggerMarker node="markerFood"         filename="$data/shared/assets/marker/markerIconFood.i3d" />
        <triggerMarker node="markerAnimals"      filename="$data/shared/assets/marker/markerIconAnimals.i3d" />
        <triggerMarker node="markerLiquidManure" filename="$data/shared/assets/marker/markerIconSlurry.i3d" />
		<triggerMarker node="markerStraw"        filename="$data/shared/assets/marker/markerIconBales.i3d" />
    </triggerMarkers>

    <hotspots>
        <hotspot type="COW" teleportNode="teleportNode" />
    </hotspots>

    <dynamicallyLoadedParts>
    </dynamicallyLoadedParts>

    <lights>  
		<group weatherRequiredFlags="NIGHT" />
        <realLights>
            <low>
                <light node="realLightsLow" groupIndex="1"/>
            </low>
            <high>
                <light node="realLightsHigh" groupIndex="1"/>
            </high>
        </realLights>	
    </lights>

    <infoTrigger triggerNode="infoTrigger" />

    <husbandry saveId="Animals_COW" hasStatistics="false">
        <storage node="storage" fillTypes="LIQUIDMANURE MILK BUFFALOMILK STRAW MANURE BEANSTRAW CORN_STALKS" isExtension="false">
            <capacity fillType="LIQUIDMANURE" capacity="1000000" />
			<fillPlane fillType="LIQUIDMANURE" node="liquidManurePlane" minY="0" maxY="1" />
            <capacity fillType="MILK"         capacity="150000" />
            <capacity fillType="BUFFALOMILK"  capacity="100000" />
            <capacity fillType="STRAW"        capacity="100000" />
            <capacity fillType="MANURE"       capacity="0" />
        </storage>

        <unloadingStation supportsExtension="true" storageRadius="50" hideFromPricesMenu="true">
            <unloadTrigger exactFillRootNode="exactFillRootNodeStraw" fillTypes="STRAW BEANSTRAW CORN_STALKS">
				<fillTypeConversion incomingFillType="CORN_STALKS" outgoingFillType="STRAW" ratio="1"/>	
				<fillTypeConversion incomingFillType="BEANSTRAW" outgoingFillType="STRAW" ratio="1"/>	
			</unloadTrigger>
			<baleTrigger triggerNode="baleTriggerStraw" fillTypes="STRAW BEANSTRAW CORN_STALKS">
				<fillTypeConversion incomingFillType="CORN_STALKS" outgoingFillType="STRAW" ratio="1"/>	
				<fillTypeConversion incomingFillType="BEANSTRAW" outgoingFillType="STRAW" ratio="1"/>	
			</baleTrigger>
			<unloadTrigger fillTypes="MANURE MILK BUFFALOMILK LIQUIDMANURE" />
        </unloadingStation>

        <loadingStation supportsExtension="true" storageRadius="50">
            <loadTrigger triggerNode="liquidManureTrigger" fillTypes="LIQUIDMANURE" fillLitersPerSecond="2000" aiNode="aiLoadingNodeLiquidManure" />
            <loadTrigger triggerNode="milkTrigger" fillTypes="MILK BUFFALOMILK" fillLitersPerSecond="2000" aiNode="aiLoadingNodeMilk"/>
        </loadingStation>

        <animals type="COW" maxNumAnimals="500" maxNumVisualAnimals="50">
            <navigation rootNode="navigationRootNode" filename="placeables/animals/navMeshCowF5A1.i3d"/>
            <loadingTrigger node="loadingTrigger" />
        </animals>

        <food capacity="500000" >
            <foodPlaces>
                <foodPlace node="foodPlace1" />
                <foodPlace node="foodPlace2" />
                <foodPlace node="foodPlace3" />
                <foodPlace node="foodPlace4" />
                <foodPlace node="foodPlace5" />
                <foodPlace node="foodPlace6" />
                <foodPlace node="foodPlace7" />
                <foodPlace node="foodPlace8" />
                <foodPlace node="foodPlace9" />
            </foodPlaces>
            <dynamicFoodPlane node="fillVolumeFood" defaultFillType="forage" maxAllowedHeapAngle="60" maxSubDivEdgeLength="0.5" capacity="10000"/>
            <unloadTrigger exactFillRootNode="exactFillRootNodeFood" />
            <baleTrigger triggerNode="baleTrigger"/>
        </food>

        <liquidManure />

        <water automaticWaterSupply="true">
            <waterPlaces>
                <waterPlace node="waterPlace1" />
            </waterPlaces>
        </water>

        <straw>
            <manure factor="1.5" />
            <strawPlane node="strawPlane" minY="-0.12" maxY="-0.08" changeVisibility="true" />
        </straw>

        <meadow>
            <fruitType name="GRASS" eatableStartGrowthState="greenMiddle" eatableEndGrowthState="harvestReady" eatenGrowthState="greenSmall" />
            <fruitType name="MEADOW" eatableStartGrowthState="greenMiddle" eatableEndGrowthState="harvestReady" eatenGrowthState="greenSmall" />

            <createTask weedState="0">
                <fruit type="MEADOW" growthState="greenSmall" />
                <ground type="NONE" />
                <terrainGroundType name="grass" />
            </createTask>
        </meadow>
    </husbandry>

    <i3dMappings>
        <i3dMapping id="fillVolumeFood" node="0>5|0" />
        <i3dMapping id="exactFillRootNodeFood" node="0>5|1" />
        <i3dMapping id="foodPlace1" node="0>5|2|0" />
        <i3dMapping id="foodPlace2" node="0>5|2|1" />
        <i3dMapping id="foodPlace3" node="0>5|2|2" />
        <i3dMapping id="foodPlace4" node="0>5|2|3" />
        <i3dMapping id="foodPlace5" node="0>5|2|4" />
        <i3dMapping id="foodPlace6" node="0>5|2|5" />
        <i3dMapping id="foodPlace7" node="0>5|2|6" />
        <i3dMapping id="foodPlace8" node="0>5|2|7" />
        <i3dMapping id="foodPlace9" node="0>5|2|8" />
        <i3dMapping id="baleTrigger" node="0>5|3" />
        <i3dMapping id="strawPlane" node="0>7|0" />
        <i3dMapping id="exactFillRootNodeStraw" node="0>7|1" />
        <i3dMapping id="baleTriggerStraw" node="0>7|2" />
        <i3dMapping id="milkTrigger" node="0>8|0" />
        <i3dMapping id="aiLoadingNodeMilk" node="0>8|2" />
        <i3dMapping id="liquidManureTank" node="0>9" />
        <i3dMapping id="liquidManureTrigger" node="0>9|0" />
        <i3dMapping id="liquidManurePlane" node="0>9|2" />
        <i3dMapping id="aiLoadingNodeLiquidManure" node="0>9|1" />
        <i3dMapping id="realLightsLow" node="0>10|1|0" />
        <i3dMapping id="realLightsHigh" node="0>10|1|1" />
		<i3dMapping id="waterPlace1" node="0>11|0" />
        <i3dMapping id="navigationRootNode" node="0>12" />
        <i3dMapping id="markerMilk" node="0>13|0" />
        <i3dMapping id="markerAnimals" node="0>13|1" />
        <i3dMapping id="markerLiquidManure" node="0>13|2" />
        <i3dMapping id="markerFood" node="0>13|3" />
        <i3dMapping id="markerStraw" node="0>13|4" />
        <i3dMapping id="teleportNode" node="0>15" />
        <i3dMapping id="storage" node="0>16" />
        <i3dMapping id="infoTrigger" node="0>17" />
        <i3dMapping id="loadingTrigger" node="0>18" />
    </i3dMappings>
</placeable>
