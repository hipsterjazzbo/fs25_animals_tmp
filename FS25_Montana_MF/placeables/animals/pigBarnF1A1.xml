<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="pigHusbandry" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>BigSky Pig Barn</name>
        <image>$data/placeables/rudolfHormann/pigBarnBig/store_pigBarnBig.png</image>
        <price>164000</price>
		<canBeSold>false</canBeSold>
        <showInStore>false</showInStore>
        <functions>
            <function>$l10n_function_animalPenPig</function>
            <function>$l10n_function_adjustableMeadow</function>
        </functions>
        <lifetime>1000</lifetime>
        <dailyUpkeep>150</dailyUpkeep>
        <rotation>0</rotation>
        <brand>RUDOLFHOERMANN</brand>
        <species>PLACEABLE</species>
        <category>animalpens</category>
        <brush>
            <type>husbandry</type>
            <category>animals</category>
            <tab>pigs</tab>
        </brush>
        <vertexBufferMemoryUsage>1704704</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>326656</indexBufferMemoryUsage>
        <textureMemoryUsage>3538944</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <filename>placeables/animals/pigBarnF1A1.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
		<boughtWithFarmland>true</boughtWithFarmland>
    </base>

    <placement>
    </placement>

    <clearAreas>
    </clearAreas>

    <leveling>
    </leveling>

    <indoorAreas>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
        </updateAreas>
    </ai>

    <triggerMarkers>
        <triggerMarker node="markerFood"         filename="$data/shared/assets/marker/markerIconFood.i3d" />
        <triggerMarker node="markerAnimals"      filename="$data/shared/assets/marker/markerIconAnimals.i3d" />
        <triggerMarker node="markerLiquidManure" filename="$data/shared/assets/marker/markerIconSlurry.i3d" />
		<triggerMarker node="markerStraw"        filename="$data/shared/assets/marker/markerIconBales.i3d" />
    </triggerMarkers>

    <hotspots>
        <hotspot type="PIG" teleportNode="teleportNode" />
    </hotspots>

    <dynamicallyLoadedParts>
    </dynamicallyLoadedParts>

    <lights>
        <group weatherRequiredFlags="NIGHT" />
        <realLights>
            <low>
                <light node="realLightsLow" groupIndex="1"/>
            </low>
            <high>
                <light node="realLightsHigh" groupIndex="1"/>
            </high>
        </realLights>
    </lights>

    <infoTrigger triggerNode="infoTrigger" />

    <husbandry saveId="Animals_PIG" hasStatistics="false">
        <storage node="storage" fillTypes="LIQUIDMANURE STRAW MANURE BEANSTRAW CORN_STALKS" isExtension="false">
            <capacity fillType="LIQUIDMANURE" capacity="1000000" />
            <capacity fillType="STRAW"        capacity="50000" />
            <capacity fillType="MANURE"       capacity="0" />
        </storage>

        <unloadingStation supportsExtension="true" storageRadius="50" hideFromPricesMenu="true">
			<unloadTrigger exactFillRootNode="exactFillRootNodeStraw" fillTypes="STRAW BEANSTRAW CORN_STALKS">
				<fillTypeConversion incomingFillType="CORN_STALKS" outgoingFillType="STRAW" ratio="1"/>	
				<fillTypeConversion incomingFillType="BEANSTRAW" outgoingFillType="STRAW" ratio="1"/>	
			</unloadTrigger>
            <baleTrigger triggerNode="baleTriggerStraw" fillTypes="STRAW BEANSTRAW CORN_STALKS">
				<fillTypeConversion incomingFillType="CORN_STALKS" outgoingFillType="STRAW" ratio="1"/>	
				<fillTypeConversion incomingFillType="BEANSTRAW" outgoingFillType="STRAW" ratio="1"/>	
			</baleTrigger>
			<unloadTrigger fillTypes="MANURE LIQUIDMANURE" />
        </unloadingStation>

        <loadingStation supportsExtension="true" storageRadius="50">
            <loadTrigger triggerNode="liquidManureTrigger" fillTypes="LIQUIDMANURE" fillLitersPerSecond="2000" aiNode="aiLoadingNodeLiquidManure"/>
        </loadingStation>

        <animals type="PIG" maxNumAnimals="500">
            <navigation rootNode="navigationRootNode" filename="placeables/animals/navMeshPigF1A1.i3d"/>
            <loadingTrigger node="loadingTrigger" />
        </animals>

        <straw>
            <manure factor="1.5" />
            <strawPlane node="strawPlane" minY="-0.14" maxY="-0.10" changeVisibility="true" />
        </straw>

        <food capacity="250000" >
            <foodPlane node="foodPlane" minY="0.09" maxY="0.15" changeVisibility="true" defaultFillType="WHEAT" />
            <foodPlaces>
                <foodPlace node="foodPlace1" />
                <foodPlace node="foodPlace2" />
                <foodPlace node="foodPlace3" />
            </foodPlaces>
            <unloadTrigger exactFillRootNode="exactFillRootNodeFood" />
            <palletTrigger triggerNode="palletTrigger"/>
        </food>

        <water automaticWaterSupply="true" />

        <meadow>
            <createTask weedState="0">
                <fruit type="UNKNOWN" growthState="0"/>
                <ground type="NONE" />
                <terrainGroundType name="dirt" />
            </createTask>
        </meadow>
    </husbandry>

    <i3dMappings>
	    <i3dMapping id="foodPlane" node="0>5|0" />
        <i3dMapping id="exactFillRootNodeFood" node="0>5|1" />
        <i3dMapping id="foodPlace1" node="0>5|4|0" />
        <i3dMapping id="foodPlace2" node="0>5|4|1" />
        <i3dMapping id="foodPlace3" node="0>5|4|2" />
        <i3dMapping id="palletTrigger" node="0>5|8" />
        <i3dMapping id="liquidManureTrigger" node="0>6|0" />
        <i3dMapping id="aiLoadingNodeLiquidManure" node="0>6|1" />
        <i3dMapping id="strawPlane" node="0>7|0" />
        <i3dMapping id="baleTriggerStraw" node="0>7|1" />
        <i3dMapping id="exactFillRootNodeStraw" node="0>7|2" />
        <i3dMapping id="navigationRootNode" node="0>8" />
        <i3dMapping id="markerLiquidManure" node="0>10|0" />
        <i3dMapping id="markerFood" node="0>10|1" />
        <i3dMapping id="markerAnimals" node="0>10|2" />
        <i3dMapping id="markerStraw" node="0>10|3" />
        <i3dMapping id="realLightsLow" node="0>12|1|0" />
        <i3dMapping id="realLightsHigh" node="0>12|1|1" />
        <i3dMapping id="teleportNode" node="0>13" />
        <i3dMapping id="storage" node="0>14" />
        <i3dMapping id="infoTrigger" node="0>15" />
        <i3dMapping id="loadingTrigger" node="0>16" />
    </i3dMappings>
</placeable>
