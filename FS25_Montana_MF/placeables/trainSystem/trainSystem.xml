<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="trainSystem" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>TrainSystem</name>
        <image>$data/store/store_empty.png</image>
        <price>1</price>
        <canBeSold>false</canBeSold>
        <showInStore>false</showInStore>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>placeableMisc</category>
        <vertexBufferMemoryUsage>0</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>0</indexBufferMemoryUsage>
        <textureMemoryUsage>0</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <filename>placeables/trainSystem/trainSystem.i3d</filename>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" />

    <hotspots>
        <hotspot type="TRAIN" linkNode="0>2|1" teleportNode="0>2|2" text="$l10n_hotspot_rentTrain" />
        <hotspot type="TRAIN" linkNode="0>8|1" teleportNode="0>8|2" text="$l10n_hotspot_rentTrain" />
        <hotspot type="TRAIN" linkNode="0>9|1" teleportNode="0>9|2" text="$l10n_hotspot_rentTrain" />
    </hotspots>

    <triggerMarkers>
        <triggerMarker node="0>2|1" filename="$data/shared/assets/marker/markerIconTrain.i3d" adjustToGround="false" />
        <triggerMarker node="0>8|1" filename="$data/shared/assets/marker/markerIconTrain.i3d" adjustToGround="false" />
        <triggerMarker node="0>9|1" filename="$data/shared/assets/marker/markerIconTrain.i3d" adjustToGround="false" />
    </triggerMarkers>

    <ai>
        <updateAreas></updateAreas>
    </ai>

    <trainSystem>
        <rent pricePerHour="3500"/>
        <spline node="0>0" splineYOffset="0.12" />
        <electricitySpline></electricitySpline>

        <drivingRange startNode="1|0" endNode="1|1" sellingStationId="sellingStationTrain01"/>

        <train>
            <vehicle xmlFilename="placeables/trainSystem/ac4400bnsf.xml" />
            <vehicle xmlFilename="placeables/trainSystem/ac4400bnsf2.xml" />
            <vehicle xmlFilename="placeables/trainSystem/grainhopperbnsf.xml" />
            <vehicle xmlFilename="placeables/trainSystem/grainhopperbnsf.xml" />
            <vehicle xmlFilename="placeables/trainSystem/grainhopperbnsf.xml" />
            <vehicle xmlFilename="placeables/trainSystem/grainhopperbnsf.xml" />
            <vehicle xmlFilename="placeables/trainSystem/grainhopperbnsf.xml" />
            <vehicle xmlFilename="placeables/trainSystem/grainhopperbnsf.xml" />
            <vehicle xmlFilename="placeables/trainSystem/grainhopperbnsf.xml" />
            <vehicle xmlFilename="placeables/trainSystem/grainhopperbnsf.xml" />
			<vehicle xmlFilename="placeables/trainSystem/grainhopperbnsf.xml" />
            <vehicle xmlFilename="placeables/trainSystem/grainhopperbnsf.xml" />
			<vehicle xmlFilename="$data/vehicles/train/wagonFlatBedUS/wagonFlatBedUS.xml"/>
        </train>

        <railroadCallers>
            <railroadCaller triggerNode="0>2|0" />
            <railroadCaller triggerNode="0>8|0" />
            <railroadCaller triggerNode="0>9|0" />
        </railroadCallers>

        <railroadCrossings>

            <!-- 01 -->
            <railroadCrossing rootNode="0>3">
                <activation startDistance="200" endDistance="200" />
                <gates>
                    <gate node="0>3|0|1" startRot="0 0 0"   endRot="90 0 0"    duration="4" closingOffset="2" />
                    <gate node="0>3|1|1" startRot="0 0 0"   endRot="90 0 0"    duration="4" closingOffset="2"/>
                </gates>
                <trafficBlockers>
                    <blocker node="0>3|0|2" />
                    <blocker node="0>3|1|2" />
                </trafficBlockers>
                <signals>
                    <signal node="0>3|0|3|0" alternatingLights="true" />
                    <signal node="0>3|1|3|0" alternatingLights="true" />
                </signals>
                <sounds>
                    <crossing template="trainCrossingBell01" linkNode="0>3" />
                </sounds>
            </railroadCrossing>

            <!-- 02 -->
            <railroadCrossing rootNode="0>4">
                <activation startDistance="200" endDistance="200" />
                <gates>
                    <gate node="0>4|0|1" startRot="0 0 0"   endRot="90 0 0"    duration="4" closingOffset="2" />
                    <gate node="0>4|1|1" startRot="0 0 0"   endRot="90 0 0"    duration="4" closingOffset="2"/>
                </gates>
                <trafficBlockers>
                    <blocker node="0>4|0|2" />
                    <blocker node="0>4|1|2" />
                </trafficBlockers>
                <signals>
                    <signal node="0>4|0|3|0" alternatingLights="true" />
                    <signal node="0>4|1|3|0" alternatingLights="true" />
                </signals>
                <sounds>
                    <crossing template="trainCrossingBell01" linkNode="0>4" />
                </sounds>
            </railroadCrossing>

            <!-- 03 -->
            <railroadCrossing rootNode="0>5">
                <activation startDistance="200" endDistance="200" />
                <gates>
                    <gate node="0>5|0|1" startRot="0 0 0"   endRot="90 0 0"    duration="4" closingOffset="2" />
                    <gate node="0>5|1|1" startRot="0 0 0"   endRot="90 0 0"    duration="4" closingOffset="2"/>
                </gates>
                <aiNavigationBlockers>
                    <blocker node="0>5|0|2" />
                    <blocker node="0>5|1|2" />
                </aiNavigationBlockers>
                <signals>
                    <signal node="0>5|0|3|0" alternatingLights="true" />
                    <signal node="0>5|1|3|0" alternatingLights="true" />
                </signals>
                <sounds>
                    <crossing template="trainCrossingBell01" linkNode="0>5" />
                </sounds>
            </railroadCrossing>

            <!-- 04 -->
            <railroadCrossing rootNode="0>6">
                <activation startDistance="200" endDistance="200" />
                <gates>
                    <gate node="0>6|0|1" startRot="0 0 0"   endRot="90 0 0"    duration="4" closingOffset="2" />
                    <gate node="0>6|1|1" startRot="0 0 0"   endRot="90 0 0"    duration="4" closingOffset="2"/>
                </gates>
                <trafficBlockers>
                    <blocker node="0>6|0|2" />
                    <blocker node="0>6|1|2" />
                </trafficBlockers>
                <signals>
                    <signal node="0>6|0|3|0" alternatingLights="true" />
                    <signal node="0>6|1|3|0" alternatingLights="true" />
                </signals>
                <sounds>
                    <crossing template="trainCrossingBell01" linkNode="0>6" />
                </sounds>
            </railroadCrossing>

            <!-- 05 -->
            <railroadCrossing rootNode="0>7">
                <activation startDistance="200" endDistance="200" />
                <gates>
                    <gate node="0>7|0|1" startRot="0 0 0"   endRot="90 0 0"    duration="4" closingOffset="2" />
                    <gate node="0>7|1|1" startRot="0 0 0"   endRot="90 0 0"    duration="4" closingOffset="2"/>
                </gates>
                <trafficBlockers>
                    <blocker node="0>7|0|2" />
                    <blocker node="0>7|1|2" />
                </trafficBlockers>
                <signals>
                    <signal node="0>7|0|3|0" alternatingLights="true" />
                    <signal node="0>7|1|3|0" alternatingLights="true" />
                </signals>
                <sounds>
                    <crossing template="trainCrossingBell01" linkNode="0>7" />
                </sounds>
            </railroadCrossing>
        </railroadCrossings>
    </trainSystem>

    <clearAreas></clearAreas>

    <leveling></leveling>

    <indoorAreas></indoorAreas>

</placeable>
