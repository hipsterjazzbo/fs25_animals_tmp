<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="trainTrailer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">
    <annotation>Copyright (C) GIANTS Software GmbH, All Rights Reserved.</annotation>

    <storeData>
        <name>Grain Wagon</name>
        <image>$data/store/store_empty.png</image>
        <price>1</price>
        <canBeSold>false</canBeSold>
        <showInStore>false</showInStore>
        <lifetime>600</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <category>misc</category>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_tipper</typeDesc>
        <filename>placeables/trainSystem/grainhopperUS.i3d</filename>
        <size width="3.6" length="17" height="5" lengthOffset="-6.2" />
        <components>
            <component centerOfMass="0 0.7 -1" solverIterationCount="10" mass="45000" />
        </components>
        <schemaOverlay attacherJointPosition="0 0" name="IMPLEMENT" />
        <mapHotspot available="false" />
    </base>
	
	<design7Configurations title="railroad">
        <design7Configuration name="BNSF">
            <objectChange node="reflector" visibilityActive="true"/>
            <objectChange node="reflectorkcs" visibilityActive="false"/>
            <objectChange node="reflectorcp" visibilityActive="false"/>
			<objectChange node="bnsf" visibilityActive="true"/>
			<objectChange node="cn" visibilityActive="false"/>
			<objectChange node="cp" visibilityActive="false"/>
			<objectChange node="csx" visibilityActive="false"/>
			<objectChange node="kcs" visibilityActive="false"/>
			<objectChange node="ns" visibilityActive="false"/>
			<objectChange node="up" visibilityActive="false"/>
			
			<material materialSlotName="hopper_blackcalibratedGlossPaintMat">
				<colorScale value="0.235 0.033 0.041"/>
			</material>
			<material materialSlotName="hopper_greycalibratedGlossPaintMat">
				<colorScale value="0.235 0.033 0.041"/>
			</material>
			<material materialSlotName="hopper_redcalibratedGlossPaintMat">
				<colorScale value="0.235 0.033 0.041"/>
			</material>
			<material materialSlotName="hopper_yellowcalibratedGlossPaintMat">
				<colorScale value="0.235 0.033 0.041"/>
			</material>
        </design7Configuration>
    </design7Configurations>

    <wheels>
        <wheelConfigurations>
            <wheelConfiguration>
                <wheels surfaceSoundLinkNode="surfaceSoundNode" />
            </wheelConfiguration>
        </wheelConfigurations>
    </wheels>

    <splineVehicle>
        <dollies frontNode="frontNode" backNode="backNode" dolly1Node="dollyFront" dolly2Node="dollyBack" />
    </splineVehicle>

    <speedRotatingParts>
        <speedRotatingPart node="wheel01" radius="0.44" />
        <speedRotatingPart node="wheel02" radius="0.44" />
        <speedRotatingPart node="wheel03" radius="0.44" />
        <speedRotatingPart node="wheel04" radius="0.44" />
    </speedRotatingParts>

    <attachable>
        <inputAttacherJoints>
            <inputAttacherJoint node="attacherJoint" jointType="train" allowsDetaching="false"/>
        </inputAttacherJoints>
    </attachable>

    <attacherJoints>
        <attacherJoint node="trailerAttacherJointNode" jointType="train" allowsLowering="false">
            <schema position="1 0" rotation="0" invertX="false" />
            <bottomArm rotationNode="linkArm" referenceNode="referenceNode" zScale="-1" startRotation="-17 0 0" lockDirection="false" toggleVisibility="false"/>
        </attacherJoint>
        <sounds>
            <attach template="attach01" />
        </sounds>
    </attacherJoints>

    <animations>
        <animation name="tipAnimation">
            <part node="tipAnimationNode" startTime="0" endTime="2" startRot="0 0 0" endRot="359 0 0" />
        </animation>
        <animation name="toggleCover">
            <part node="cover" startTime="0" endTime="4" startRot="0 0 0" endRot="0 0 165" />

            <sound template="hingeMedium"   startTime="1.0"  direction="1"  volumeScale="3"   pitchScale="0.6"/>
            <sound template="hingeMedium"   startTime="3.0"  direction="-1" volumeScale="3"   pitchScale="0.6"/>
            <sound template="clackVar6"     startTime="3.99" direction="1"  volumeScale="3"   pitchScale="0.6"/>
            <sound template="thudVar2"      startTime="3.99" direction="1"  volumeScale="2"   pitchScale="0.6"/>
            <sound template="sheetImp02"    startTime="3.99" direction="1"  volumeScale="2"   pitchScale="0.6"/>
            <sound template="sheetImp02"    startTime="0.01" direction="-1" volumeScale="2"   pitchScale="0.6"/>
            <sound template="clackVar6"     startTime="0.01" direction="-1" volumeScale="3"   pitchScale="0.5"/>
            <sound template="cylinderPunch" startTime="0.01" direction="-1" volumeScale="0.7" pitchScale="1.3"/>
        </animation>
    </animations>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits fillTypeChangeThreshold="0.01">
                    <fillUnit shopDisplayUnit="CUBICMETER" fillTypeCategories="TRAINWAGON" capacity="150000" blocksAutomatedTrainTravel="true">
                        <exactFillRootNode node="exactFillRootNode" />
                    </fillUnit>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <trailer>
        <trailerConfigurations>
            <trailerConfiguration>
                <trailer>
                    <tipSide name="$l10n_info_tipSideBack" dischargeNodeIndex="1">
                        <animation name="tipAnimation" speedScale="1.0" />
                    </tipSide>
                </trailer>
            </trailerConfiguration>
        </trailerConfigurations>
    </trailer>

    <dischargeable>
        <dischargeNode node="dischargeNode" emptySpeed="6000" fillUnitIndex="1" canDischargeToGround="false" >
            <info width="1.0" length="0.5" zOffset="0.4" />
            <effects>
                <effectNode effectNode="effectGrain" materialType="unloading" fadeTime="0.5" useDistance="false" />
            </effects>
        </dischargeNode>
    </dischargeable>

    <fillVolume>
        <fillVolumeConfigurations>
            <fillVolumeConfiguration>
                <volumes>
                    <volume node="fillVolume" maxDelta="0.05" fillUnitIndex="1" />
                </volumes>
            </fillVolumeConfiguration>
        </fillVolumeConfigurations>
    </fillVolume>

    <cover>
        <coverConfigurations>
            <coverConfiguration >
                <cover openAnimation="toggleCover" fillUnitIndices="1" />
            </coverConfiguration>
        </coverConfigurations>
    </cover>
    <i3dMappings>
        <i3dMapping id="wagonGrainEU_main_component1" node="0>" />
        <i3dMapping id="dollyFront" node="0>0" />
        <i3dMapping id="wheel01" node="0>0|0" />
        <i3dMapping id="wheel02" node="0>0|1" />
        <i3dMapping id="dollyBack" node="0>1" />
        <i3dMapping id="wheel03" node="0>1|0" />
        <i3dMapping id="wheel04" node="0>1|1" />
        <i3dMapping id="frontNode" node="0>2" />
        <i3dMapping id="backNode" node="0>3" />
        <i3dMapping id="attacherJoint" node="0>4" />
        <i3dMapping id="inputAttacherJointNode" node="0>4|0" />
        <i3dMapping id="trailerAttacherJoint" node="0>5" />
        <i3dMapping id="trailerAttacherJointNode" node="0>5|0" />
        <i3dMapping id="linkArm" node="0>5|0|0" />
        <i3dMapping id="referenceNode" node="0>5|0|0|0" />
        <i3dMapping id="cover" node="0>6" />
        <i3dMapping id="tipAnimationNode" node="0>7" />
        <i3dMapping id="dischargeNode" node="0>8" />
        <i3dMapping id="fillVolume" node="0>9" />
        <i3dMapping id="exactFillRootNode" node="0>10" />
        <i3dMapping id="surfaceSoundNode" node="0>11" />
        <i3dMapping id="effectGrain" node="0>12|0" />
		<i3dMapping id="reflector" node="0>13|2" />
		<i3dMapping id="reflectorcp" node="0>13|3" />
		<i3dMapping id="reflectorkcs" node="0>13|4" />
		<i3dMapping id="bnsf" node="0>13|5" />
		<i3dMapping id="cn" node="0>13|6" />
		<i3dMapping id="cp" node="0>13|7" />
		<i3dMapping id="csx" node="0>13|8" />
		<i3dMapping id="kcs" node="0>13|9" />
		<i3dMapping id="ns" node="0>13|10" />
		<i3dMapping id="up" node="0>13|11" />
    </i3dMappings>
</vehicle>
