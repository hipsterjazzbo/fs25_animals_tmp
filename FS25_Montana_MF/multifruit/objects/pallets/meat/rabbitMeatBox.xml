<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="pallet" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">
    <annotation>Copyright (C) GIANTS Software GmbH, All Rights Reserved.</annotation>

    <storeData>
        <name>$l10n_storeItem_meatBox</name>
        <image>$data/store/store_empty.png</image>
        <category>pallets</category>
        <brand>JINKOU</brand>
        <showInStore>false</showInStore>
        <canBeSold>false</canBeSold>
		<rotation>90</rotation>
        <financeCategory>OTHER</financeCategory>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_pallet</typeDesc>
        <filename>multifruit/objects/pallets/meat/rabbitMeatBox.i3d</filename>
        <size width="0.512" length="0.744" height="0.232" />
        <canBeReset>false</canBeReset>
		<supportsPickUp>true</supportsPickUp>
        <components>
            <component centerOfMass="0 0.1 0" solverIterationCount="10" mass="25"/>
        </components>
        <showInVehicleMenu>false</showInVehicleMenu>
        <mapHotspot available="false" />
        <input allowed="false"/>
    </base>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits removeVehicleIfEmpty="true">
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="RABBITMEAT" capacity="1000" updateMass="false"/>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>
	
	<tensionBeltObject>
        <meshNodes>
            <meshNode node="box_vis"/>
        </meshNodes>
    </tensionBeltObject>
    
    <i3dMappings>
        <i3dMapping id="meatBox_component1" node="0>" />
        <i3dMapping id="box_vis" node="0>0" />
        <i3dMapping id="dischargeNode" node="0>2" />
    </i3dMappings>
</vehicle>