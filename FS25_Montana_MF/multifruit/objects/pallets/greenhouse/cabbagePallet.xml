<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="pallet" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">
    <annotation>Copyright (C) GIANTS Software GmbH, All Rights Reserved.</annotation>

    <storeData>
        <name>cabbagePallet</name>
        <image>$data/store/store_empty.png</image>
        <category>pallets</category>
        <brand>JINKOU</brand>
        <showInStore>false</showInStore>
        <canBeSold>false</canBeSold>
        <financeCategory>OTHER</financeCategory>
        <vertexBufferMemoryUsage>26880</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>8448</indexBufferMemoryUsage>
        <textureMemoryUsage>1114112</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_pallet</typeDesc>
        <filename>multifruit/objects/pallets/greenhouse/cabbagePallet.i3d</filename>
        <size width="1.4" length="1" height="1" />
        <canBeReset>false</canBeReset>
        <components>
            <component centerOfMass="0 0.1 0" solverIterationCount="10" mass="60"/>
        </components>
        <showInVehicleMenu>false</showInVehicleMenu>
        <mapHotspot available="false" />
    </base>

    <fillUnit>
		<fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits removeVehicleIfEmpty="true">
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="CABBAGE" capacity="1000" ignoreFillLimit="true"/>
                </fillUnits>
            </fillUnitConfiguration>
		</fillUnitConfigurations>
    </fillUnit>
	
	 <pallet fillUnitIndex="1" linkNode="3">
        <content>
            <object node="1|0" tensionBeltNode="1|0|0"/>
            <object node="1|1" tensionBeltNode="1|1|0"/>
            <object node="1|2" tensionBeltNode="1|2|0"/>
            <object node="1|3" tensionBeltNode="1|3|0"/>
            <object node="1|4" tensionBeltNode="1|4|0"/>
            <object node="1|5" tensionBeltNode="1|5|0"/>
            <object node="1|6" tensionBeltNode="1|6|0"/>
            <object node="1|7" tensionBeltNode="1|7|0"/>
        </content>


        <sounds>
            <unload template="palletsFillPlastic" pitchScale="0.8" />
        </sounds>
    </pallet>

    <dynamicMount triggerNode="0" triggerForceAcceleration="5" additionalMountDistance="0.8" jointTransY="0.11" jointLimitToRotY="true"/>
</vehicle>