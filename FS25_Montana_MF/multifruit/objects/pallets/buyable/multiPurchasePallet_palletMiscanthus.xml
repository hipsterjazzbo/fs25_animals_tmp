<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="multipleItemPurchase" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">
    <annotation>Copyright (C) GIANTS Software GmbH, All Rights Reserved.</annotation>

    <storeData>
        <name>$l10n_fillType_miscanthus</name>
        <functions>
            <function>$l10n_fillType_miscanthus</function>
        </functions>
        <storePacks>
            <storePack>STARTER_POTATOES</storePack>
        </storePacks>
        <specs>
            <combination xmlFilename="$data/vehicles/grimme/gl420/gl420.xml"/>
            <combination xmlFilename="$data/vehicles/grimme/gl860/gl860.xml"/>
            <combination xmlFilename="$data/vehicles/grimme/prios440/prios440.xml"/>
            <weight ignore="true"/>
        </specs>
        <image>$data/objects/pallets/palletPotato/store_palletPotato.png</image>
        <price>750</price>
        <allowLeasing>false</allowLeasing>
        <canBeSold>false</canBeSold>
        <rotation>0</rotation>
        <shopHeight>1.5</shopHeight>
        <brand>JINKOU</brand>
        <category>pallets palletSeedsRootcrops</category>
        <financeCategory>PURCHASE_SEEDS</financeCategory>
        <vertexBufferMemoryUsage>0</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>0</indexBufferMemoryUsage>
        <textureMemoryUsage>0</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>

        <storeIconRendering>
            <settings cameraXRot="-15" cameraYRot="35" />
        </storeIconRendering>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_pallet</typeDesc>
        <filename>$data/objects/multiPurchaseItem/multiPurchaseItem.i3d</filename>
        <size width="2.6" length="3.6" height="0.8" lengthOffset="0.0"/>
        <input allowed="false"/>
        <canBeReset>false</canBeReset>
        <components>
            <component centerOfMass="0 0.1 0" solverIterationCount="10" mass="100" />
        </components>
        <showInVehicleMenu>false</showInVehicleMenu>
        <mapHotspot available="false" />
    </base>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits removeVehicleIfEmpty="true">
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="MISCANTHUS" capacity="1000"/>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <multipleItemPurchase filename="multifruit/objects/pallets/buyable/palletMiscanthus.xml" isVehicle="true">
        <offsets>
            <offset amount="2" offset="0.65 0 0"/>
            <offset amount="3" offset="0.65 0 0.45"/>
            <offset amount="5" offset="0.65 0 0.9"/>
            <offset amount="7" offset="0.65 0 1.35"/>
        </offsets>
        <itemPositions>
            <itemPosition position="0 0 0" rotation="0 0 0"/>
            <itemPosition position="-1.3 0 0" rotation="0 0 0"/>
            <itemPosition position="0 0 -0.9" rotation="0 0 0"/>
            <itemPosition position="-1.3 0 -0.9" rotation="0 0 0"/>

            <itemPosition position="0 0 -1.8" rotation="0 0 0"/>
            <itemPosition position="-1.3 0 -1.8" rotation="0 0 0"/>
            <itemPosition position="0 0 -2.7" rotation="0 0 0"/>
            <itemPosition position="-1.3 0 -2.7" rotation="0 0 0"/>
        </itemPositions>
    </multipleItemPurchase>

    <multipleItemPurchaseAmountConfigurations>
        <multipleItemPurchaseAmountConfiguration name="1" price="0"/>
        <multipleItemPurchaseAmountConfiguration name="2" price="750"/>
        <multipleItemPurchaseAmountConfiguration name="3" price="1400"/>
        <multipleItemPurchaseAmountConfiguration name="4" price="2100"/>
        <multipleItemPurchaseAmountConfiguration name="5" price="2800"/>
        <multipleItemPurchaseAmountConfiguration name="6" price="3500"/>
        <multipleItemPurchaseAmountConfiguration name="7" price="4200"/>
        <multipleItemPurchaseAmountConfiguration name="8" price="5050"/>
    </multipleItemPurchaseAmountConfigurations>
</vehicle>