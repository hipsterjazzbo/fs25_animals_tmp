<?xml version="1.0" encoding="utf-8"?>
<foliageType xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../shared/xml/schema/foliageType.xsd">
    <fruitType name="safflower" shownOnMap="true" useForFieldMissions="true">
        <mapColors default="0.8500 0.3000 0.0500 1" colorBlind="0.5500 0.3500 0.2000 1"/>
        <windrow litersPerSqm="3.68" cutFillType="CANOLA_CUT" windrowCutFactor="1.25"/>
        <harvest litersPerSqm="0.58" cutHeight="0.30" chopperType="CHOPPER_STRAW" forageCutHeight="0.15" beeYieldBonusPercentage="0.10"/>
        <growth resetsSpray="true" growthRequiresLime="true"/>
        <soil lowDensityRequired="true" increasesDensity="false" consumesLime="true" startSprayLevel="0"/>
        <seeding directionSnapAngle="0" needsRolling="true" litersPerSqm="0.0049" isAvailable="true"/>
        <cultivation isAllowed="true"/>
        <mulcher chopperType="CHOPPER_STRAW"/>
    </fruitType>

    <!-- canola

    0 1 2 3

    1 0 0 0 - invisible
    0 1 0 0 - green small
    1 1 0 0 - green small 2
    0 0 1 0 - green small 3
    1 0 1 0 - green middle
    0 1 1 0 - green middle 2
    1 1 1 0 - green big
    0 0 0 1 - green big 2
    1 0 0 1 - harvest ready
    0 1 0 1 - dead
    1 1 0 1 - harvested (cut)

    -->
    <foliageLayer densityMapChannelOffset="0" numDensityMapChannels="4" numBlocksPerUnit="1.5" shapeSource="safflower/safflower.i3d" alignsToSun="false">
        <foliageStateDefaults distanceMapLayer="1" width="1.0" height="1.0" widthVariance="0.2" heightVariance="0.5" horizontalPositionVariance="0.2"/>
        <!-- default LOD distances etc -->
        <foliageLodDefaults lod="0" viewDistance="18" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1"/>
        <foliageLodDefaults lod="1" viewDistance="80" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1"/>
        
		<!-- 1 0 0 0 - invisible -->
        <foliageState name="1 invisible" isGrowing="true" allowsWeeding="true" allowsHoeing="true"/>
        
		<!-- 0 1 0 0 - green small -->
        <foliageState name="2 small" numBlocksPerUnit="3.5" distanceMap="distances/foliage_canola_distance2_diffuse.png" isGrowing="true" allowsWeeding="true" allowsHoeing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.3">
            <foliageShape>
                <foliageLod blockShape="0>0|0"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
        </foliageState>
        
		<!-- 1 0 1 0 - green middle -->
        <foliageState name="3 middle" numBlocksPerUnit="3" distanceMap="distances/foliage_canola_distance3_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.55">
            <foliageShape>
                <foliageLod blockShape="0>0|1"/>
                <foliageLod blockShape="0>1|1"/>
            </foliageShape>
        </foliageState>
        
		<!-- 1 1 1 0 - green big -->
        <foliageState name="4 big" width="1.2" distanceMap="distances/foliage_canola_distance4_diffuse.png" isGrowing="true" isForageReady="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="1.0">
            <foliageShape>
                <foliageLod blockShape="0>0|2"/>
                <foliageLod blockShape="0>1|2"/>
            </foliageShape>
        </foliageState>
        
		<!-- 1 0 0 1 - harvest ready -->
        <foliageState name="5 ready" numBlocksPerUnit="3" distanceMap="distances/foliage_canola_distance5_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" isHarvestReady="true" groundType="HARVEST_READY_OTHER" fieldCourseLineHeight="1.1">
            <foliageShape>
                <foliageLod blockShape="0>0|3"/>
                <foliageLod blockShape="0>1|3"/>
            </foliageShape>
        </foliageState>
       
	   <!-- 0 1 0 1 - dead -->
        <foliageState name="6 dead" numBlocksPerUnit="1.5" distanceMap="distances/foliage_canola_distance6_diffuse.png" isWithered="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.85">
            <foliageShape>
                <foliageLod blockShape="0>0|4"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
        </foliageState>
        
		<!-- 1 1 0 1 - harvested (cut) -->
        <foliageState name="7 cut" numBlocksPerUnit="3" distanceMap="distances/foliage_canola_distance7_diffuse.png" isCut="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0>0|5"/>
                <foliageLod blockShape="0>1|5"/>
            </foliageShape>
        </foliageState>
        
		<!-- 1 1 1 1 - tire tracks (harvested) -->
        <foliageState name="8 tyre" height="0.2" numBlocksPerUnit="3" distanceMap="distances/foliage_canola_distance7_diffuse.png" isCut="false" isDestructibleByWheel="false" isDestructedByWheel="true" isDestructedByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0>0|5"/>
                <foliageLod blockShape="0>1|5"/>
            </foliageShape>
        </foliageState>
    </foliageLayer>

    <growth>
        <seasonal initialState="5 ready">
            <period name="EARLY_SPRING" />
            <period name="MID_SPRING" plantingAllowed="true">
                <update startState="1 invisible" endState="2 small" />
            </period>
            <period name="LATE_SPRING" plantingAllowed="true">
                <update startState="1 invisible" endState="2 small" />
                <update startState="2 small" endState="3 middle" />
            </period>
            <period name="EARLY_SUMMER" >
                <update startState="2 small" endState="3 middle" />
                <update startState="3 middle" endState="4 big" />
            </period>
            <period name="MID_SUMMER">
                <update startState="3 middle" endState="4 big" />
                <update startState="4 big" endState="5 ready" />
            </period>
            <period name="LATE_SUMMER" >
                <update startState="4 big" endState="5 ready" />
                <update startState="5 ready" endState="6 dead" />
            </period>
            <period name="EARLY_AUTUMN" >
                <update startState="5 ready" endState="6 dead" />
            </period>
            <period name="MID_AUTUMN">
            </period>
            <period name="LATE_AUTUMN"/>
            <period name="EARLY_WINTER" />
            <period name="MID_WINTER" />
            <period name="LATE_WINTER" />î
        </seasonal>
	</growth>
</foliageType>
