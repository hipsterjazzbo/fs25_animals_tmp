        <nonSeasonal>
            <update startState="1 invisible"        	endState="2 small" />
            <update startState="2 small"      		endState="3 big" />
            <update startState="3 big"  		endState="4 ready" />
            <update startState="5 cut"     		endState="2 small" />
            <update startState="6 rolled" 		endState="2 small" />
            <update startState="7 tire" 		endState="2 small" />
