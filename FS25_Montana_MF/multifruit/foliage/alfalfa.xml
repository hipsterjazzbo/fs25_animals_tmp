            <period name="EARLY_SUMMER" plantingAllowed="false"> <!-- June -->
                <update startState="2 small" endState="3 big" />
                <update startState="3 big" endState="4 ready" />
                <update startState="5 cut" endState="2 small" />
                <update startState="6 rolled" endState="2 small" />
                <update startState="7 tire" endState="2 small" />
            </period>
            <period name="MID_SUMMER" plantingAllowed="false"> <!-- July -->
                <update startState="2 small" endState="3 big" />
                <update startState="3 big" endState="4 ready" />
                <update startState="5 cut" endState="2 small" />
                <update startState="6 rolled" endState="2 small" />
                <update startState="7 tire" endState="2 small" />
            </period>
            <period name="LATE_SUMMER" plantingAllowed="false"> <!-- August -->
                <update startState="2 small" endState="3 big" />
                <update startState="3 big" endState="4 ready" />
                <update startState="5 cut" endState="2 small" />
                <update startState="6 rolled" endState="2 small" />
                <update startState="7 tire" endState="2 small" />
            </period>
            <period name="EARLY_AUTUMN" plantingAllowed="true"> <!-- September -->
                <update startState="1 invisible" endState="2 small" />
                <update startState="2 small" endState="3 big" />
                <update startState="3 big" endState="4 ready" />
                <update startState="5 cut" endState="2 small" />
                <update startState="6 rolled" endState="2 small" />
                <update startState="7 tire" endState="2 small" />
            </period>
            <period name="MID_AUTUMN" plantingAllowed="true"> <!-- October -->
                <update startState="1 invisible" endState="2 small" />
                <update startState="2 small" endState="3 big" />
                <update startState="3 big" endState="4 ready" />				
                <update startState="4 ready" endState="2 small" />
                <update startState="5 cut" endState="2 small" />
                <update startState="6 rolled" endState="2 small" />
                <update startState="7 tire" endState="2 small" />
            </period>
            <period name="LATE_AUTUMN" plantingAllowed="false"> <!-- November -->
                <update startState="3 big" endState="2 small" />
                <update startState="4 ready" endState="2 small" />
                <update startState="5 cut" endState="2 small" />
                <update startState="6 rolled" endState="2 small" />
                <update startState="7 tire" endState="2 small" />
                <!-- Completely knocked back for winter -->
            </period>
            <period name="EARLY_WINTER" plantingAllowed="false"> <!-- December -->
			   <!-- Dormant, no growth -->
            </period>
            <period name="MID_WINTER" plantingAllowed="false"> <!-- January -->
                <!-- Dormant, no growth -->
            </period>
            <period name="LATE_WINTER" plantingAllowed="false"> <!-- February -->
                <!-- Dormant, no growth -->
            </period>
