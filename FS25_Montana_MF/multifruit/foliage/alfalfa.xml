        </foliageState>
		
        <!-- 1 0 1 0 - mowed (cut) -->
        <foliageState name="5 cut" numBlocksPerUnit="3.0" distanceMap="distances/foliage_grass_distance5_diffuse.png" isCut="true" isDestructibleByWheel="true" isDestructedByDisaster="true" isMulched="true">
