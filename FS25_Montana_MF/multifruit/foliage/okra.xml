<?xml version="1.0" encoding="utf-8"?>
<foliageType xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../shared/xml/schema/foliageType.xsd">
    <fruitType name="okra" shownOnMap="true" useForFieldMissions="false">
        <mapColors default="0.2000 0.4600 0.1800 1" colorBlind="0.4500 0.5500 0.2500 1"/>
        <harvest litersPerSqm="0.5975" chopperUseHaulm="true" beeYieldBonusPercentage="0.10"/>
        <growth resetsSpray="true" growthRequiresLime="true"/>
        <soil lowDensityRequired="true" increasesDensity="true" consumesLime="true" startSprayLevel="0"/>
        <seeding directionSnapAngle="0" needsRolling="false" litersPerSqm="0.0204" isAvailable="true"/>
        <cultivation isAllowed="true"/>
        <haulm layerName="okra_haulm"/>
    </fruitType>

    <!-- okra

    0 1 2 3

    1 0 0 0 - invisible
    0 1 0 0 - green small
    1 1 0 0 - green small 2
    0 0 1 0 - green small 3
    1 0 1 0 - green middle
    0 1 1 0 - green middle 2
    1 1 1 0 - green big
    0 0 0 1 - green big 2
    1 0 0 1 - harvest ready
    0 1 0 1 - dead
    1 1 0 1 - harvested (cut)

    -->
    <foliageLayer densityMapChannelOffset="0" numDensityMapChannels="4" numBlocksPerUnit="1.5" shapeSource="okra/okra.i3d" alignsToSun="false">
        <foliageStateDefaults distanceMapLayer="1" width="1.0" height="1.0" widthVariance="0" heightVariance="0.3" horizontalPositionVariance="0"/>
        <!-- default LOD distances etc -->
        <foliageLodDefaults lod="0" viewDistance="18" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1"/>
        <foliageLodDefaults lod="1" viewDistance="80" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1"/>
        
		<!-- 1 0 0 0 - invisible -->
        <foliageState name="invisible" isGrowing="true" allowsWeeding="true" allowsHoeing="true"/>
        
		<!-- 0 1 0 0 - green small -->
        <foliageState name="greenSmall" distanceMap="distances/foliage_greenBean_distance2_diffuse.png" isGrowing="true" allowsWeeding="true" allowsHoeing="true" fieldCourseLineHeight="0.25">
            <foliageShape>
                <foliageLod blockShape="0>0|0"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
        </foliageState>
        
		<!-- 1 0 1 0 - green middle -->
        <foliageState name="greenMiddle" distanceMap="distances/foliage_greenBean_distance3_diffuse.png" isGrowing="true" allowsWeeding="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.5">
            <foliageShape>
                <foliageLod blockShape="0>0|1"/>
                <foliageLod blockShape="0>1|1"/>
            </foliageShape>
        </foliageState>
        
		<!-- 1 1 1 0 - green big -->
        <foliageState name="greenBig" width="1.2" height="0.8" distanceMap="distances/foliage_greenBean_distance4_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.85">
            <foliageShape>
                <foliageLod blockShape="0>0|2"/>
                <foliageLod blockShape="0>1|2"/>
            </foliageShape>
        </foliageState>
        
		<!-- 1 0 0 1 - harvest ready -->
        <foliageState name="harvestReady" width="1.6" height="0.8" distanceMap="distances/foliage_greenBean_distance4_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" isHarvestReady="true" groundType="HARVEST_READY">
            <foliageShape>
                <foliageLod blockShape="0>0|3"/>
                <foliageLod blockShape="0>1|3"/>
            </foliageShape>
        </foliageState>
       
	   <!-- 0 1 0 1 - dead -->
        <foliageState name="dead" distanceMap="distances/foliage_greenBean_distance6_diffuse.png" isWithered="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" >
            <foliageShape>
                <foliageLod blockShape="0>0|4"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
        </foliageState>
        
		<!-- 1 1 0 1 - harvested (cut) -->
        <foliageState name="harvested" width="1.2" distanceMap="distances/foliage_greenBean_distance6_diffuse.png" isCut="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
	<foliageShape>
                <foliageLod blockShape="0>0|5"/>
                <foliageLod blockShape="0>1|5"/>
            </foliageShape>
        </foliageState>
        
		<!-- 1 1 1 1 - tire tracks (harvested) -->
        <foliageState name="tireTracks" height="0.5" isCut="true" distanceMap="distances/foliage_greenBean_distance6_diffuse.png" isDestructedByWheel="true" isDestructibleByDisaster="true">
	<foliageShape>
                <foliageLod blockShape="0>0|5"/>
                <foliageLod blockShape="0>1|5"/>
            </foliageShape>
        </foliageState>
    </foliageLayer>

    <!-- chopper haulm -->
    <foliageLayer name="haulm" densityMapChannelOffset="4" numDensityMapChannels="1" numBlocksPerUnit="2.0" shapeSource="okra/okraHaulm.i3d">
        <foliageStateDefaults width="0.6" height="0.6" widthVariance="0" heightVariance="0" horizontalPositionVariance="0.3"/>
        <foliageLodDefaults lod="0" viewDistance="80"/>
        <foliageState distanceMapLayer="2" distanceMap="distances/foliage_greenBean_distance7_diffuse.png">
            <foliageShape>
                <foliageLod blockShape="0" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1"/>
            </foliageShape>
        </foliageState>
    </foliageLayer>

    <growth>
        <seasonal initialState="greenBig">
            <period name="EARLY_SPRING">
            </period>
            <period name="MID_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
            </period>
            <period name="LATE_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
            </period>
            <period name="EARLY_SUMMER">
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenBig" />
            </period>
            <period name="MID_SUMMER">
                <update startState="greenMiddle" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="LATE_SUMMER">
                <update startState="greenBig" endState="harvestReady" />
                <update startState="harvestReady" endState="dead" />
            </period>
            <period name="EARLY_AUTUMN">
                <update startState="harvestReady" endState="dead" />
            </period>
            <period name="MID_AUTUMN" />
            <period name="LATE_AUTUMN"/>
            <period name="EARLY_WINTER" />
            <period name="MID_WINTER" />
            <period name="LATE_WINTER" />
        </seasonal>
	
    </growth>
</foliageType>
