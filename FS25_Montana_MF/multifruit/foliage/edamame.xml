<?xml version="1.0" encoding="utf-8"?>
<foliageType xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../shared/xml/schema/foliageType.xsd">
    <fruitType name="edamame" shownOnMap="true" useForFieldMissions="false">
        <mapColors default="0.2195 0.2346 0.0273 1" colorBlind="0.3564 0.3095 0.0437 1"/>
        <harvest litersPerSqm="0.6975" chopperUseHaulm="true"/>
        <growth resetsSpray="true" growthRequiresLime="true"/>
        <soil lowDensityRequired="true" increasesDensity="true" consumesLime="true" startSprayLevel="0"/>
        <seeding directionSnapAngle="0" needsRolling="false" litersPerSqm="0.0244" isAvailable="true"/>
        <cultivation isAllowed="true"/>
        <haulm layerName="edamame_haulm"/>
    </fruitType>

    <!-- edamame

    0 1 2 3

    1 0 0 0 - invisible
    0 1 0 0 - green small
    1 1 0 0 - green middle
    0 0 1 0 - green middle 2
    1 0 1 0 - green big
    0 1 1 0 - green big 2
    1 1 1 0 - harvest ready
    0 0 0 1 - dead
    1 0 0 1 - harvested (cut)

    -->
    <foliageLayer densityMapChannelOffset="0" numDensityMapChannels="4" numBlocksPerUnit="2.376" shapeSource="edamame/edamame.i3d" alignsToSun="false">
        <foliageStateDefaults distanceMapLayer="1" width="1.0" height="1.0" widthVariance="0.1" heightVariance="0.2" horizontalPositionVariance="0.0"/>
        <!-- default LOD distances etc -->
        <foliageLodDefaults lod="0" viewDistance="18" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1"/>
        <foliageLodDefaults lod="1" viewDistance="80" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1"/>
        <!-- 1 0 0 0 - invisible -->
        <foliageState name="invisible" isGrowing="true" allowsWeeding="true" allowsHoeing="true"/>
        <!-- 0 1 0 0 - green small -->
        <foliageState name="greenSmall" distanceMap="distances/foliage_greenBean_distance2_diffuse.png" isGrowing="true" allowsWeeding="true" allowsHoeing="true" fieldCourseLineHeight="0.25">
            <foliageShape>
                <foliageLod blockShape="0>0|0"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|1"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|2"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
        </foliageState>
        <!-- 1 1 0 0 - green middle -->
        <foliageState name="greenMiddle" distanceMap="distances/foliage_greenBean_distance3_diffuse.png" isGrowing="true" allowsWeeding="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.5">
            <foliageShape>
                <foliageLod blockShape="0>0|3"/>
                <foliageLod blockShape="0>1|1"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|4"/>
                <foliageLod blockShape="0>1|1"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|5"/>
                <foliageLod blockShape="0>1|1"/>
            </foliageShape>
        </foliageState>
        <!-- 0 0 1 0 - green middle 2 -->
        <foliageState name="greenMiddle2" distanceMap="distances/foliage_greenBean_distance3_diffuse.png" isGrowing="true" allowsWeeding="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.5">
            <foliageShape>
                <foliageLod blockShape="0>0|3"/>
                <foliageLod blockShape="0>1|1"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|4"/>
                <foliageLod blockShape="0>1|1"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|5"/>
                <foliageLod blockShape="0>1|1"/>
            </foliageShape>

        </foliageState>
        <!-- 1 0 1 0 - green big -->
        <foliageState name="greenBig" distanceMap="distances/foliage_greenBean_distance4_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.85">
            <foliageShape>
                <foliageLod blockShape="0>0|6"/>
                <foliageLod blockShape="0>1|2"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|7"/>
                <foliageLod blockShape="0>1|2"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|8"/>
                <foliageLod blockShape="0>1|2"/>
            </foliageShape>
        </foliageState>
        <!-- 1 1 1 0 - harvest ready -->
        <foliageState name="harvestReady" width="1.2" height="1.2" distanceMap="distances/foliage_greenBean_distance4_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" isHarvestReady="true" groundType="HARVEST_READY">
            <foliageShape>
                <foliageLod blockShape="0>0|6"/>
                <foliageLod blockShape="0>1|2"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|7"/>
                <foliageLod blockShape="0>1|2"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|8"/>
                <foliageLod blockShape="0>1|2"/>
            </foliageShape>
        </foliageState>
        <!-- 0 0 0 1 - dead -->
        <foliageState name="dead" distanceMap="distances/foliage_greenBean_distance6_diffuse.png" isWithered="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" >
            <foliageShape>
                <foliageLod blockShape="0>0|12"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|13"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|14"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
        </foliageState>
        <!-- 1 0 0 1 - harvested (cut) -->
        <foliageState name="harvested" width="1.5" height="1.5" distanceMap="distances/foliage_greenBean_distance6_diffuse.png" isCut="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0>0|15"/>
                <foliageLod blockShape="0>1|5"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|16"/>
                <foliageLod blockShape="0>1|5"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|17"/>
                <foliageLod blockShape="0>1|5"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|18"/>
                <foliageLod blockShape="0>1|5"/>
            </foliageShape>
        </foliageState>
        <!-- 1 1 1 1 - tire tracks (harvested) -->
        <foliageState name="tireTracks" width="0.7" height="0.7" isCut="true" distanceMap="distances/foliage_greenBean_distance6_diffuse.png" isDestructedByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0>0|15"/>
                <foliageLod blockShape="0>1|5"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|16"/>
                <foliageLod blockShape="0>1|5"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|17"/>
                <foliageLod blockShape="0>1|5"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|18"/>
                <foliageLod blockShape="0>1|5"/>
            </foliageShape>
        </foliageState>
    </foliageLayer>

    <!-- chopper haulm -->
    <foliageLayer name="haulm" densityMapChannelOffset="4" numDensityMapChannels="1" numBlocksPerUnit="2.0" shapeSource="edamame/edamameHaulm.i3d">
        <foliageStateDefaults width="0.6" height="0.6" widthVariance="0" heightVariance="0" horizontalPositionVariance="0.3"/>
        <foliageLodDefaults lod="0" viewDistance="80"/>
        <foliageState distanceMapLayer="2" distanceMap="distances/foliage_greenBean_distance7_diffuse.png">
            <foliageShape>
                <foliageLod blockShape="0" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1"/>
            </foliageShape>
        </foliageState>
    </foliageLayer>

    <growth>
        <seasonal initialState="greenMiddle2">
            <period name="EARLY_SPRING">
            </period>
            <period name="MID_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
            </period>
            <period name="LATE_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
            </period>
            <period name="EARLY_SUMMER">
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenMiddle2" />
            </period>
            <period name="MID_SUMMER">
                <update startState="greenMiddle" endState="greenMiddle2" />
                <update startState="greenMiddle2" endState="greenBig" />
            </period>
            <period name="LATE_SUMMER">
                <update startState="greenMiddle2" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="EARLY_AUTUMN">
                <update startState="greenBig" endState="harvestReady" />
                <update startState="harvestReady" endState="dead" />
            </period>
            <period name="MID_AUTUMN">
                <update startState="harvestReady" endState="dead" />
            </period>
            <period name="LATE_AUTUMN"/>
            <period name="EARLY_WINTER" />
            <period name="MID_WINTER" />
            <period name="LATE_WINTER" />
        </seasonal>
	
    </growth>
</foliageType>
