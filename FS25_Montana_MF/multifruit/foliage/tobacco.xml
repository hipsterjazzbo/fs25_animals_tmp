<?xml version="1.0" encoding="utf-8"?>
<foliageType xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../shared/xml/schema/foliageType.xsd">
    <fruitType name="tobacco" shownOnMap="true" useForFieldMissions="false">
        <mapColors default="0.1650 0.0200 0.0100 1" colorBlind="0.3000 0.1000 0.2000 1"/>
        <harvest litersPerSqm="3" beeYieldBonusPercentage="0.10"/>
		<growth resetsSpray="true" growthRequiresLime="true"/>
        <soil lowDensityRequired="true" increasesDensity="true" consumesLime="true" startSprayLevel="0"/>
        <seeding directionSnapAngle="90" needsRolling="false" litersPerSqm="0.001" isAvailable="true"/>
        <cultivation isAllowed="true"/>
    </fruitType>
	
    <!-- tobacco 
    
    5 6 7 8 
    
    1 0 0 0 - invisible
    0 1 0 0 - green small
    1 1 0 0 - green middle
    0 0 1 0 - green middle1
    1 0 1 0 - green big 
    0 1 1 0 - green big1
    1 1 1 0 - harvest ready
    0 0 0 1 - dead
    1 0 0 1 - harvested (cut)
    
    -->
    <foliageLayer cellSize="8" objectMask="16711935" decalLayer="0" densityMapChannelOffset="0" numDensityMapChannels="4" numBlocksPerUnit="2.1" shapeSource="tobacco/tobacco.i3d">
        <foliageStateDefaults distanceMapLayer="1" widthVariance="0.2" heightVariance="0.3" horizontalPositionVariance="0.25" />

        <!-- default LOD distances etc -->
        <foliageLodDefaults lod="0" viewDistance="20" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1" />
        <foliageLodDefaults lod="1" viewDistance="80" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1" />
        
		<!-- 1 0 0 0 - invisible -->
        <foliageState name="1 invisible" isGrowing="true" allowsWeeding="true" allowsHoeing="true"/>
        
		<!-- 0 1 0 0 - green small -->
        <foliageState name="2 small" distanceMap="distances/foliage_soybean_distance3_diffuse.png" width="0.5" height="0.5" isGrowing="true" allowsWeeding="true" allowsHoeing="true" >
            <foliageShape>
                <foliageLod blockShape="0>0|0" numBlocksPerUnit="0.9" />
                <foliageLod blockShape="0>1|0" numBlocksPerUnit="0.9" />
            </foliageShape>
        </foliageState>
        
		<!-- 1 1 0 0 -green middle-->
        <foliageState name="3 middle" distanceMap="distances/foliage_soybean_distance3_diffuse.png" width="0.7" height="0.7" isGrowing="true" isDestructibleByWheel="true" allowsWeeding="true" allowsHoeing="true" fieldCourseLineHeight="0.5">
            <foliageShape>
                <foliageLod blockShape="0>0|1" numBlocksPerUnit="1" />
                <foliageLod blockShape="0>1|1" numBlocksPerUnit="1" />
            </foliageShape>
        </foliageState>
       
	   <!-- 1 0 1 0 - green big -->
        <foliageState name="4 big" distanceMap="distances/foliage_soybean_distance4_diffuse.png" width="1.2" height="1.2" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.7">
            <foliageShape>
                <foliageLod blockShape="0>0|2" />
                <foliageLod blockShape="0>1|2" />
            </foliageShape>
        </foliageState>
        
		<!-- 1 1 1 0 - harvest ready -->
        <foliageState name="5 ready" distanceMap="distances/foliage_soybean_distance4_diffuse.png" width="1.8" height="1.8" isGrowing="true" isHarvestReady="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" groundType="HARVEST_READY_OTHER" fieldCourseLineHeight="1">
            <foliageShape>
                <foliageLod blockShape="0>0|3" />
                <foliageLod blockShape="0>1|3" />
            </foliageShape>
        </foliageState>
        
		<!-- 0 0 0 1 - dead -->
        <foliageState name="6 dead" distanceMap="distances/foliage_soybean_distance6_diffuse.png" width="1.5" height="1.5" isWithered="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.4">
            <foliageShape>
                <foliageLod blockShape="0>0|4" />
                <foliageLod blockShape="0>1|4" />
            </foliageShape>
        </foliageState>
        
		<!-- 1 0 0 1 - harvested (cut) -->
        <foliageState name="7 cut" distanceMap="distances/foliage_soybean_distance6_diffuse.png" width="0.5" height="2" isCut="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0>0|5" />
                <foliageLod blockShape="0>1|5" />
            </foliageShape>
        </foliageState>
        
		<!-- 1 0 0 1 - harvested (cut) -->
        <foliageState name="8 tyre" distanceMap="distances/foliage_soybean_distance6_diffuse.png" width="0.5" height="0.7" isCut="false" isDestructibleByWheel="false" isDestructedByWheel="true" isDestructedByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0>0|5" />
                <foliageLod blockShape="0>1|5" />
            </foliageShape>
        </foliageState>

    </foliageLayer>
	
	<growth>
        <seasonal >
            <period name="EARLY_SPRING" plantingAllowed="true" > <!-- March -->
                <update startState="1 invisible" endState="2 small" />
                <update startState="2 small" endState="3 middle" />
            </period>
            <period name="MID_SPRING" > <!-- April -->
                <update startState="2 small" endState="3 middle" />
                <update startState="3 middle" endState="4 big" />
            </period>
            <period name="LATE_SPRING" > <!-- May -->
                <update startState="3 middle" endState="4 big" />
                <update startState="4 big" endState="5 ready" />
            </period>
            <period name="EARLY_SUMMER"> <!-- June -->
                <update startState="4 big" endState="5 ready" />
                <update startState="5 ready" endState="6 dead" />
            </period>
            <period name="MID_SUMMER"> <!-- July -->
                <update startState="5 ready" endState="6 dead" />
            </period>
            <period name="LATE_SUMMER" /> <!-- August -->
            <period name="EARLY_AUTUMN"/> <!-- September -->
            <period name="MID_AUTUMN" /> <!-- Octomber -->
            <period name="LATE_AUTUMN" /> <!-- November -->
            <period name="EARLY_WINTER" /> <!-- December -->
            <period name="MID_WINTER" /> <!-- January -->
            <period name="LATE_WINTER" plantingAllowed="true" > <!-- February -->
                <update startState="1 invisible" endState="2 small" />
            </period>
        </seasonal>

    </growth>
	
</foliageType>
