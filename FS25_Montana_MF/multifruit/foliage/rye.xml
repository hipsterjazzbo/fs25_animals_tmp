<?xml version="1.0" encoding="utf-8"?>
<foliageType xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../shared/xml/schema/foliageType.xsd">
    <fruitType name="rye" shownOnMap="true" useForFieldMissions="true">
        <mapColors default="0.6510 0.5210 0.3970 1" colorBlind="0.5000 0.5500 0.6000 1"/>
		<windrow fillType="straw" litersPerSqm="3.68" cutFillType="RYE_CUT" windrowCutFactor="1.25"/>
        <harvest litersPerSqm="0.9" cutHeight="0.15" chopperType="CHOPPER_STRAW"/>
        <growth resetsSpray="true" growthRequiresLime="true"/>
        <soil lowDensityRequired="true" increasesDensity="false" consumesLime="true" startSprayLevel="0"/>
        <seeding directionSnapAngle="0" needsRolling="true" litersPerSqm="0.034" isAvailable="true"/>
        <cultivation isAllowed="true"/>
        <mulcher chopperType="CHOPPER_STRAW"/>
    </fruitType>
    <!-- rye

    0 1 2 3

    1 0 0 0 - invisible
    0 1 0 0 - green small
    1 1 0 0 - green small 2
    0 0 1 0 - green middle
    1 0 1 0 - green big
    0 1 1 0 - green big 2
    1 1 1 0 - harvest ready
    0 0 0 1 - dead
    1 0 0 1 - harvested (cut)

    -->
    <foliageLayer cellSize="8" objectMask="16711935" decalLayer="0" densityMapChannelOffset="0" numDensityMapChannels="4" numBlocksPerUnit="3.5" shapeSource="rye/rye.i3d">
        <foliageStateDefaults distanceMapLayer="1" width="1.0" height="1" widthVariance="0.2" heightVariance="0.2" horizontalPositionVariance="0.5" />
        <!-- default LOD distances etc -->
        <foliageLodDefaults lod="0" viewDistance="18" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1" />
        <foliageLodDefaults lod="1" viewDistance="80" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1" />
        
<!-- 1 0 0 0 - invisible -->
        <foliageState name="1 invisible" isGrowing="true" allowsWeeding="true" allowsHoeing="true"/>
        
<!-- 0 1 0 0 - green small -->
        <foliageState name="2 small" distanceMap="distances/foliage_wheat_distance2_diffuse.png" isGrowing="true" allowsWeeding="true" allowsHoeing="true" fieldCourseLineHeight="0.3">
            <foliageShape>
                <foliageLod blockShape="0>0|0" numBlocksPerUnit="3.5" />
                <foliageLod blockShape="0>1|0" numBlocksPerUnit="3.5"  />
            </foliageShape>
        </foliageState>
        
<!-- 0 1 0 0 - green small 2 -->
        <foliageState name="3 small 2" distanceMap="distances/foliage_wheat_distance2_diffuse.png" isGrowing="true" allowsWeeding="true" allowsHoeing="true" fieldCourseLineHeight="0.3">
            <foliageShape>
                <foliageLod blockShape="0>0|0" numBlocksPerUnit="3.5" />
                <foliageLod blockShape="0>1|0" numBlocksPerUnit="3.5"  />
            </foliageShape>
        </foliageState>        
        
<!-- 0 0 1 0 - green middle -->
        <foliageState name="4 middle" distanceMap="distances/foliage_wheat_distance3_diffuse.png" isGrowing="true" allowsWeeding="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.5">
            <foliageShape>
                <foliageLod blockShape="0>0|1" />
                <foliageLod blockShape="0>1|1" />
            </foliageShape>
        </foliageState>     
        
<!-- 0 0 1 0 - green middle 2 -->
        <foliageState name="5 middle 2" distanceMap="distances/foliage_wheat_distance3_diffuse.png" isGrowing="true" allowsWeeding="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.5">
            <foliageShape>
                <foliageLod blockShape="0>0|1" />
                <foliageLod blockShape="0>1|1" />
            </foliageShape>
        </foliageState>
        
<!-- 1 0 1 0 - green big -->
        <foliageState name="6 big" distanceMap="distances/foliage_wheat_distance4_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.85">
            <foliageShape>
                <foliageLod blockShape="0>0|2" />
                <foliageLod blockShape="0>1|2" />
            </foliageShape>
        </foliageState>
        
<!-- 1 0 1 0 - green big 2 -->
        <foliageState name="7 big 2" distanceMap="distances/foliage_wheat_distance4_diffuse.png" isGrowing="true" isForageReady="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.85">
            <foliageShape>
                <foliageLod blockShape="0>0|2" />
                <foliageLod blockShape="0>1|2" />
            </foliageShape>
        </foliageState>
        
<!-- 1 1 1 0 - harvest ready -->
        <foliageState name="8 ready" numBlocksPerUnit="3.5" width="1.3" distanceMap="distances/foliage_wheat_distance5_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" isHarvestReady="true" groundType="HARVEST_READY" fieldCourseLineHeight="1">
            <foliageShape>
                <foliageLod blockShape="0>0|3" />
                <foliageLod blockShape="0>1|3" />
            </foliageShape>
        </foliageState>
        
<!-- 0 0 0 1 - dead -->
        <foliageState name="9 dead" distanceMap="distances/foliage_wheat_distance6_diffuse.png" isWithered="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.85">
            <foliageShape>
                <foliageLod blockShape="0>0|4" />
                <foliageLod blockShape="0>1|4" />
            </foliageShape>
        </foliageState>
        
<!-- 1 0 0 1 - harvested (cut) -->
        <foliageState name="10 cut" distanceMap="distances/foliage_wheat_distance7_diffuse.png" numBlocksPerUnit="3.5" height="1.5" width="1.5" isCut="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0>0|5" />
                <foliageLod blockShape="0>1|5" />
            </foliageShape>
        </foliageState>
        <!--  -->
        
<!-- 1 0 0 1 - TireTracks -->
        <foliageState name="11 tyre" distanceMap="distances/foliage_wheat_distance7_diffuse.png" numBlocksPerUnit="3" height="0.5" width="0.5" isCut="false" isDestructibleByWheel="false" isDestructedByWheel="true" isDestructedByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0>0|5" />
                <foliageLod blockShape="0>1|5" />
            </foliageShape>
        </foliageState>
    </foliageLayer>

 <growth>
        <seasonal initialState="8 ready">
            <period name="EARLY_SPRING"/>
            <period name="MID_SPRING">
                <update startState="3 small 2" endState="4 middle" />
                <update startState="4 middle" endState="5 middle 2" />
            </period>
            <period name="LATE_SPRING">
                <update startState="4 middle" endState="5 middle 2" />
                <update startState="5 middle 2" endState="6 big" />
            </period>
            <period name="EARLY_SUMMER">
                <update startState="5 middle 2" endState="6 big" />
                <update startState="6 big" endState="7 big 2" />
            </period>
            <period name="MID_SUMMER">
                <update startState="6 big" endState="7 big 2" />
                <update startState="7 big 2" endState="8 ready" />
            </period>
            <period name="LATE_SUMMER">
                <update startState="7 big 2" endState="8 ready" />
            </period>
            <period name="EARLY_AUTUMN">
                <update startState="8 ready" endState="9 dead" />
            </period>
            <period name="MID_AUTUMN" plantingAllowed="true">
                <update startState="1 invisible" endState="2 small" />
            </period>
            <period name="LATE_AUTUMN" plantingAllowed="true">
                <update startState="1 invisible" endState="2 small" />
                <update startState="2 small" endState="3 small 2" />
            </period>
            <period name="EARLY_WINTER" />
            <period name="MID_WINTER" />
            <period name="LATE_WINTER">
                <update startState="2 small" endState="3 small 2" />
                <update startState="3 small 2" endState="4 middle" />
            </period>
        </seasonal>

    </growth>
	
</foliageType>