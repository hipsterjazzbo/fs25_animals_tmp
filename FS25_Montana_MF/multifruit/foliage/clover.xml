<?xml version="1.0" encoding="utf-8"?>
<foliageType xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../shared/xml/schema/foliageType.xsd">
    <fruitType name="clover" shownOnMap="true" useForFieldJob="true">
        <mapColors default="0.2500 0.5000 0.2500 1" colorBlind="0.5500 0.4000 0.4000 1"/>
        <harvest litersPerSqm="3" groundType="GRASS_CUT" beeYieldBonusPercentage="0.10"/>
        <windrow fillType="clover_windrow" />
        <growth resetsSpray="true" growthRequiresLime="false"/>
        <soil lowDensityRequired="false" increasesDensity="false" consumesLime="false" startSprayLevel="1"/>
        <seeding directionSnapAngle="0" litersPerSqm="0.022" isAvailable="true" plantsWeed="false"/>
        <cultivation isAllowed="true"/>
    </fruitType>
    
    <!-- clover

    0 1 2 3

    1 0 0 0 - invisible
    0 1 0 0 - green small
    1 1 0 0 - green middle
    0 0 1 0 - harvest ready
    1 0 1 0 - cut
    0 1 1 0 - cut 2

    -->

    <foliageLayer cellSize="8" objectMask="16711935" decalLayer="0" densityMapChannelOffset="0" numDensityMapChannels="4" numBlocksPerUnit="4" shapeSource="clover/clover.i3d">
        <foliageStateDefaults distanceMapLayer="1" widthVariance="0.5" heightVariance="0.5" horizontalPositionVariance="0.5" />
       
 <!-- default LOD distances etc -->
        <foliageLodDefaults lod="0" viewDistance="25" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1" />
        <foliageLodDefaults lod="1" viewDistance="120" blendOutDistance="5" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1" />
        
<!-- 1 0 0 0 - invisible -->
        <foliageState name="1 invisible" isGrowing="true"/>
        
<!-- 0 1 0 0 - green small -->
        <foliageState name="2 small" width="0.25" height="0.25" distanceMap="distances/foliage_grass_distance2_diffuse.png" isGrowing="true" regrowthStart="true" groundType="GRASS" groundTypeMask="GRASS GRASS_CUT SOWN DIRECT_SOWN ROLLER_LINES" isDestructibleByDisaster="true" >
            <foliageShape>
                <foliageLod blockShape="0>0" />
                <foliageLod blockShape="1>0" />
            </foliageShape>
        </foliageState>
        
<!-- 1 1 0 0 - green middle -->
        <foliageState name="3 middle" width="0.4" height="0.4" distanceMap="distances/foliage_grass_distance3_diffuse.png" isGrowing="true" yieldScale="0.5" isDestructibleByWheel="false" isDestructibleByDisaster="true" fieldCourseLineHeight="0.5">
            <foliageShape>
                <foliageLod blockShape="0>1" />
                <foliageLod blockShape="1>1" />
            </foliageShape>
        </foliageState>

<!-- 1 1 0 0 - green big -->
        <foliageState name="4 big" width="0.6" height="0.6" distanceMap="distances/foliage_grass_distance3_diffuse.png" isGrowing="true" isHarvestReady="true" yieldScale="0.75" isDestructibleByWheel="false" isDestructibleByDisaster="true" fieldCourseLineHeight="0.85">
            <foliageShape>
                <foliageLod blockShape="0>2" />
                <foliageLod blockShape="1>2" />
            </foliageShape>
        </foliageState>
       
<!-- 0 0 1 0 - harvest ready -->
        <foliageState name="5 ready" width="0.8" height="0.8" distanceMap="distances/foliage_grass_distance4_diffuse.png" isGrowing="true" isDestructibleByWheel="false" isDestructibleByDisaster="true" isHarvestReady="true" fieldCourseLineHeight="1">
            <foliageShape>
                <foliageLod blockShape="0>3" />
                <foliageLod blockShape="1>3" />
            </foliageShape>
        </foliageState>
   
<!-- 1 0 1 0 - cut -->
        <foliageState name="6 cut" numBlocksPerUnit="6" width="0.7" height="0.5" distanceMap="distances/foliage_grass_distance5_diffuse.png" isCut="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" isMulched="true">
            <foliageShape>
                <foliageLod blockShape="0>5" />
                <foliageLod blockShape="1>5" />
            </foliageShape>
        </foliageState>

<!-- 0 1 1 0 - cut rolled -->
        <foliageState name="7 rolled" numBlocksPerUnit="4" width="0.3" height="0.2" distanceMap="distances/foliage_grass_distance5_diffuse.png" isRolledCut="true">
            <foliageShape>
                <foliageLod blockShape="0>5" />
                <foliageLod blockShape="1>5" />
            </foliageShape>
        </foliageState> 

<!-- 0 1 1 0 - tire tracks -->
        <foliageState name="8 tire" numBlocksPerUnit="2" width="0.2" height="0.2" distanceMap="distances/foliage_grass_distance5_diffuse.png" isDestructibleByWheel="false" isDestructedByWheel="true" isDestructedByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0>5" />
                <foliageLod blockShape="1>5" />
            </foliageShape>
        </foliageState>
 
</foliageLayer>

    
<!-- Small Green small Green big Harvest ready -->

 	<growth>
        <seasonal initialState="3 middle">
            <period name="EARLY_SPRING" plantingAllowed="false"> <!-- March -->
                <update startState="2 small" endState="3 middle" />
                <update startState="6 cut" endState="2 small" />
                <update startState="7 rolled" endState="2 small" />
                <update startState="8 tire" endState="2 small" />
            </period>
            <period name="MID_SPRING" plantingAllowed="true"> <!-- April -->
		<update startState="1 invisible" endState="2 small" />
		<update startState="2 small" endState="3 middle" />
		<update startState="3 middle" endState="4 big" />
		<update startState="6 cut" endState="2 small" />
		<update startState="7 rolled" endState="2 small" />
                <update startState="8 tire" endState="2 small" />
            </period>
            <period name="LATE_SPRING" plantingAllowed="true"> <!-- May -->
                <update startState="1 invisible" endState="2 small" />
                <update startState="2 small" endState="3 middle" />
                <update startState="3 middle" endState="4 big" />
                <update startState="4 big" endState="5 ready" />
                <update startState="6 cut" endState="2 small" />
                <update startState="7 rolled" endState="2 small" />
                <update startState="8 tire" endState="2 small" />
            </period>
            <period name="EARLY_SUMMER" plantingAllowed="true"> <!-- June -->
                <update startState="1 invisible" endState="2 small" />
                <update startState="2 small" endState="3 middle" />
                <update startState="3 middle" endState="4 big" />
                <update startState="4 big" endState="5 ready" />
                <update startState="6 cut" endState="2 small" />
                <update startState="7 rolled" endState="2 small" />
                <update startState="8 tire" endState="2 small" />
            </period>
            <period name="MID_SUMMER" plantingAllowed="false"> <!-- July -->
                <update startState="2 small" endState="3 middle" />
                <update startState="3 middle" endState="4 big" />
                <update startState="4 big" endState="5 ready" />
                <update startState="6 cut" endState="2 small" />
                <update startState="7 rolled" endState="2 small" />
                <update startState="8 tire" endState="2 small" />
            </period>
            <period name="LATE_SUMMER" plantingAllowed="false"> <!-- August -->
                <update startState="2 small" endState="3 middle" />
                <update startState="3 middle" endState="4 big" />
                <update startState="4 big" endState="5 ready" />
                <update startState="6 cut" endState="2 small" />
                <update startState="7 rolled" endState="2 small" />
                <update startState="8 tire" endState="2 small" />
            </period>
            <period name="EARLY_AUTUMN" plantingAllowed="true"> <!-- September -->
		<update startState="1 invisible" endState="2 small" />
                <update startState="2 small" endState="3 middle" />
                <update startState="3 middle" endState="4 big" />				
                <update startState="4 big" endState="5 ready" />				
                <update startState="5 ready" endState="2 small" />
                <update startState="6 cut" endState="2 small" />
                <update startState="7 rolled" endState="2 small" />
                <update startState="8 tire" endState="2 small" />
            </period>
            <period name="MID_AUTUMN" plantingAllowed="false"> <!-- October -->
                <update startState="3 middle" endState="2 small" />
                <update startState="4 big" endState="2 small" />				
                <update startState="5 ready" endState="2 small" />
                <update startState="6 cut" endState="2 small" />
                <update startState="7 rolled" endState="2 small" />
                <update startState="8 tire" endState="2 small" />
            </period>
            <period name="LATE_AUTUMN" plantingAllowed="false"> <!-- November -->
                <!-- Completely knocked back for winter -->
            </period>
            <period name="EARLY_WINTER" plantingAllowed="false"> <!-- December -->
			   <!-- Dormant, no growth -->
            </period>
            <period name="MID_WINTER" plantingAllowed="false"> <!-- January -->
                <!-- Dormant, no growth -->
            </period>
            <period name="LATE_WINTER" plantingAllowed="false"> <!-- February -->
                <!-- Dormant, no growth -->
            </period>
        </seasonal>

        <nonSeasonal>
            <update startState="1 invisible"        	endState="2 small" />
            <update startState="2 small"      		endState="3 middle" />
            <update startState="3 middle"  		endState="4 big" />
            <update startState="4 big"  		endState="5 ready" />
            <update startState="6 cut"     		endState="2 small" />
            <update startState="7 rolled" 		endState="2 small" />
            <update startState="8 tire" 		endState="2 small" />
        </nonSeasonal>
    </growth>
</foliageType>