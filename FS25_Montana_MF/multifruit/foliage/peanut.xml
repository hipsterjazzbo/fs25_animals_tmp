<?xml version="1.0" encoding="utf-8"?>
<foliageType xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../shared/xml/schema/foliageType.xsd">
    <fruitType name="peanut" shownOnMap="true" useForFieldMissions="true">
        <mapColors default="0.3993 0.2011 0.0278 1" colorBlind="0.5500 0.4500 0.2500 1"/>
        <harvest litersPerSqm="5" beeYieldBonusPercentage="0.10"/>
        <growth resetsSpray="true" growthRequiresLime="true"/>
        <soil lowDensityRequired="true" increasesDensity="true" consumesLime="true" startSprayLevel="0"/>
        <seeding directionSnapAngle="0" needsRolling="true" litersPerSqm="0.0034" isAvailable="true"/>
        <cultivation isAllowed="true"/>
        <haulm layerName="peanut_haulm"/>
    </fruitType>

    <!-- peanut

    0 1 2 3

    1 0 0 0 - invisible
    0 1 0 0 - green small
    1 1 0 0 - green small 2
    0 0 1 0 - green middle
    1 0 1 0 - green middle 2
    0 1 1 0 - green big
    1 1 1 0 - green big 2
    0 0 0 1 - harvest ready
    1 0 0 1 - dead
    0 1 0 1 - harvested (extructed)
    1 1 0 1 - cut haulm (not extructed)

    -->
    <foliageLayer cellSize="8" objectMask="16711935" decalLayer="0" densityMapChannelOffset="0" numDensityMapChannels="4" numBlocksPerUnit="0.5" shapeSource="peanut/peanut.i3d">
        <foliageStateDefaults distanceMapLayer="1" width="1.5" height="1" widthVariance="0" heightVariance="0.15" horizontalPositionVariance="0"/>
        <!-- default LOD distances etc -->
        <foliageLodDefaults lod="0" viewDistance="100" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1" />
        <foliageLodDefaults lod="1" viewDistance="80" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1" />
        
		<!-- 1 0 0 0 - invisible -->
        <foliageState name="1 invisible" isGrowing="true" allowsWeeding="true" allowsHoeing="true"/>
        
		<!-- 0 1 0 0 - green small -->
        <foliageState name="2 small" width="2.5" height="2" numBlocksPerUnit="2" distanceMap="distances/foliage_peanut_distance2_diffuse.png" isGrowing="true" allowsWeeding="true" allowsHoeing="true" fieldCourseLineHeight="0.2">
            <foliageShape>
                <foliageLod blockShape="0>0|0" />
                <foliageLod blockShape="0>1|0" />
            </foliageShape>
        </foliageState>
        
		<!-- 0 0 1 0 - green middle -->
        <foliageState name="3 middle" distanceMap="distances/foliage_peanut_distance3_diffuse.png" isGrowing="true" allowsHoeing="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.3">
            <foliageShape>
                <foliageLod blockShape="0>0|1" />
                <foliageLod blockShape="0>1|1" />
            </foliageShape>
        </foliageState>
        
		<!-- 0 1 1 0 - green big -->
        <foliageState name="4 big" distanceMap="distances/foliage_peanut_distance4_diffuse.png" isGrowing="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.4">
            <foliageShape>
                <foliageLod blockShape="0>0|2" />
                <foliageLod blockShape="0>1|2" />
            </foliageShape>
        </foliageState>
        
		<!-- 0 0 0 1 - harvest ready -->
        <foliageState name="5 ready" distanceMap="distances/foliage_peanut_distance5_diffuse.png" isGrowing="true" isDestructibleByDisaster="true" isPreparable="true" groundType="HARVEST_READY_OTHER" fieldCourseLineHeight="0.45">
            <foliageShape>
                <foliageLod blockShape="0>0|3" />

                <foliageLod blockShape="0>1|3" />
            </foliageShape>
        </foliageState>
        
		<!-- 1 0 0 1 - dead -->
        <foliageState name="6 dead" distanceMap="distances/foliage_peanut_distance6_diffuse.png" isWithered="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.3">
            <foliageShape>
                <foliageLod blockShape="0>0|4" />
                <foliageLod blockShape="0>1|4" />
            </foliageShape>
        </foliageState>
        
		<!-- 0 1 0 1 - harvested -->
        <foliageState name="7 cut" isCut="true" isDestructibleByDisaster="true" isDestructedByWheel="true"/>

		<!-- 1 1 0 1 - cut haulm -->
        <foliageState name="cut haulm" isDestructibleByDisaster="true" isHarvestReady="true" isPrepared="true" />
    </foliageLayer>
    
	<!-- peanut haulm -->
    <foliageLayer name="haulm" densityMapChannelOffset="4" numDensityMapChannels="1" numBlocksPerUnit="1.6" shapeSource="peanut/peanutHaulm.i3d">
        <foliageStateDefaults width="0.85" height="1" widthVariance="0.2" heightVariance="0" horizontalPositionVariance="0.1"/>
        <foliageLodDefaults lod="0" viewDistance="80"/>
        <foliageState distanceMapLayer="2" distanceMap="distances/foliage_peanut_distance2_diffuse.png">
            <foliageShape>
                <foliageLod lod="0" blockShape="0" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1" />
            </foliageShape>
        </foliageState>
    </foliageLayer>
	
	<growth>
        <seasonal initialState="4 big">
            <period name="EARLY_SPRING" plantingAllowed="true"> <!-- March -->
                <update startState="1 invisible" endState="2 small" />
            </period>
            <period name="MID_SPRING" plantingAllowed="true"> <!-- April -->
                <update startState="1 invisible" endState="2 small" />
                <update startState="2 small" endState="3 middle" />
            </period>
            <period name="LATE_SPRING"> <!-- May -->
                <update startState="2 small" endState="3 middle" />
                <update startState="3 middle" endState="4 big" />
            </period>
            <period name="EARLY_SUMMER"> <!-- June -->
                <update startState="3 middle" endState="4 big" />
                <update startState="4 big" endState="5 ready" />
            </period>
            <period name="MID_SUMMER"> <!-- July -->
                <update startState="4 big" endState="5 ready" />
                <update startState="5 ready" endState="6 dead" />
            </period> 
            <period name="LATE_SUMMER"> <!-- August -->
                <update startState="5 ready" endState="6 dead" />
            </period>
            <period name="EARLY_AUTUMN" /> <!-- September -->
            <period name="MID_AUTUMN" /> <!-- Octomber -->
            <period name="LATE_AUTUMN" /> <!-- November -->
            <period name="EARLY_WINTER" /> <!-- December -->
            <period name="MID_WINTER" /> <!-- January -->
            <period name="LATE_WINTER" /> <!-- February -->
        </seasonal>
    </growth>
	
</foliageType>
