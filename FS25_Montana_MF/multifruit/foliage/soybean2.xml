<?xml version="1.0" encoding="utf-8"?>
<foliageType xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../shared/xml/schema/foliageType.xsd">
    <fruitType name="soybean2" shownOnMap="true" useForFieldMissions="true">
        <mapColors default="0.3600 0.4200 0.1200 1" colorBlind="0.5200 0.4600 0.1800 1"/>
        <harvest litersPerSqm="0.2177" cutHeight="0.20" chopperType="CHOPPER_STRAW" forageCutHeight="0.15"/>
        <growth resetsSpray="true" growthRequiresLime="true"/>
        <soil lowDensityRequired="true" increasesDensity="false" consumesLime="true" startSprayLevel="0"/>
        <seeding directionSnapAngle="0" needsRolling="true" litersPerSqm="0.007722" isAvailable="true"/>
        <cultivation isAllowed="true"/>
        <mulcher chopperType="CHOPPER_STRAW"/>
    </fruitType>

    <foliageLayer densityMapChannelOffset="0" numDensityMapChannels="4" numBlocksPerUnit="1.333" shapeSource="soybean2/soybean.i3d" alignsToSun="false">
        <foliageStateDefaults distanceMapLayer="1" width="1.0" height="1.0" widthVariance="0.3" heightVariance="0.2" horizontalPositionVariance="0.05"/>
        <!-- default LOD distances etc -->
        <foliageLodDefaults lod="0" viewDistance="18" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1"/>
        <foliageLodDefaults lod="1" viewDistance="80" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1"/>
        
		<!-- 1 0 0 0 - invisible -->
        <foliageState name="1 invisible" isGrowing="true" allowsWeeding="true" allowsHoeing="true"/>
        
		<!-- 0 1 0 0 - green small -->
        <foliageState name="2 small" distanceMap="distances/foliage_soybean_distance2_diffuse.png" isGrowing="true" allowsWeeding="true" allowsHoeing="true" fieldCourseLineHeight="0.25">
            <foliageShape>
                <foliageLod blockShape="0>0|0"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|1"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|2"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
        </foliageState>
        
		<!-- 1 1 0 0 - green middle -->
        <foliageState name="3 middle" distanceMap="distances/foliage_soybean_distance3_diffuse.png" isGrowing="true" allowsWeeding="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.5">
            <foliageShape>
                <foliageLod blockShape="0>0|3"/>
                <foliageLod blockShape="0>1|1"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|4"/>
                <foliageLod blockShape="0>1|1"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|5"/>
                <foliageLod blockShape="0>1|1"/>
            </foliageShape>
        </foliageState>
        
		<!-- 1 0 1 0 - green big -->
        <foliageState name="4 big" distanceMap="distances/foliage_soybean_distance4_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.85">
            <foliageShape>
                <foliageLod blockShape="0>0|6"/>
                <foliageLod blockShape="0>1|2"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|7"/>
                <foliageLod blockShape="0>1|2"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|8"/>
                <foliageLod blockShape="0>1|2"/>
            </foliageShape>
        </foliageState>
        
        <!-- 1 1 1 0 - harvest ready -->
        <foliageState name="5 ready" width="1.3" distanceMap="distances/foliage_soybean2_distance5_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" isHarvestReady="true" groundType="HARVEST_READY" fieldCourseLineHeight="0.85">
            <foliageShape>
                <foliageLod blockShape="0>0|9"/>
                <foliageLod blockShape="0>1|3"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|10"/>
                <foliageLod blockShape="0>1|3"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|11"/>
                <foliageLod blockShape="0>1|3"/>
            </foliageShape>
        </foliageState>
        
		<!-- 0 0 0 1 - dead -->
        <foliageState name="6 dead" distanceMap="distances/foliage_soybean_distance6_diffuse.png" isWithered="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.5">
            <foliageShape>
                <foliageLod blockShape="0>0|12"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|13"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|14"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
        </foliageState>
        
		<!-- 1 0 0 1 - harvested (cut) -->
        <foliageState name="7 cut" numBlocksPerUnit="2" isCut="true" distanceMap="distances/foliage_soybean_distance6_diffuse.png" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0>0|19"/>
                <foliageLod blockShape="0>1|6"/>
            </foliageShape>
            <!-- <foliageShape> -->
                <!-- <foliageLod blockShape="0>0|15"/> -->
                <!-- <foliageLod blockShape="0>1|5"/> -->
            <!-- </foliageShape> -->
            <!-- <foliageShape> -->
                <!-- <foliageLod blockShape="0>0|16"/> -->
                <!-- <foliageLod blockShape="0>1|5"/> -->
            <!-- </foliageShape> -->
            <!-- <foliageShape> -->
                <!-- <foliageLod blockShape="0>0|17"/> -->
                <!-- <foliageLod blockShape="0>1|5"/> -->
            <!-- </foliageShape> -->
            <!-- <foliageShape> -->
                <!-- <foliageLod blockShape="0>0|18"/> -->
                <!-- <foliageLod blockShape="0>1|5"/> -->
            <!-- </foliageShape> -->
        </foliageState>
        
		<!-- 1 0 0 1 - TireTracks -->
        <foliageState name="8 tyre" numBlocksPerUnit="2" width="0.3" height="0.3" distanceMap="distances/foliage_soybean_distance6_diffuse.png" isCut="false" isDestructibleByWheel="false" isDestructedByWheel="true" isDestructedByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0>0|19"/>
                <foliageLod blockShape="0>1|6"/>
            </foliageShape>
            <!-- <foliageShape> -->
                <!-- <foliageLod blockShape="0>0|15"/> -->
                <!-- <foliageLod blockShape="0>1|5"/> -->
            <!-- </foliageShape> -->
            <!-- <foliageShape> -->
                <!-- <foliageLod blockShape="0>0|16"/> -->
                <!-- <foliageLod blockShape="0>1|5"/> -->
            <!-- </foliageShape> -->
            <!-- <foliageShape> -->
                <!-- <foliageLod blockShape="0>0|17"/> -->
                <!-- <foliageLod blockShape="0>1|5"/> -->
            <!-- </foliageShape> -->
            <!-- <foliageShape> -->
                <!-- <foliageLod blockShape="0>0|18"/> -->
                <!-- <foliageLod blockShape="0>1|5"/> -->
            <!-- </foliageShape> -->
        </foliageState>
        
    </foliageLayer>

<growth>
        <seasonal initialState="4 big">
            <period name="EARLY_SPRING"/> <!-- March -->
            <period name="MID_SPRING" /> <!-- April -->
            <period name="LATE_SPRING" plantingAllowed="true"> <!-- May -->
                <update startState="1 invisible" endState="2 small" />
            </period>
            <period name="EARLY_SUMMER" plantingAllowed="true" > <!-- June -->
                <update startState="1 invisible" endState="2 small" />
                <update startState="2 small" endState="3 middle" />
            </period>
            <period name="MID_SUMMER"> <!-- July -->
                <update startState="2 small" endState="3 middle" />
                <update startState="3 middle" endState="4 big" />
            </period>
            <period name="LATE_SUMMER"> <!-- August -->
                <update startState="3 middle" endState="4 big" />
                <update startState="4 big" endState="5 ready" />
            </period>
            <period name="EARLY_AUTUMN"> <!-- September -->
                <update startState="4 big" endState="5 ready" />
                <update startState="5 ready" endState="6 dead" />
            </period>
            <period name="MID_AUTUMN"> <!-- Octomber -->
                <update startState="5 ready" endState="6 dead" />
            </period>
            <period name="LATE_AUTUMN" /> <!-- November -->
            <period name="EARLY_WINTER" /> <!-- December -->
            <period name="MID_WINTER" /> <!-- January -->
            <period name="LATE_WINTER" /> <!-- February -->
        </seasonal>
    </growth>

</foliageType>
