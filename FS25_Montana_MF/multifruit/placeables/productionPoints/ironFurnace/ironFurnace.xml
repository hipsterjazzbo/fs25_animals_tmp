<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/placeable.xsd">
    <storeData>
        <name>$l10n_storeItem_ironFurnace</name>
        <functions>
            <function>$l10n_function_productionPoint</function>
        </functions>
        <image>multifruit/placeables/productionPoints/ironFurnace/textures/store_ironFurnace.png</image>
        <price>280000</price>
        <dailyUpkeep>150</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>JINKOU</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>factories</tab>
        </brush>
        <vertexBufferMemoryUsage>697088</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>148480</indexBufferMemoryUsage>
        <textureMemoryUsage>6356992</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <filename>multifruit/placeables/productionPoints/ironFurnace/ironFurnace.i3d</filename>
	<boughtWithFarmland>false</boughtWithFarmland>
	<canBeDeleted>true</canBeDeleted>
	<canBeRenamed>true</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>

        <sounds>
            <place template="smallImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30" >
        <levelAreas>
            <levelArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01" groundType="asphalt"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01" />
        <indoorArea startNode="indoorAreaStart02" widthNode="indoorAreaWidth02" heightNode="indoorAreaHeight02" />
        <indoorArea startNode="indoorAreaStart03" widthNode="indoorAreaWidth03" heightNode="indoorAreaHeight03" />
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
        <splines>
            <spline node="aiSpline" />
        </splines>
    </ai>

    <infoTrigger triggerNode="infoTrigger"/>

    <dynamicallyLoadedParts>
        <dynamicallyLoadedPart filename="multifruit/placeables/productionPoints/ironFurnace/textures/props.i3d" node="0" linkNode="propsLinkNode" />
    </dynamicallyLoadedParts>

    <lights>
        <group weatherRequiredFlags="NIGHT" />

        <lightShape node="interior" groupIndex="1"/>

        <realLights>
            <high>
                <light node="interior" groupIndex="1"/>
            </high>
        </realLights>
    </lights>

    <productionPoint>
        <productions>
            <production id="metal" name="%s" params="$l10n_fillType_metal" cyclesPerHour="3" costsPerActiveHour="5">
                <inputs>
                    <input fillType="IRONORE" amount="516" />
                </inputs>
                <outputs>
                    <output fillType="METAL" amount="480" />
                </outputs>
            </production>
        </productions>

        <effectNodes>
            <effectNode effectClass="ParticleEffect" effectNode="smokeEffectChimneyShape01" particleType="SMOKE_CHIMNEY" emitCountScale="0.5"/>
            <effectNode effectClass="ParticleEffect" effectNode="smokeEffectChimneyShape02" particleType="SMOKE_CHIMNEY" emitCountScale="0.5"/>
            <effectNode effectClass="ParticleEffect" effectNode="smokeEffectShape01"        particleType="SMOKE" scale="0.1 0.5 0.1"/>
        </effectNodes>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <capacity fillType="IRONORE" capacity="160000" />
            <capacity fillType="METAL"   capacity="50000" />
        </storage>

        <sellingStation node="sellingStation" supportsExtension="false">
            <unloadTrigger exactFillRootNode="unloadTrigger" aiNode="aiUnloadingNode" fillTypes="IRONORE" />

        <animationNodes>
            <animationNode class="ScrollingAnimation" node="conveyorBelt" rotSpeed="-20" rotAxis="1" shaderComponentScale="-1 0 0 0" scrollSpeed="-1" shaderParameterName="offsetUV"/>
        </animationNodes>
        <effectNodes>
            <effectNode effectClass="MorphPositionEffect" effectNode="effectBelt" materialType="belt" delay="0" fadeTime="2" speed="0.9" scrollLength="9" scrollSpeed="0.8" />
        </effectNodes>
        </sellingStation>

        <palletSpawner>
            <spawnPlaces>
                <spawnPlace startNode="palletAreaStart01" endNode="palletAreaEnd01"/>
                <spawnPlace startNode="palletAreaStart02" endNode="palletAreaEnd02"/>
            </spawnPlaces>
        </palletSpawner>

        <playerTrigger node="playerTrigger" />

    <sounds>
        <idle   file="multifruit/placeables/productionPoints/ironFurnace/textures/sounds/ironFurnaceIdle.wav" linkNode="0>" loops="0" volumeScale="2.3" innerRadius="7" outerRadius="50" supportsReverb="false"/>
        <active file="multifruit/placeables/productionPoints/ironFurnace/textures/sounds/ironFurnaceWork.wav" linkNode="0>" loops="0" volumeScale="1.8" innerRadius="7" outerRadius="40" supportsReverb="false"/>
    </sounds>
    </productionPoint>

    <triggerMarkers>
        <triggerMarker node="warningStripes01"/>
        <triggerMarker node="warningStripes02"/>
        <triggerMarker node="playerTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconWrench.i3d" />
        <triggerMarker node="unloadTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconUnload.i3d" />
    </triggerMarkers>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker" teleportNode="unloadTriggerMarker" />
    </hotspots>

    <i3dMappings>
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="testAreaStart01" node="0>1|0" />
        <i3dMapping id="testAreaEnd01" node="0>1|0|0" />
        <i3dMapping id="indoorAreaStart01" node="0>2|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>2|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>2|0|1" />
        <i3dMapping id="indoorAreaStart02" node="0>2|1" />
        <i3dMapping id="indoorAreaWidth02" node="0>2|1|0" />
        <i3dMapping id="indoorAreaHeight02" node="0>2|1|1" />
        <i3dMapping id="indoorAreaStart03" node="0>2|2" />
        <i3dMapping id="indoorAreaWidth03" node="0>2|2|0" />
        <i3dMapping id="indoorAreaHeight03" node="0>2|2|1" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>3|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>3|0|0" />
        <i3dMapping id="sellingStation" node="0>4" />
        <i3dMapping id="unloadTrigger" node="0>4|0" />
        <i3dMapping id="unloadTriggerMarker" node="0>4|1" />
        <i3dMapping id="warningStripes02" node="0>4|2|0" />
        <i3dMapping id="aiUnloadingNode" node="0>4|3" />
        <i3dMapping id="aiSpline" node="0>4|3|0" />
        <i3dMapping id="playerTrigger" node="0>5|0" />
        <i3dMapping id="playerTriggerMarker" node="0>5|1" />
        <i3dMapping id="smokeEffectShape01" node="0>5|2|0" />
        <i3dMapping id="smokeEffectChimneyShape01" node="0>5|2|1" />
        <i3dMapping id="smokeEffectChimneyShape02" node="0>5|2|2" />
        <i3dMapping id="effectBelt" node="0>5|3|0" />
        <i3dMapping id="palletSpawner" node="0>5|4" />
        <i3dMapping id="palletAreaStart01" node="0>5|4|0" />
        <i3dMapping id="palletAreaEnd01" node="0>5|4|0|0" />
        <i3dMapping id="palletAreaStart02" node="0>5|4|1" />
        <i3dMapping id="palletAreaEnd02" node="0>5|4|1|0" />
        <i3dMapping id="warningStripes" node="0>5|4|2" />
        <i3dMapping id="warningStripes01" node="0>5|4|2|0" />
        <i3dMapping id="infoTrigger" node="0>5|5" />
        <i3dMapping id="interior" node="0>6|0|0|1|0" />
        <i3dMapping id="conveyorBelt" node="0>6|0|0|2|3" />
        <i3dMapping id="propsLinkNode" node="0>6|0|0|3" />
    </i3dMappings>
</placeable>
