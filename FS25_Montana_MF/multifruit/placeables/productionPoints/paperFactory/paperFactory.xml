<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_storeItem_paperFactory</name>
        <functions>
            <function>$l10n_function_productionPoint</function>
        </functions>
        <image>$data/placeables/brandless/productionPointsGeneric/paperFactory/store_paperFactory.png</image>
        <price>525000</price>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>JINKOU</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>factories</tab>
        </brush>
        <vertexBufferMemoryUsage>0</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>0</indexBufferMemoryUsage>
        <textureMemoryUsage>0</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <filename>multifruit/placeables/productionPoints/paperFactory/paperFactory.i3d</filename>
	<boughtWithFarmland>false</boughtWithFarmland>
	<canBeDeleted>true</canBeDeleted>
	<canBeRenamed>true</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>

        <sounds>
            <place template="smallImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
        <clearArea startNode="clearAreaStart02" widthNode="clearAreaWidth02" heightNode="clearAreaHeight02"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30" >
        <levelAreas>
            <levelArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01" groundType="asphalt"/>
            <levelArea startNode="clearAreaStart02" widthNode="clearAreaWidth02" heightNode="clearAreaHeight02" groundType="asphalt"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01" />
        <indoorArea startNode="indoorAreaStart02" widthNode="indoorAreaWidth02" heightNode="indoorAreaHeight02" />
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger"/>

    <dynamicallyLoadedParts>
        <dynamicallyLoadedPart filename="$data/placeables/brandless/productionPointsGeneric/paperFactory/props.i3d" node="0" linkNode="propsLinkNode" />
    </dynamicallyLoadedParts>

    <lights>
        <group weatherRequiredFlags="NIGHT" />

        <lightShape node="interiorDay" groupIndex="1"/>
    </lights>

    <productionPoint>
        <productions>
            <production id="cartonRoll" name="%s (%s)" params="$l10n_fillType_cartonRoll|$l10n_fillType_wood" cyclesPerHour="1" costsPerActiveHour="5">
                <inputs>
                    <input fillType="WOOD" amount="420" />
                </inputs>
                <outputs>
                    <output fillType="CARTONROLL" amount="215" />
                </outputs>
            </production>
            <production id="paperRoll" name="%s (%s)" params="$l10n_fillType_paperRoll|$l10n_fillType_wood" cyclesPerHour="1" costsPerActiveHour="3">
                <inputs>
                    <input fillType="WOOD" amount="535" />
                </inputs>
                <outputs>
                    <output fillType="PAPERROLL" amount="230" />
                </outputs>
            </production>
	<production id="cartonRoll2" name="%s (%s + %s)" params="$l10n_fillType_cartonRoll|$l10n_fillType_hempFiber|$l10n_fillType_miscanthusCut" cyclesPerHour="1" costsPerActiveHour="5">
                <inputs>
                    <input fillType="MISCANTHUS_CUT" amount="550" />
                    <input fillType="HEMP_FIBER" amount="220" />
                </inputs>
                <outputs>
                    <output fillType="CARTONROLL" amount="200" />
                </outputs>
            </production>
            <production id="paperRoll2" name="%s (%s + %s)" params="$l10n_fillType_paperRoll|$l10n_fillType_hempFiber|$l10n_fillType_miscanthusCut" cyclesPerHour="1" costsPerActiveHour="3">
                <inputs>
                    <input fillType="MISCANTHUS_CUT" amount="750" />
                    <input fillType="HEMP_FIBER" amount="320" />
                </inputs>
                <outputs>
                    <output fillType="PAPERROLL" amount="230" />
                </outputs>
            </production>
	<production id="cartonRoll3" name="%s (%s)" params="$l10n_fillType_cartonRoll|$l10n_fillType_woodChips" cyclesPerHour="1" costsPerActiveHour="5">
                <inputs>
                    <input fillType="WOODCHIPS" amount="850" />
                </inputs>
                <outputs>
                    <output fillType="CARTONROLL" amount="255" />
                </outputs>
            </production>
            <production id="paperRoll3" name="%s (%s)" params="$l10n_fillType_paperRoll|$l10n_fillType_woodChips" cyclesPerHour="1" costsPerActiveHour="3">
                <inputs>
                    <input fillType="WOODCHIPS" amount="900" />
                </inputs>
                <outputs>
                    <output fillType="PAPERROLL" amount="330" />
                </outputs>
            </production>
	<production id="cartonRoll4" name="%s (%s + %s)" params="$l10n_fillType_cartonRoll|$l10n_fillType_flaxFiber|$l10n_fillType_miscanthusCut" cyclesPerHour="1" costsPerActiveHour="5">
                <inputs>
                    <input fillType="MISCANTHUS_CUT" amount="550" />
                    <input fillType="FLAX_FIBER" amount="200" />
                </inputs>
                <outputs>
                    <output fillType="CARTONROLL" amount="200" />
                </outputs>
            </production>
            <production id="paperRoll4" name="%s (%s + %s)" params="$l10n_fillType_paperRoll|$l10n_fillType_flaxFiber|$l10n_fillType_miscanthusCut" cyclesPerHour="1" costsPerActiveHour="3">
                <inputs>
                    <input fillType="MISCANTHUS_CUT" amount="750" />
                    <input fillType="FLAX_FIBER" amount="280" />
                </inputs>
                <outputs>
                    <output fillType="PAPERROLL" amount="230" />
                </outputs>
            </production>
        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <capacity fillType="WOOD"       		capacity="130000" />
            <capacity fillType="WOODCHIPS"       	capacity="130000" />
            <capacity fillType="HEMP_FIBER"       	capacity="130000" />
            <capacity fillType="FLAX_FIBER"       	capacity="130000" />
            <capacity fillType="MISCANTHUS_CUT"       	capacity="130000" />
            <capacity fillType="CARTONROLL" 		capacity="51000" />
            <capacity fillType="PAPERROLL"  		capacity="55000" />
        </storage>

        <effectNodes>
            <effectNode effectClass="ParticleEffect" effectNode="smokeEffectChimneyShape01" particleType="SMOKE_CHIMNEY" emitCountScale="0.5"/>
            <effectNode effectClass="ParticleEffect" effectNode="smokeEffectChimneyShape02" particleType="SMOKE_CHIMNEY" emitCountScale="0.5"/>
            <effectNode effectClass="ParticleEffect" effectNode="smokeEffectShape01"        particleType="SMOKE"         scale="0.1 0.5 0.1"/>
        </effectNodes>

         <sellingStation node="sellingStation" supportsExtension="false">
            	<unloadTrigger exactFillRootNode="unloadTrigger" fillTypes="WOOD WOODCHIPS MISCANTHUS_CUT HEMP_FIBER FLAX_FIBER" />
		<baleTrigger triggerNode="baleTrigger" fillTypes="WOODCHIPS MISCANTHUS_CUT HEMP_FIBER FLAX_FIBER"/>
            	<woodTrigger fillTypes="WOOD" aiNode="woodTrigger" triggerNode="woodTrigger" activationTriggerNode="woodActivationTrigger" />
        </sellingStation>

        <palletSpawner>
            <spawnPlaces>
                <spawnPlace startNode="palletAreaStart01" endNode="palletAreaEnd01"/>
            </spawnPlaces>
        </palletSpawner>

        <playerTrigger node="playerTrigger"/>

        <sounds>
            <idle template="paperFactoryIdle" />
            <active template="paperFactoryWork" />
        </sounds>
    </productionPoint>

    <triggerMarkers>
        <triggerMarker node="warningStripes_palletSpawnArea" />
        <triggerMarker node="playerTriggerMarker"         filename="$data/shared/assets/marker/markerIconWrench.i3d"           adjustToGround="false" />
        <triggerMarker node="unloadTriggerMarker"         filename="$data/shared/assets/marker/markerIconUnload.i3d"           adjustToGround="true" />
        <triggerMarker node="woodActivationTriggerMarker" filename="$data/shared/assets/marker/markerIconExclamationMark.i3d" adjustToGround="false" />
    </triggerMarkers>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker" teleportNode="unloadTriggerMarker" />
    </hotspots>

    <i3dMappings>
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="clearAreaStart02" node="0>0|1" />
        <i3dMapping id="clearAreaWidth02" node="0>0|1|0" />
        <i3dMapping id="clearAreaHeight02" node="0>0|1|1" />
        <i3dMapping id="indoorAreaStart01" node="0>1|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>1|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>1|0|1" />
        <i3dMapping id="indoorAreaStart02" node="0>1|1" />
        <i3dMapping id="indoorAreaWidth02" node="0>1|1|0" />
        <i3dMapping id="indoorAreaHeight02" node="0>1|1|1" />
        <i3dMapping id="testAreaStart01" node="0>2|0" />
        <i3dMapping id="testAreaEnd01" node="0>2|0|0" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>3|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>3|0|0" />
        <i3dMapping id="sellingStation" node="0>4" />
        <i3dMapping id="unloadTrigger" node="0>4|0" />
        <i3dMapping id="unloadTriggerMarker" node="0>4|1" />
        <i3dMapping id="productionPoint" node="0>5" />
        <i3dMapping id="playerTrigger" node="0>5|0" />
        <i3dMapping id="playerTriggerMarker" node="0>5|0|0" />
        <i3dMapping id="smokeEffectShape01" node="0>5|1|0" />
        <i3dMapping id="smokeEffectChimneyShape01" node="0>5|1|1" />
        <i3dMapping id="smokeEffectChimneyShape02" node="0>5|1|2" />
        <i3dMapping id="palletSpawner" node="0>6" />
        <i3dMapping id="palletAreaStart01" node="0>6|0" />
        <i3dMapping id="palletAreaEnd01" node="0>6|0|0" />
        <i3dMapping id="warningStripes" node="0>6|1" />
        <i3dMapping id="warningStripes_palletSpawnArea" node="0>6|1|0" />
        <i3dMapping id="infoTrigger" node="0>7" />
        <i3dMapping id="woodTrigger" node="0>8" />
        <i3dMapping id="woodActivationTrigger" node="0>8|0" />
        <i3dMapping id="woodActivationTriggerMarker" node="0>8|0|0" />
        <i3dMapping id="realLights" node="0>9|0" />
        <i3dMapping id="interiorDay" node="0>9|1|0" />
        <i3dMapping id="propsLinkNode" node="0>10|0|0|3" />
        <i3dMapping id="baleTrigger" node="0>4|2" />
    </i3dMappings>
</placeable>
