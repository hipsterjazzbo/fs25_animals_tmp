<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_shopItem_tobaccoProd</name>
        <functions>
            <function>$l10n_function_productionPoint</function>
        </functions>
        <image>$data/placeables/mapAS/cannedPackagedFactoryAS/store_cannedPackagedFactoryAS.png</image>
        <price>330000</price>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>JINKOU</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>factories</tab>
        </brush>
        <vertexBufferMemoryUsage>0</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>0</indexBufferMemoryUsage>
        <textureMemoryUsage>0</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <filename>multifruit/placeables/productionPoints/tobaccoProd/tobaccoProd.i3d</filename>
	<boughtWithFarmland>false</boughtWithFarmland>
	<canBeDeleted>true</canBeDeleted>
	<canBeRenamed>true</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>
        <sounds>
            <place template="largeImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30" >
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="asphalt"/>
        </levelAreas>
        <paintAreas>
            <paintArea startNode="paintAreaStart01" widthNode="paintAreaWidth01" heightNode="paintAreaHeight01" groundType="asphalt"/>
        </paintAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01" />
        <indoorArea startNode="indoorAreaStart02" widthNode="indoorAreaWidth02" heightNode="indoorAreaHeight02" />
        <indoorArea startNode="indoorAreaStart03" widthNode="indoorAreaWidth03" heightNode="indoorAreaHeight03" />
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger"/>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker" teleportNode="playerTriggerMarker" />
    </hotspots>

    <dynamicallyLoadedParts>
        <dynamicallyLoadedPart filename="$data/placeables/mapAS/cannedPackagedFactoryAS/cannedPackagedFactoryASProps.i3d" node="0" linkNode="props"/>
        <dynamicallyLoadedPart filename="$data/placeables/shared/sellingStationGeneric/sellingStationGenericNoCoverWideGrid.i3d"        node="0" linkNode="unloadTriggerLinkNode" rotation="0 90 0"/>
        <dynamicallyLoadedPart filename="$data/effects/chimneySmoke/smokeTrailSubUV.i3d"                                                node="0" linkNode="smokeBig01" shaderParameterName="colorAlpha" shaderParameter="0.5 0.5 0.5 0.5"/>
    </dynamicallyLoadedParts>

    <triggerMarkers>
        <triggerMarker node="warningStripes01"/>
        <triggerMarker node="playerTriggerMarker" filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
        <triggerMarker node="unloadTriggerMarker" filename="$data/shared/assets/marker/markerIconUnload.i3d" adjustToGround="true"/>
    </triggerMarkers>

    <lights>
        <group weatherRequiredFlags="NIGHT" />

        <lightShape node="interior" groupIndex="1"/>

        <realLights>
            <low>
                <light node="realLights" groupIndex="1"/>
            </low>
            <high>
                <light node="realLights" groupIndex="1"/>
            </high>
        </realLights>
    </lights>

    <productionPoint>
        <productions>
            <production id="cigar" name="$l10n_fillType_cigar" cyclesPerHour="20" costsPerActiveHour="15">
                <inputs>
                    <input fillType="TOBACCO" amount="80" />
                    <input fillType="CARTONROLL" amount="8" />
                </inputs>
                <outputs>
                    <output fillType="CIGAR" amount="20" />
                </outputs>
            </production>

            <production id="cigarette1" name="$l10n_fillType_cigarette" cyclesPerHour="18" costsPerActiveHour="5">
                <inputs>
                    <input fillType="TOBACCO" amount="80" />
                    <input fillType="PAPERROLL" amount="5" />
                    <input fillType="CARTONROLL" amount="4" />
                </inputs>
                <outputs>
                    <output fillType="CIGARETTE" amount="40" />
                </outputs>
            </production>

            <production id="cigarette2" name="$l10n_fillType_cigarette" cyclesPerHour="18" costsPerActiveHour="5">
                <inputs>
                    <input fillType="TOBACCO" amount="80" />
                    <input fillType="MINT" amount="30" />
                    <input fillType="PAPERROLL" amount="5" />
                    <input fillType="CARTONROLL" amount="4" />
                </inputs>
                <outputs>
                    <output fillType="CIGARETTE" amount="60" />
                </outputs>
            </production>
        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <capacity fillType="TOBACCO"       		capacity="200000" />
            <capacity fillType="MINT"       		capacity="100000" />
            <capacity fillType="CARTONROLL"     	capacity="150000" />
            <capacity fillType="PAPERROLL"     		capacity="150000" />
            <capacity fillType="CIGAR"     		capacity="50000" />
            <capacity fillType="CIGARETTE"       	capacity="50000" />
        </storage>

        <sellingStation node="sellingStation" supportsExtension="false">
            <unloadTrigger exactFillRootNode="unloadTrigger" aiNode="unloadTriggerAINode" fillTypes="TOBACCO MINT"/>
           <palletTrigger triggerNode="palletTrigger" fillTypes="CARTONROLL PAPERROLL"/>
        </sellingStation>

        <palletSpawner>
            <spawnPlaces>
                <spawnPlace startNode="palletAreaStart01" endNode="palletAreaEnd01"/>
                <spawnPlace startNode="palletAreaStart02" endNode="palletAreaEnd02"/>
            </spawnPlaces>
        </palletSpawner>

        <playerTrigger node="playerTrigger" />

        <sounds>
            <idle   template="preservedFoodIdle" linkNode="0>" outerRadius="50"/>
            <active template="preservedFoodWork" linkNode="0>" outerRadius="50"/>
        </sounds>
    </productionPoint>

    <i3dMappings>
        <i3dMapping id="cannedPackagedFactoryAS" node="0>" />
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="levelAreaStart01" node="0>1|0" />
        <i3dMapping id="levelAreaWidth01" node="0>1|0|0" />
        <i3dMapping id="levelAreaHeight01" node="0>1|0|1" />
        <i3dMapping id="paintAreaStart01" node="0>2|0" />
        <i3dMapping id="paintAreaWidth01" node="0>2|0|0" />
        <i3dMapping id="paintAreaHeight01" node="0>2|0|1" />
        <i3dMapping id="indoorAreaStart01" node="0>3|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>3|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>3|0|1" />
        <i3dMapping id="indoorAreaStart02" node="0>3|1" />
        <i3dMapping id="indoorAreaWidth02" node="0>3|1|0" />
        <i3dMapping id="indoorAreaHeight02" node="0>3|1|1" />
        <i3dMapping id="indoorAreaStart03" node="0>3|2" />
        <i3dMapping id="indoorAreaWidth03" node="0>3|2|0" />
        <i3dMapping id="indoorAreaHeight03" node="0>3|2|1" />
        <i3dMapping id="testAreaStart01" node="0>4|0" />
        <i3dMapping id="testAreaEnd01" node="0>4|0|0" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>5|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>5|0|0" />
        <i3dMapping id="realLights" node="0>6|0" />
        <i3dMapping id="interior" node="0>6|1" />
        <i3dMapping id="infoTrigger" node="0>7" />
        <i3dMapping id="sellingStation" node="0>8" />
        <i3dMapping id="unloadTrigger" node="0>8|0" />
        <i3dMapping id="palletTrigger" node="0>8|1" />
        <i3dMapping id="unloadTriggerMarker" node="0>8|2" />
        <i3dMapping id="unloadTriggerAINode" node="0>8|3" />
        <i3dMapping id="unloadTriggerLinkNode" node="0>8|4" />
        <i3dMapping id="playerTrigger" node="0>9|0" />
        <i3dMapping id="playerTriggerMarker" node="0>9|1" />
        <i3dMapping id="palletSpawner" node="0>10" />
        <i3dMapping id="palletAreaStart01" node="0>10|0" />
        <i3dMapping id="palletAreaEnd01" node="0>10|0|0" />
        <i3dMapping id="palletAreaStart02" node="0>10|1" />
        <i3dMapping id="palletAreaEnd02" node="0>10|1|0" />
        <i3dMapping id="warningStripes01" node="0>10|2" />
        <i3dMapping id="props" node="0>11|0" />
        <i3dMapping id="smokeBig01" node="0>12|1" />
    </i3dMappings>
</placeable>
