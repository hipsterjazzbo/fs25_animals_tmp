    <productionPoint>
        <productions sharedThroughputCapacity="false">
            
	<production id="Honey Mead" name="$l10n_fillType_meadBarrel" cyclesPerHour="3" costsPerActiveHour="7">
                <inputs>
                    <input fillType="HONEY" amount="80" />
		    <input fillType="WATER" amount="160" />
                    <input fillType="BARREL" amount="10" />
                    <input fillType="YEAST" amount="5" />
                </inputs>
                <outputs>
			<output fillType="HONEY_MEAD" amount="150" />
			<output fillType="ORGANICWASTE" amount="50" />
                </outputs>
            </production>

	<production id="Rum Barrel" name="$l10n_fillType_rumBarrel" cyclesPerHour="3" costsPerActiveHour="7">
                <inputs>
                    <input fillType="SUGARCANE" amount="1500" /> 
		    <!-- <input fillType="WATER" amount="300" /> -->
                    <input fillType="BARREL" amount="15" />
                </inputs>
                <outputs>
			<output fillType="RUM_BARREL" amount="150" /> 
			<output fillType="ORGANICWASTE" amount="50" />
                </outputs>
            </production>

	<production id="Bourbon Barrel" name="$l10n_fillType_bourbonBarrel" cyclesPerHour="3" costsPerActiveHour="7">
               <inputs>
		<input fillType="MAIZE2" amount="200" />
		<input fillType="WATER" amount="300" />
		<input fillType="WHEAT" amount="150" />
                <input fillType="BARREL" amount="15" />
                    <input fillType="YEAST" amount="5" />
               </inputs>
                <outputs>
			<output fillType="BOURBON_BARREL" amount="150" />
			<output fillType="ORGANICWASTE" amount="50" />
                </outputs>
            </production>

	<production id="Whiskey Barrel" name="$l10n_fillType_whiskeyBarrel" cyclesPerHour="3" costsPerActiveHour="7">
               <inputs>
                <!-- <input fillType="MAIZE" amount="600" /> -->
		<!-- <input fillType="MAIZE2" amount="500" /> -->
		<input fillType="WATER" amount="350" />
		<input fillType="BARLEY" amount="250" /> 
		<input fillType="RYE" amount="150" />
                <input fillType="BARREL" amount="15" />
                    <input fillType="YEAST" amount="5" />
               </inputs>
                <outputs>
		<output fillType="WHISKEY_BARREL" amount="150" />
			<output fillType="ORGANICWASTE" amount="50" />
                </outputs>
            </production>

	<production id="Liqueur Barrel" name="$l10n_fillType_liqueurBarrel" cyclesPerHour="2" costsPerActiveHour="10">
               <inputs>
		<input fillType="BARLEY" amount="200" />
		<input fillType="WATER" amount="300" />
                <input fillType="STRAWBERRY" amount="200" />
		<input fillType="SUGAR" amount="50" />
                <input fillType="BARREL" amount="18" />
               </inputs>
                <outputs>
			<output fillType="LIQUEUR_BARREL" amount="200" />
			<output fillType="ORGANICWASTE" amount="50" />
                </outputs>
            </production>

	<production id="Mint Barrel" name="$l10n_fillType_mintBarrel" cyclesPerHour="2" costsPerActiveHour="10">
               <inputs>
		<input fillType="BARLEY" amount="200" />
		<input fillType="WATER" amount="300" />
                <input fillType="MINT" amount="200" />
		<input fillType="SUGAR" amount="90" />
                <input fillType="BARREL" amount="18" />
               </inputs>
                <outputs>
			<output fillType="MINT_BARREL" amount="230" />
			<output fillType="ORGANICWASTE" amount="30" />
                </outputs>
            </production>

	<production id="Brandy Barrel" name="$l10n_fillType_brandyBarrel" cyclesPerHour="2" costsPerActiveHour="10">
               <inputs>
		<!-- <input fillType="MAIZE2" amount="1000" /> -->
                <input fillType="PLUM" amount="200" />
		<input fillType="WATER" amount="150" />
		<input fillType="SUGAR" amount="100" />
                <input fillType="BARREL" amount="18" />
               </inputs>
                <outputs>
			<output fillType="BRANDY_BARREL" amount="280" />
			<output fillType="ORGANICWASTE" amount="80" />
                </outputs>
            </production>

	<production id="Cider Barrel" name="$l10n_fillType_ciderBarrel" cyclesPerHour="2" costsPerActiveHour="10">
               <inputs>
                <input fillType="APPLE" amount="300" />
		<!-- <input fillType="WATER" amount="300" /> -->
		<input fillType="SUGAR" amount="100" />
                <input fillType="BARREL" amount="20" />
               </inputs>
                <outputs>
			<output fillType="CIDER_BARREL" amount="250" />
			<output fillType="ORGANICWASTE" amount="50" />
                </outputs>
            </production>

	<production id="Vodka Barrel" name="$l10n_fillType_vodkaBarrel" cyclesPerHour="1" costsPerActiveHour="4">
               <inputs>
                <input fillType="POTATO" amount="800" />
		<input fillType="WATER" amount="200" />
		<input fillType="OAT" amount="300" />
                <input fillType="BARREL" amount="30" />
               </inputs>
                <outputs>
		<output fillType="VODKA_BARREL" amount="450" />
			<output fillType="ORGANICWASTE" amount="50" />
                </outputs>
            </production>  
        </productions>

        <sellingStation node="sellingStation" appearsOnStats="false" supportsExtension="false" allowMissions="false" hideFromPricesMenu="true">
            <unloadTrigger exactFillRootNode="unloadTrigger" aiNode="unloadTriggerAINode" fillTypes="TARO MINT MAIZE MAIZE2 BARLEY RYE TRITICALE SPELT WHEAT OAT POTATO SUGARBEET SUGARCANE SUGAR WATER">
			<fillTypeConversion ratio="1" incomingFillType="SPELT" 		outgoingFillType="WHEAT" />
			<fillTypeConversion ratio="1" incomingFillType="TRITICALE" 	outgoingFillType="WHEAT" />
			<fillTypeConversion ratio="1" incomingFillType="SUGARBEET" 	outgoingFillType="POTATO" />
