			<fillTypeConversion ratio="1.3" incomingFillType="MELON" 	outgoingFillType="STRAWBERRY" />
			<fillTypeConversion ratio="1.1" incomingFillType="PEACH" 	outgoingFillType="STRAWBERRY" />
			<fillTypeConversion ratio="1" incomingFillType="APRICOT" 	outgoingFillType="STRAWBERRY" />
			<fillTypeConversion ratio="1.2" incomingFillType="CHERRY" 	outgoingFillType="STRAWBERRY" />
			<fillTypeConversion ratio="1.2" incomingFillType="PEAR" 	outgoingFillType="PLUM" />
			<fillTypeConversion ratio="1.1" incomingFillType="QUINCE" 	outgoingFillType="PLUM" />
		</palletTrigger>
