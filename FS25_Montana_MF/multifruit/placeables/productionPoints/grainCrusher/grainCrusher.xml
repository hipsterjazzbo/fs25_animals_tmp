<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_shopItem_grainCrusher</name>
        <functions>
            <function>$l10n_function_productionPoint</function>
        </functions>
        <image>multifruit/placeables/productionPoints/grainCrusher/store_grainCrusher.dds</image>
        <price>50000</price>
        <showInStore>true</showInStore>
        <dailyUpkeep>50</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>JINKOU</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>factories</tab>
        </brush>
    </storeData>

    <base>
        <filename>multifruit/placeables/productionPoints/grainCrusher/grainCrusher.i3d</filename>
	<boughtWithFarmland>true</boughtWithFarmland>
	<canBeDeleted>true</canBeDeleted>
	<canBeRenamed>true</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>

        <sounds>
            <place template="smallImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="1" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="asphalt"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01"/>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger"/>

    <productionPoint>
        <productions sharedThroughputCapacity="false">
            
<production id="mineral_feed" name="$l10n_fillType_mineralFeed" cyclesPerHour="10" costsPerActiveHour="2">
                <inputs>
                    	<input fillType="DRYPEAS" 		amount="250" />
			<input fillType="MISCANTHUS_CUT"        amount="500" />
			<input fillType="MAIZE2"         	amount="100" />
			<input fillType="CANOLA"         	amount="150" />
                </inputs>
                <outputs>
                    <output fillType="MINERAL_FEED" amount="500" />
                </outputs>
            </production>

<production id="crackedCorn" name="$l10n_fillType_crackedCorn" cyclesPerHour="30" costsPerActiveHour="2">
                <inputs>
			<input fillType="MAIZE2"         	amount="1111" />
                </inputs>
                <outputs>
                    <output fillType="CRACKEDCORN" amount="1500" />
                </outputs>
            </production>

<production id="ccmraw" name="$l10n_fillType_ccmraw" cyclesPerHour="30" costsPerActiveHour="1">
                <inputs>
			<input fillType="MAIZE"         	amount="1111" />
                </inputs>
                <outputs>
                    <output fillType="CCMRAW" amount="1200" />
                </outputs>
            </production>

        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="100">
			<capacity fillType="DRYPEAS"    		capacity="250000" />
			<capacity fillType="MISCANTHUS_CUT"           	capacity="500000" />
			<capacity fillType="CANOLA" 			capacity="250000" />
			<capacity fillType="MAIZE" 			capacity="250000" />
			<capacity fillType="MAIZE2" 			capacity="250000" />
			<capacity fillType="MINERAL_FEED" 		capacity="250000" />
			<capacity fillType="CRACKEDCORN" 		capacity="250000" />
			<capacity fillType="CCMRAW" 			capacity="250000" />
        </storage>

        <sellingStation node="sellingStation"  appearsOnStats="false" supportsExtension="false" allowMissions="false" hideFromPricesMenu="true">
            <unloadTrigger exactFillRootNode="exactFillNode" aiNode="unloadTriggerAINode" fillTypes="MINERAL_FEED SAFFLOWER SOYBEAN SOYBEAN2 CANOLA SESAME SUNFLOWER POPPY CRACKEDCORN MAIZE MAIZE2 MISCANTHUS_CUT DRYPEAS">
		<fillTypeConversion ratio="0.9" incomingFillType="SUNFLOWER" 	outgoingFillType="CANOLA" />
		<fillTypeConversion ratio="1.1" incomingFillType="POPPY" 	outgoingFillType="CANOLA" />
		<fillTypeConversion ratio="1.2" incomingFillType="SESAME" 	outgoingFillType="CANOLA" />
		<fillTypeConversion ratio="1.2" incomingFillType="SAFFLOWER" 	outgoingFillType="CANOLA" />
		<fillTypeConversion ratio="1.1" incomingFillType="SOYBEAN" 	outgoingFillType="DRYPEAS" />
		<fillTypeConversion ratio="1.3" incomingFillType="SOYBEAN2" 	outgoingFillType="DRYPEAS" />
		</unloadTrigger>
            <!-- <palletTrigger triggerNode="palletTrigger" fillTypes="POTATO" /> -->
            <baleTrigger triggerNode="baleTrigger" fillTypes="MISCANTHUS_CUT" deleteLitersPerSecond="2000"/>
        </sellingStation>

        <unloadingStation supportsExtension="true" storageRadius="50">
            <unloadTrigger exactFillRootNode="exactFillNode" aiNode="unloadTriggerAINode" fillTypes="MINERAL_FEED CANOLA SUNFLOWER POPPY CRACKEDCORN MAIZE MAIZE2 CCMRAW MISCANTHUS_CUT DRYPEAS"/>
            <!-- <palletTrigger triggerNode="palletTrigger" fillTypes="POTATO" /> -->
            <baleTrigger triggerNode="baleTrigger" fillTypes="MISCANTHUS_CUT" deleteLitersPerSecond="2000"/>
        </unloadingStation>

        <loadingStation node="loadingTrigger" supportsExtension="true" storageRadius="50">
		<loadTrigger triggerNode="loadingTrigger" fillLitersPerSecond="1000" dischargeNode="dischargeNode" fillTypes="MINERAL_FEED CRACKEDCORN CCMRAW" aiNode="aiLoadingNode" >
		<effectNode effectClass="PipeEffect" effectNode="pipeEffect"      materialType="pipe"           fadeTime="0.5" maxBending="0" controlPoint="4.8 0 0 0"/>
                <effectNode          effectNode="pipeEffectSmoke" materialType="unloadingSmoke" fadeTime="0.5" />
                <sounds>
                    <loading template="silosActive" />
                </sounds>
			</loadTrigger>
        </loadingStation>

        <playerTrigger node="playerTrigger" />

    </productionPoint>

    <hotspots>
        <hotspot type="UNLOADING" linkNode="mapPosition" teleportNode="teleportNode"/>
    </hotspots>

    <triggerMarkers>
        <triggerMarker node="loadingMarker"   filename="$data/shared/assets/marker/markerIconLoad.i3d" />
        <triggerMarker node="unloadTriggerMarker" filename="$data/shared/assets/marker/markerIconUnload.i3d" />
        <triggerMarker node="playerTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
    </triggerMarkers>

    <i3dMappings>
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="indoorAreaStart01" node="0>3|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>3|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>3|0|1" />
        <i3dMapping id="infoTrigger" node="0>6" />
        <i3dMapping id="levelAreaStart01" node="0>1|0" />
        <i3dMapping id="levelAreaWidth01" node="0>1|0|0" />
        <i3dMapping id="levelAreaHeight01" node="0>1|0|1" />
        <i3dMapping id="aiLoadingNode" node="0>11|0" />
        <i3dMapping id="dischargeNode" node="0>11|1" />
        <i3dMapping id="loadingTrigger" node="0>11|4" />
        <i3dMapping id="loadingMarker" node="0>11|3" />
        <i3dMapping id="mapPosition" node="0>12" />
        <i3dMapping id="teleportNode" node="0>13" />
        <i3dMapping id="playerTrigger" node="0>8|0" />
        <i3dMapping id="playerTriggerMarker" node="0>8|1" />
        <i3dMapping id="sellingStation" node="0>7" />
        <i3dMapping id="exactFillNode" node="0>7|0" />
        <i3dMapping id="unloadTriggerMarker" node="0>7|1" />
        <i3dMapping id="unloadTriggerAINode" node="0>7|2" />
        <i3dMapping id="baleTrigger" node="0>7|3" />
        <i3dMapping id="palletTrigger" node="0>7|4" />
        <i3dMapping id="testAreaStart01" node="0>4|0" />
        <i3dMapping id="testAreaEnd01" node="0>4|0|0" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>5|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>5|0|0" />
        <i3dMapping id="dischargeEffect" node="0>11|6" />
        <i3dMapping id="pipeEffect" node="0>11|6|0" />
        <i3dMapping id="pipeEffectSmoke" node="0>11|6|1" />
    </i3dMappings>
</placeable>
