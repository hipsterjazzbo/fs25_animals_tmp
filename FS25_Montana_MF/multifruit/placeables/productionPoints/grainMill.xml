<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_station_us_grainMill</name>
        <functions>
            <function>$l10n_function_productionPoint</function>
        </functions>
        <image>$data/placeables/brandless/productionPointsGeneric/grainMill/store_grainMill.png</image>
        <price>288000</price>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>JINKOU</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>factories</tab>
        </brush>
        <vertexBufferMemoryUsage>0</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>0</indexBufferMemoryUsage>
        <textureMemoryUsage>0</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <filename>$data/placeables/brandless/productionPointsGeneric/grainMill/grainMill.i3d</filename>
	<boughtWithFarmland>false</boughtWithFarmland>
	<canBeDeleted>true</canBeDeleted>
	<canBeRenamed>true</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>
        <sounds>
            <place template="medImp"/>
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30" >
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="asphalt"/>
        </levelAreas>
        <paintAreas>
            <paintArea startNode="paintAreaStart01" widthNode="paintAreaWidth01" heightNode="paintAreaHeight01" groundType="asphalt"/>
        </paintAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01" />
        <indoorArea startNode="indoorAreaStart02" widthNode="indoorAreaWidth02" heightNode="indoorAreaHeight02" />
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger"/>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker" teleportNode="playerTriggerMarker" />
    </hotspots>

    <dynamicallyLoadedParts>
        <dynamicallyLoadedPart filename="$data/placeables/shared/sellingStationGeneric/sellingStationGenericNoCover.i3d"  linkNode="unloadTriggerLinkNode"/>
        <dynamicallyLoadedPart filename="$data/placeables/brandless/productionPointsGeneric/grainMill/grainMillProps.i3d" linkNode="props" node="0"/>
    </dynamicallyLoadedParts>

    <triggerMarkers>
        <triggerMarker node="warningStripes01"/>
        <triggerMarker node="unloadTriggerMarker" filename="$data/shared/assets/marker/markerIconUnload.i3d" adjustToGround="true"/>
        <triggerMarker node="playerTriggerMarker" filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
    </triggerMarkers>

    <productionPoint>
        <productions sharedThroughputCapacity="false">
            
<production id="flourWheat" name="$l10n_fillType_flour" cyclesPerHour="105" costsPerActiveHour="1">
                <inputs>
                    <input fillType="WHEAT" amount="5" />
                </inputs>
                <outputs>
                    <output fillType="FLOUR" amount="4" />
                    <output fillType="BRAN" amount="1" />
                </outputs>
            </production>         
	
<production id="flourRye" name="$l10n_fillType_ryeflour" cyclesPerHour="105" costsPerActiveHour="1">
                <inputs>
                    <input fillType="RYE" amount="5" />
                </inputs>
                <outputs>
                    <output fillType="RYEFLOUR" amount="3" />
                    <output fillType="BRAN" amount="2" />
                </outputs>
            </production>
		
<production id="flourMaize" name="$l10n_fillType_cornflour" cyclesPerHour="25" costsPerActiveHour="1">
                <inputs>
                    <input fillType="MAIZE" amount="30" />
                </inputs>
                <outputs>
                    <output fillType="CORNFLOUR" amount="20" />
                    <output fillType="BRAN" amount="10" />
                </outputs>
            </production>
            
<production id="flourSorghum" name="$l10n_fillType_sorghumflour" cyclesPerHour="50" costsPerActiveHour="1">
                <inputs>
                    <input fillType="SORGHUM" amount="15" />
                </inputs>
                <outputs>
                    <output fillType="SORGHUMFLOUR" amount="11" />
                    <output fillType="BRAN" amount="4" />
                </outputs>
            </production>
            
<production id="flourBuckwheat" name="$l10n_fillType_buckwheatflour" cyclesPerHour="40" costsPerActiveHour="1">
                <inputs>
                    <input fillType="BUCKWHEAT" amount="25" />
                </inputs>
                <outputs>
                    <output fillType="BUCKWHEATFLOUR" amount="18" />
                    <output fillType="BRAN" amount="7" />
                </outputs>
            </production>

<production id="flourMillet" name="$l10n_fillType_milletflour" cyclesPerHour="50" costsPerActiveHour="1">
                <inputs>
                    <input fillType="MILLET" amount="15" />
                </inputs>
                <outputs>
                    <output fillType="MILLETFLOUR" amount="13" />
                    <output fillType="BRAN" amount="5" />
                </outputs>
            </production>
            
<production id="flourRice" name="$l10n_fillType_riceFlour" cyclesPerHour="30" costsPerActiveHour="1">
                <inputs>
                    <input fillType="RICE" amount="9" />
                </inputs>
                <outputs>
                    <output fillType="RICEFLOUR" amount="15" />
                    <output fillType="BRAN" amount="3" />
                </outputs>
            </production>
            
<production id="flourSoybean" name="$l10n_fillType_gramflour" cyclesPerHour="30" costsPerActiveHour="1">
                <inputs>
                    <input fillType="SOYBEAN" amount="9" />
                </inputs>
                <outputs>
                    <output fillType="GRAMFLOUR" amount="12" />
                    <output fillType="BRAN" amount="5" />
                </outputs>
            </production>
            
<production id="flourTaro" name="$l10n_fillType_taroFlour" cyclesPerHour="50" costsPerActiveHour="2">
                <inputs>
                    <input fillType="TARO_CUT" amount="15" />
                </inputs>
                <outputs>
                    <output fillType="TAROFLOUR" amount="10" />
                    <output fillType="BRAN" amount="1" />
                </outputs>
            </production>
            
        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <capacity fillType="WHEAT"         		capacity="1260000" />
            <capacity fillType="MAIZE"         		capacity="1440000" />
            <capacity fillType="SORGHUM"       		capacity="1800000" />
            <capacity fillType="RICE"          		capacity="165000" />
            <capacity fillType="RYE"         		capacity="1440000" />
            <capacity fillType="MILLET"         	capacity="1440000" />
            <capacity fillType="BUCKWHEAT"         	capacity="1440000" />
            <capacity fillType="SOYBEAN"         	capacity="1440000" />
            <capacity fillType="TARO_CUT"         	capacity="1440000" />
            <capacity fillType="FLOUR"         		capacity="90000" />
            <capacity fillType="RICEFLOUR"     		capacity="90000" />
            <capacity fillType="CORNFLOUR"     		capacity="90000" />
            <capacity fillType="BUCKWHEATFLOUR"     	capacity="90000" />
            <capacity fillType="GRAMFLOUR"         	capacity="90000" />
            <capacity fillType="RYEFLOUR"     		capacity="90000" />
            <capacity fillType="MILLETFLOUR"     	capacity="90000" />
            <capacity fillType="SORGHUMFLOUR"     	capacity="90000" />
            <capacity fillType="TAROFLOUR"     		capacity="90000" />
            <capacity fillType="BRAN"     		capacity="90000" />
        </storage>

        <sellingStation node="sellingStationProduction" appearsOnStats="false" supportsExtension="false" allowMissions="false" hideFromPricesMenu="true">
            <unloadTrigger exactFillRootNode="exactFillNode" aiNode="unloadTriggerAINode" fillTypes="SOYBEAN2 TARO TARO_CUT BUCKWHEAT WHEAT BARLEY MAIZE MAIZE2 MILLET OAT SORGHUM RICELONGGRAIN RICE RYE TRITICALE SPELT DRYPEAS CHICKPEAS LENTILS SOYBEAN">
			<fillTypeConversion ratio="0.9" incomingFillType="BARLEY" 		outgoingFillType="WHEAT" />
			<fillTypeConversion ratio="1" incomingFillType="TRITICALE" 		outgoingFillType="WHEAT" />
			<fillTypeConversion ratio="1" incomingFillType="SPELT" 			outgoingFillType="WHEAT" />
			<fillTypeConversion ratio="1.1" incomingFillType="OAT" 			outgoingFillType="WHEAT" />
			<fillTypeConversion ratio="1.3" incomingFillType="MAIZE2" 		outgoingFillType="MAIZE" />
			<fillTypeConversion ratio="1.1" incomingFillType="RICELONGGRAIN" 	outgoingFillType="RICE" />
			<fillTypeConversion ratio="1.1" incomingFillType="CHICKPEAS" 		outgoingFillType="SOYBEAN" />
			<fillTypeConversion ratio="1" incomingFillType="LENTILS" 		outgoingFillType="SOYBEAN" />
			<fillTypeConversion ratio="0.9" incomingFillType="DRYPEAS" 		outgoingFillType="SOYBEAN" />
			<fillTypeConversion ratio="1.1" incomingFillType="SOYBEAN2" 		outgoingFillType="SOYBEAN" />
			<fillTypeConversion ratio="0.4" incomingFillType="TARO" 		outgoingFillType="TARO_CUT" />
		</unloadTrigger>
        </sellingStation>

        <palletSpawner>
            <spawnPlaces>
                <spawnPlace startNode="palletAreaStart01" endNode="palletAreaEnd01"/>
                <spawnPlace startNode="palletAreaStart02" endNode="palletAreaEnd02"/>
                <spawnPlace startNode="palletAreaStart03" endNode="palletAreaEnd03"/>
            </spawnPlaces>
        </palletSpawner>

        <playerTrigger node="playerTrigger" />
        <sounds>
            <idle   template="grainMillIdle" linkNode="0>" pitchScale="1.0"/>
            <active template="grainMillWork" linkNode="0>" pitchScale="1.0"/>
        </sounds>
    </productionPoint>

    <i3dMappings>
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="levelAreaStart01" node="0>1|0" />
        <i3dMapping id="levelAreaWidth01" node="0>1|0|0" />
        <i3dMapping id="levelAreaHeight01" node="0>1|0|1" />
        <i3dMapping id="paintAreaStart01" node="0>2|0" />
        <i3dMapping id="paintAreaWidth01" node="0>2|0|0" />
        <i3dMapping id="paintAreaHeight01" node="0>2|0|1" />
        <i3dMapping id="indoorAreaStart01" node="0>3|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>3|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>3|0|1" />
        <i3dMapping id="indoorAreaStart02" node="0>3|1" />
        <i3dMapping id="indoorAreaWidth02" node="0>3|1|0" />
        <i3dMapping id="indoorAreaHeight02" node="0>3|1|1" />
        <i3dMapping id="testAreaStart01" node="0>4|0" />
        <i3dMapping id="testAreaEnd01" node="0>4|0|0" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>5|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>5|0|0" />
        <i3dMapping id="infoTrigger" node="0>7" />
        <i3dMapping id="sellingStation" node="0>8" />
        <i3dMapping id="exactFillNode" node="0>8|0" />
        <i3dMapping id="unloadTriggerMarker" node="0>8|1" />
        <i3dMapping id="unloadTriggerAINode" node="0>8|2" />
        <i3dMapping id="unloadTriggerLinkNode" node="0>8|3" />
        <i3dMapping id="playerTrigger" node="0>9|0" />
        <i3dMapping id="playerTriggerMarker" node="0>9|1" />
        <i3dMapping id="warningStripes01" node="0>10|0" />
        <i3dMapping id="palletSpawner" node="0>11" />
        <i3dMapping id="palletAreaStart01" node="0>11|0" />
        <i3dMapping id="palletAreaEnd01" node="0>11|0|0" />
        <i3dMapping id="palletAreaStart02" node="0>11|1" />
        <i3dMapping id="palletAreaEnd02" node="0>11|1|0" />
        <i3dMapping id="palletAreaStart03" node="0>11|2" />
        <i3dMapping id="palletAreaEnd03" node="0>11|2|0" />
        <i3dMapping id="props" node="0>12|1" />
    </i3dMappings>
</placeable>
