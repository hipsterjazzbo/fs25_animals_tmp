<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_shopItem_vegetarianProd</name>
        <functions>
            <function>$l10n_function_productionPoint</function>
        </functions>
        <image>multifruit/placeables/productionPoints/vegetarianProd/textures/store_vegetarianProd.dds</image>
        <price>165000</price>
	<dailyUpkeep>135</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>JINKOU</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>factories</tab>
        </brush>
        <vertexBufferMemoryUsage>1165312</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>321024</indexBufferMemoryUsage>
        <textureMemoryUsage>2686976</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <filename>multifruit/placeables/productionPoints/vegetarianProd/vegetarianProd.i3d</filename>
	<boughtWithFarmland>false</boughtWithFarmland>
	<canBeDeleted>true</canBeDeleted>
	<canBeRenamed>true</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>
        <sounds>
            <place template="medImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30" >
        <levelAreas>
            <levelArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01" groundType="asphalt"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01" />
        <indoorArea startNode="indoorAreaStart02" widthNode="indoorAreaWidth02" heightNode="indoorAreaHeight02" />
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger" />

    <lights>
        <group weatherRequiredFlags="NIGHT" />

        <realLights>
            <low>
                <light node="realLightsLow" groupIndex="1"/>
            </low>
            <high>
                <light node="realLightsHigh" groupIndex="1"/>
            </high>
        </realLights>
    </lights>

    <productionPoint>
        <productions>
            <production id="tofu" name="$l10n_fillType_tofu" cyclesPerHour="15" costsPerActiveHour="2">
                <inputs>
                    <input fillType="SOYBEAN" amount="30" />
                    <input fillType="COOKING_SALT" amount="1" />
                </inputs>
                <outputs>
                    <output fillType="TOFU" amount="27" />
                </outputs>
            </production>            

	<production id="hummus" name="$l10n_fillType_hummus" cyclesPerHour="20" costsPerActiveHour="2">
                <inputs>
                    <input fillType="SESAME" amount="5" />
                    <input fillType="CHICKPEAS" amount="20" /> 
					<input fillType="GARLIC" amount="1" />
                    <input fillType="COOKING_SALT" amount="1" />
                </inputs>
                <outputs>
                    <output fillType="HUMMUS" amount="24" /> 
                </outputs>
            </production>

	<production id="soymilk" name="$l10n_fillType_soymilk" cyclesPerHour="15" costsPerActiveHour="2">
                <inputs>
                    <input fillType="SOYBEAN" amount="15" />
                    <input fillType="WATER" amount="35" />
                    <input fillType="CARTONROLL" amount="3" />
                </inputs>
                <outputs>
                    <output fillType="SOYMILK" amount="30" />
                </outputs>
            </production>

	<production id="oatmilk" name="$l10n_fillType_oatmilk" cyclesPerHour="15" costsPerActiveHour="2">
                <inputs>
                    <input fillType="OAT" amount="10" />
                    <input fillType="WATER" amount="30" />
                    <input fillType="CARTONROLL" amount="3" />
                </inputs>
                <outputs>
                    <output fillType="OATMILK" amount="25" />
                </outputs>
            </production>
        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <capacity fillType="CARTONROLL"         		capacity="150000" />
            <capacity fillType="COOKING_SALT"           	capacity="100000" />
		<capacity fillType="GARLIC"         		capacity="15000" />
            <capacity fillType="SOYBEAN"       		 	capacity="900000" />
            <capacity fillType="SESAME"       		 	capacity="900000" />
            <capacity fillType="CHICKPEAS"       		 capacity="900000" />
            <capacity fillType="OAT"       		 	capacity="900000" />
	    <capacity fillType="WATER"       		 	capacity="900000" />
	    <capacity fillType="SOYMILK"  			 capacity="200000" />
	    <capacity fillType="OATMILK"  			 capacity="200000" />
	    <capacity fillType="TOFU"  			 	capacity="200000" />
	    <capacity fillType="HUMMUS"  			 capacity="200000" />
        </storage>

        <sellingStation node="sellingStation" supportsExtension="false">
            <unloadTrigger exactFillRootNode="unloadTrigger" aiNode="unloadTriggerAINode" fillTypes="WATER SESAME CHICKPEAS SOYBEAN SOYBEAN2 OAT">
		<fillTypeConversion ratio="1.1" incomingFillType="SOYBEAN2" 		outgoingFillType="SOYBEAN" />
		</unloadTrigger>
            <palletTrigger triggerNode="palletTrigger" aiNode="unloadTriggerAINode" fillTypes="GARLIC COOKING_SALT CARTONROLL"/>
        </sellingStation>

        <effectNodes>
            <effectNode effectClass="ParticleEffect" effectNode="smokeEffectShape01" particleType="SMOKE" materialType="smokeParticle" emitCountScale="0.5"/>
            <effectNode effectClass="ParticleEffect" effectNode="smokeEffectShape02" particleType="SMOKE" materialType="smokeParticle" emitCountScale="0.5"/>
        </effectNodes>

        <palletSpawner>
            <spawnPlaces>
                <spawnPlace startNode="palletAreaStart01" endNode="palletAreaEnd01" />
                <spawnPlace startNode="palletAreaStart02" endNode="palletAreaEnd02" />
            </spawnPlaces>
        </palletSpawner>

        <playerTrigger node="playerTrigger" />

        <sounds>
            <idle   template="dairyIdle" linkNode="0>" />
            <active template="dairyWork" linkNode="0>" />
        </sounds>
    </productionPoint>

    <triggerMarkers>
        <triggerMarker node="warningStripes01"/>
        <triggerMarker node="warningStripes02"/>
        <triggerMarker node="playerTriggerMarker" adjustToGround="true" groundOffset="0.4" filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
        <triggerMarker node="unloadTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconUnload.i3d"/>
    </triggerMarkers>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker" teleportNode="unloadTriggerMarker" />
    </hotspots>

    <i3dMappings>
        <i3dMapping id="dairyPlaceable" node="0>" />
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="testAreaStart01" node="0>1|0" />
        <i3dMapping id="testAreaEnd01" node="0>1|0|0" />
        <i3dMapping id="indoorAreaStart01" node="0>2|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>2|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>2|0|1" />
        <i3dMapping id="indoorAreaStart02" node="0>2|1" />
        <i3dMapping id="indoorAreaWidth02" node="0>2|1|0" />
        <i3dMapping id="indoorAreaHeight02" node="0>2|1|1" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>3|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>3|0|0" />
        <i3dMapping id="realLightsLow" node="0>4|0" />
        <i3dMapping id="realLightsHigh" node="0>4|1" />
        <i3dMapping id="sellingStation" node="0>5" />
        <i3dMapping id="unloadTriggerMarker" node="0>5|0" />
        <i3dMapping id="unloadTrigger" node="0>5|1" />
        <i3dMapping id="palletTrigger" node="0>5|2" />
        <i3dMapping id="unloadTriggerAINode" node="0>5|3" />
        <i3dMapping id="warningStripes02" node="0>5|4" />
        <i3dMapping id="playerTriggerMarker" node="0>6|0" />
        <i3dMapping id="playerTrigger" node="0>6|1" />
        <i3dMapping id="smokeEffectShape01" node="0>6|2|0" />
        <i3dMapping id="smokeEffectShape02" node="0>6|2|1" />
        <i3dMapping id="palletSpawner" node="0>7" />
        <i3dMapping id="palletAreaStart01" node="0>7|0" />
        <i3dMapping id="palletAreaEnd01" node="0>7|0|0" />
        <i3dMapping id="palletAreaStart02" node="0>7|1" />
        <i3dMapping id="palletAreaEnd02" node="0>7|1|0" />
        <i3dMapping id="warningStripes" node="0>7|2" />
        <i3dMapping id="warningStripes01" node="0>7|2|0" />
        <i3dMapping id="infoTrigger" node="0>8" />
    </i3dMappings>
</placeable>
