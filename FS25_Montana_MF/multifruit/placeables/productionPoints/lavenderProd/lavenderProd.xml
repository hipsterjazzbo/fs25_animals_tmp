        <vertexBufferMemoryUsage>776448</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>178432</indexBufferMemoryUsage>
        <textureMemoryUsage>12976128</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
