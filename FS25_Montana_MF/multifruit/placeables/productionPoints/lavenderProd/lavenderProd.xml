            <capacity fillType="ANIMAL_FAT" 		capacity="100000" />
            <capacity fillType="OLIVE_OIL" 		capacity="100000" />
            <capacity fillType="CARTONROLL" 		capacity="100000" />
            <capacity fillType="PAPERROLL" 		capacity="100000" />
