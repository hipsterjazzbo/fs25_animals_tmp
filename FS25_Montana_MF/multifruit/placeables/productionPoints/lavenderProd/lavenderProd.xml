                </outputs>
            </production>

	<production id="vegetal_soap2" name="$l10n_fillType_soap" cyclesPerHour="1" costsPerActiveHour="10">
                <inputs>
                    <input fillType="MINT" amount="1200" /> 
                    <input fillType="OLIVE_OIL" amount="200" />
                    <input fillType="CARTONROLL" amount="15" />
                    <input fillType="PAPERROLL" amount="25" />
                </inputs>
                <outputs>
                    <output fillType="SOAP" amount="450" />
                </outputs>
            </production>

	<production id="lavenderOil" name="$l10n_fillType_lavenderOil" cyclesPerHour="2" costsPerActiveHour="5">
                <inputs>
                    <input fillType="LAVENDER" amount="1000" /> 
                    <input fillType="CARTONROLL" amount="20" /> 
                </inputs>
                <outputs>
                    <output fillType="LAVENDER_OIL" amount="300" />  
                </outputs>
            </production>

	<production id="mintOil" name="$l10n_fillType_mintOil" cyclesPerHour="2" costsPerActiveHour="5">
                <inputs>
                    <input fillType="MINT" amount="1000" /> 
                    <input fillType="CARTONROLL" amount="20" /> 
                </inputs>
                <outputs>
                    <output fillType="MINT_OIL" amount="300" />  
                </outputs>
            </production>

