    <productionPoint>
        <productions sharedThroughputCapacity="false">

	<production id="perfume" name="$l10n_fillType_perfume" cyclesPerHour="1" costsPerActiveHour="15">
                <inputs>
                    <input fillType="LAVENDER" amount="1100" />  
                    <input fillType="ETHANOL" amount="500" /> 
                    <input fillType="CARTONROLL" amount="10" /> 
                </inputs>
                <outputs>
                    <output fillType="PERFUME" amount="400" /> 
                </outputs>
            </production>

	<production id="soap1" name="$l10n_fillType_soap" cyclesPerHour="1" costsPerActiveHour="10">
                <inputs>
                    <input fillType="LAVENDER" amount="1200" /> 
                    <input fillType="ANIMAL_FAT" amount="250" />
                    <input fillType="CARTONROLL" amount="15" />
                    <input fillType="PAPERROLL" amount="25" />
                </inputs>
                <outputs>
                    <output fillType="SOAP" amount="450" />
                </outputs>
            </production>

	<production id="soap2" name="$l10n_fillType_soap" cyclesPerHour="1" costsPerActiveHour="10">
                <inputs>
