            <capacity fillType="LAVENDER_OIL"          	capacity="50000" />
            <capacity fillType="MINT_OIL"          	capacity="50000" />

        </storage>

        <sellingStation node="sellingStation" supportsExtension="false" allowMissions="false" appearsOnStats="false" hideFromPricesMenu="true" >
            <unloadTrigger exactFillRootNode="unloadTrigger" aiNode="unloadTriggerAINode" fillTypes="LAVENDER MINT"/>
		<baleTrigger triggerNode="baleTrigger" deleteLitersPerSecond="2000" fillTypes="LAVENDER"/>
		<palletTrigger triggerNode="palletTrigger" deleteLitersPerSecond="2000" aiNode="unloadTriggerAINode" fillTypes="ETHANOL ANIMAL_FAT OLIVE_OIL CARTONROLL PAPERROLL" />		
        </sellingStation>

