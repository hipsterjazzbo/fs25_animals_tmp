<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="greenhouse" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_shopItem_greenHousesSaplings</name>
        <functions>
            <function>$l10n_function_productionPoint</function>
        </functions>
        <image>multifruit/placeables/greenhouses/textures/store_greenHouseSaplings.dds</image>
        <price>3000</price>
        <dailyUpkeep>30</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>JINKOU</brand>
        <species>PLACEABLE</species>
        <category>placeableMisc</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>greenhouses</tab>
        </brush>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <vertexBufferMemoryUsage>1297664</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>302336</indexBufferMemoryUsage>
        <textureMemoryUsage>10682368</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <filename>multifruit/placeables/greenhouses/greenHouseSaplings.i3d</filename>
	<boughtWithFarmland>true</boughtWithFarmland>
	<canBeDeleted>true</canBeDeleted>
	<canBeRenamed>true</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>

        <sounds>
            <place template="medImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="1" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="asphalt"/>
        </levelAreas>
        <paintAreas>
            <paintArea startNode="paintAreaStart01" widthNode="paintAreaWidth01" heightNode="paintAreaHeight01" groundType="dirt"/>
        </paintAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01"/>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger" />

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker" teleportNode="teleportNode" />
    </hotspots>

    <triggerMarkers>
        <triggerMarker node="warningStripes" />
        <triggerMarker node="playerTriggerMarker" filename="$data/shared/assets/marker/markerIconWrench.i3d" adjustToGround="true" />
        <triggerMarker node="unloadTriggerMarker" filename="$data/shared/assets/marker/markerIconWater.i3d"  adjustToGround="true" />
        <triggerMarker node="unloadTriggerMarker1" filename="$data/shared/assets/marker/markerIconUnload.i3d"  adjustToGround="true" />
         <triggerMarker node="unloadTriggerMarker2" filename="$data/shared/assets/marker/markerIconUnload.i3d"  adjustToGround="true" />
    </triggerMarkers>

    <greenhouse>
        <plants>
            <plant fillType="RICESAPLINGS" xmlFilename="$data/placeables/brandless/greenhouses/vegetables/riceSaplings/riceSaplings.xml" />
        </plants>

        <plantSpaces>
            <spacesParent node="plantNodes" useRandomYRot="false" />
        </plantSpaces>

        <sounds>
            <watering template="defaultSprayer" linkNode="0>" loops="0" />
        </sounds>
    </greenhouse>

    <productionPoint>
        <productions>

<!--RICESAPLINGS-->            
<!--Productions with seeds-->
	<production id="riceSaplingsS" name="%s + %s" params="$l10n_fillType_riceSaplings|$l10n_fillType_seeds" cyclesPerHour="2" costsPerActiveHour="0.1">
                <inputs>
                    <input fillType="WATER" amount="3" />
                    <input fillType="SEEDS" amount="1" />
                </inputs>
                <outputs>
                    <output fillType="RICESAPLINGS" amount="1" />
                </outputs>
            </production>
        
<!--Productions with seeds and fertilizer-->
            <production id="riceSaplingsSF" name="%s + %s + %s" params="$l10n_fillType_riceSaplings|$l10n_fillType_seeds|$l10n_fillType_fertilizer" cyclesPerHour="4" costsPerActiveHour="0.2">
                <inputs>
                    <input fillType="WATER" amount="4" />
                    <input fillType="FERTILIZER" amount="1" />
                    <input fillType="SEEDS" amount="1" />
                </inputs>
                <outputs>
                    <output fillType="RICESAPLINGS" amount="3" />
                </outputs>
            </production>
        
<!--Productions with seeds and manure-->
            <production id="riceSaplingsSM" name="%s + %s + %s" params="$l10n_fillType_riceSaplings|$l10n_fillType_seeds|$l10n_fillType_manure" cyclesPerHour="4" costsPerActiveHour="0.2">
                <inputs>
                    <input fillType="WATER" amount="4" />
                    <input fillType="MANURE" amount="5" />
                    <input fillType="SEEDS" amount="1" />
                </inputs>
                <outputs>
                    <output fillType="RICESAPLINGS" amount="4" />
                </outputs>
            </production>
            
        </productions>

        <sellingStation node="sellingStation" appearsOnStats="true" supportsExtension="false">
            <unloadTrigger exactFillRootNode="exactFillRootNode" fillTypes="WATER LIQUIDMANURE LIQUIDFERTILIZER DIGESTATE" aiNode="unloadTriggerAINode">
			<fillTypeConversion ratio="1.1" incomingFillType="LIQUIDFERTILIZER" 	outgoingFillType="FERTILIZER" />
			<fillTypeConversion ratio="0.8" incomingFillType="LIQUIDMANURE" 	outgoingFillType="MANURE" />
			<fillTypeConversion ratio="0.6" incomingFillType="DIGESTATE" 		outgoingFillType="MANURE" />
			</unloadTrigger>
            <unloadTrigger exactFillRootNode="exactFillRootNode1" fillTypes="MANURE COMPOST" aiNode="unloadTriggerAINode1">
			<fillTypeConversion ratio="0.8" incomingFillType="COMPOST" 	outgoingFillType="MANURE" />
			</unloadTrigger>
            <unloadTrigger exactFillRootNode="exactFillRootNode2" fillTypes="FERTILIZER SEEDS" aiNode="unloadingStationAINode2"/>
        </sellingStation>

        <loadingStation fillTypes="WATER" supportsExtension="true" />
        <loadingStation fillTypes="MANURE" supportsExtension="true" />
        <loadingStation fillTypes="FERTILIZER" supportsExtension="true" />
        <loadingStation fillTypes="SEEDS" supportsExtension="true" />

        <palletSpawner>
            <spawnPlaces>
                <spawnPlace startNode="spawnPlaceStart01" endNode="spawnPlaceEnd01" />
            </spawnPlaces>
        </palletSpawner>

        <storage node="storage" isExtension="false" fillTypes="WATER" fillLevelSyncThreshold="10" >     
            <capacity fillType="WATER"        		capacity="10000" />
            <capacity fillType="SEEDS"        		capacity="3000" />
            <capacity fillType="FERTILIZER"   		capacity="5000" />
            <capacity fillType="MANURE"   		capacity="10000" />
            <capacity fillType="RICESAPLINGS" 		capacity="1000" />
            <fillPlane maxY="0" fillType="MANURE" node="manure_Plane" minY="-1.055"/>
        </storage>

        <playerTrigger node="playerTrigger" />
    </productionPoint>

    <animatedObjects>
        <animatedObject saveId="door1" >
            <animation duration="3">
                <part node="door1Left">
                    <keyFrame time="0.1" rotation="0 0 0"/>
                    <keyFrame time="1.0" rotation="0 90 0"/>
                </part>
            </animation>
            <controls triggerNode="door1Trigger" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor" />
            <sounds>
                <moving linkNode="door1" template="glassDoorLoop" />
                <negEnd linkNode="door1" template="metalDoorsClose" />
                <posEnd linkNode="door1" template="metalDoorsOpen" />
            </sounds>
        </animatedObject>
        <animatedObject saveId="door2" >
            <animation duration="3">
                <part node="door2Right">
                    <keyFrame time="0.1" rotation="0 0 0"/>
                    <keyFrame time="1.0" rotation="0 90 0"/>
                </part>
            </animation>
            <controls triggerNode="door2Trigger" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor" />
            <sounds>
                <moving linkNode="door2" template="glassDoorLoop" />
                <negEnd linkNode="door2" template="metalDoorsClose" />
                <posEnd linkNode="door2" template="metalDoorsOpen" />
            </sounds>
        </animatedObject>
    </animatedObjects>

    <i3dMappings>
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="levelAreaStart01" node="0>1|0" />
        <i3dMapping id="levelAreaWidth01" node="0>1|0|0" />
        <i3dMapping id="levelAreaHeight01" node="0>1|0|1" />
        <i3dMapping id="paintAreaStart01" node="0>2|0" />
        <i3dMapping id="paintAreaWidth01" node="0>2|0|0" />
        <i3dMapping id="paintAreaHeight01" node="0>2|0|1" />
        <i3dMapping id="indoorAreaStart01" node="0>3|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>3|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>3|0|1" />
        <i3dMapping id="testAreaStart01" node="0>4|0" />
        <i3dMapping id="testAreaEnd01" node="0>4|0|0" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>5|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>5|0|0" />
        <i3dMapping id="plantNodes" node="0>6|0" />
        <i3dMapping id="palletSpawner" node="0>6|2" />
        <i3dMapping id="spawnPlaceStart01" node="0>6|2|0" />
        <i3dMapping id="spawnPlaceEnd01" node="0>6|2|0|0" />
        <i3dMapping id="sellingStation" node="0>6|3" />
        <i3dMapping id="exactFillRootNode" node="0>6|3|0" />
        <i3dMapping id="unloadTriggerMarker" node="0>6|3|1" />
        <i3dMapping id="unloadTriggerAINode" node="0>6|3|2" />
        <i3dMapping id="storage" node="0>6|4" />
        <i3dMapping id="playerTrigger" node="0>6|5" />
        <i3dMapping id="playerTriggerMarker" node="0>6|6" />
        <i3dMapping id="teleportNode" node="0>6|7" />
        <i3dMapping id="door1" node="0>7|0" />
        <i3dMapping id="door1Left" node="0>7|0|0" />
        <i3dMapping id="door1Trigger" node="0>7|0|1" />
        <i3dMapping id="door2" node="0>7|1" />
        <i3dMapping id="door2Right" node="0>7|1|0" />
        <i3dMapping id="door2Trigger" node="0>7|1|1" />
        <i3dMapping id="warningStripes" node="0>8" />
        <i3dMapping id="infoTrigger" node="0>9" />
        <i3dMapping id="sellingStation1" node="0>12|1" />
        <i3dMapping id="fillVolume1" node="0>12|0|0" />
        <i3dMapping id="exactFillRootNode1" node="0>12|1|0" />
        <i3dMapping id="unloadTriggerMarker1" node="0>12|1|1" />
        <i3dMapping id="unloadTriggerAINode1" node="0>12|1|2" />
        <i3dMapping id="sellingStation2" node="0>13|0|0" />
        <i3dMapping id="exactFillRootNode2" node="0>13|0|0|0" />
        <i3dMapping id="unloadingStationAINode2" node="0>13|0|0|1" />
        <i3dMapping id="unloadTriggerMarker2" node="0>13|0|0|2" />
        <i3dMapping id="manure_Plane" node="0>12|3" />

    </i3dMappings>
</placeable>
