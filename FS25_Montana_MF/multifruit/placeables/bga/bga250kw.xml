<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_storeItem_planET_bga250kw</name>
        <functions>
            <function>$l10n_function_productionPoint</function>
        </functions>
        <image>$data/placeables/planET/bga250kw/store_bga250kw.png</image>
        <price>875000</price>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>JINKOU</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>factories</tab>
        </brush>
        <vertexBufferMemoryUsage>0</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>0</indexBufferMemoryUsage>
        <textureMemoryUsage>0</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>

        <storeIconRendering>
            <settings cameraXRot="-30" cameraYRot="-30" advancedBoundingBox="true"/>
        </storeIconRendering>
    </storeData>

    <base>
        <filename>$data/placeables/planET/bga250kw/bga250kw.i3d</filename>
	<boughtWithFarmland>true</boughtWithFarmland>
	<canBeDeleted>true</canBeDeleted>
	<canBeRenamed>true</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
            <testArea startNode="testAreaStart02" endNode="testAreaEnd02" />
            <testArea startNode="testAreaStart03" endNode="testAreaEnd03" />
        </testAreas>

        <sounds>
            <place template="medImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30" >
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="asphalt"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01"/>
        <indoorArea startNode="indoorAreaStart02" widthNode="indoorAreaWidth02" heightNode="indoorAreaHeight02"/>
        <indoorArea startNode="indoorAreaStart03" widthNode="indoorAreaWidth03" heightNode="indoorAreaHeight03"/>
        <indoorArea startNode="indoorAreaStart04" widthNode="indoorAreaWidth04" heightNode="indoorAreaHeight04"/>
        <indoorArea startNode="indoorAreaStart05" widthNode="indoorAreaWidth05" heightNode="indoorAreaHeight05"/>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger"/>

    <triggerMarkers>
        <triggerMarker node="unloadTriggerBunkerMarker"       filename="$data/shared/assets/marker/markerIconUnload.i3d" adjustToGround="false" />
        <triggerMarker node="unloadTriggerLiquidManureMarker" filename="$data/shared/assets/marker/markerIconUnload.i3d" adjustToGround="true" />
        <triggerMarker node="loadTriggerMarker"               filename="$data/shared/assets/marker/markerIconLoad.i3d"   adjustToGround="true" />
        <triggerMarker node="playerTriggerMarker"             filename="$data/shared/assets/marker/markerIconWrench.i3d" adjustToGround="true" />
    </triggerMarkers>

    <dynamicallyLoadedParts>
        <dynamicallyLoadedPart filename="$data/effects/chimneySmoke/smokeTrailSubUV.i3d" node="1" linkNode="smokeSmall01" shaderParameterName="colorAlpha" shaderParameter="0.5 0.5 0.5 0.5"/>
    </dynamicallyLoadedParts>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="hotspotMarker" teleportNode="teleportNode"/>
    </hotspots>

    <productionPoint>
        <productions sharedThroughputCapacity="false">
            
<production id="biogas" name="$l10n_fillType_silage" cyclesPerHour="1" costsPerActiveHour="6">
                <inputs>
                    <input fillType="SILAGE" amount="2243" />
                </inputs>
                <outputs>
                    <output fillType="ELECTRICCHARGE" amount="1545" sellDirectly="true"/>
                    <output fillType="METHANE"        amount="22"   sellDirectly="true"/>
                    <output fillType="DIGESTATE"      amount="1820" />
                </outputs>
            </production>
            
<production id="biogasLiquidManure" name="$l10n_fillType_liquidManure" cyclesPerHour="1" costsPerActiveHour="6">
                <inputs>
                    <input fillType="LIQUIDMANURE" amount="510" />
                    <input fillType="STRAW" amount="2550" />
                </inputs>
                <outputs>
                    <output fillType="ELECTRICCHARGE" amount="406" sellDirectly="true"/>
                    <output fillType="METHANE"        amount="22"  sellDirectly="true"/>
                    <output fillType="DIGESTATE"      amount="610" />
                </outputs>
            </production>
            
<production id="biogasManure" name="$l10n_fillType_manure" cyclesPerHour="1" costsPerActiveHour="6">
                <inputs>
                    <input fillType="MANURE" amount="510" />
                </inputs>
                <outputs>
                    <output fillType="ELECTRICCHARGE" amount="306" sellDirectly="true"/>
                    <output fillType="METHANE"        amount="22"  sellDirectly="true"/>
                    <output fillType="DIGESTATE"      amount="510" />
                </outputs>
            </production>
            
<production id="biogasSugarbeetCut" name="$l10n_fillType_sugarBeetCut" cyclesPerHour="1" costsPerActiveHour="6">
                <inputs>
                    <input fillType="SUGARBEET_CUT" amount="305" />
                    <input fillType="MISCANTHUS_CUT" amount="1550" />
                </inputs>
                <outputs>
                    <output fillType="ELECTRICCHARGE" amount="303" sellDirectly="true"/>
                    <output fillType="METHANE"        amount="22"  sellDirectly="true"/>
                    <output fillType="DIGESTATE"      amount="255" />
                </outputs>
            </production>

        </productions>

        <sellingStation node="sellingStation" appearsOnStats="true" supportsExtension="true">
            <unloadTrigger exactFillRootNode="unloadTriggerLiquidManure" fillTypes="LIQUIDMANURE" aiNode="unloadTriggerLiquidManureAiNode" />
	<unloadTrigger exactFillRootNode="unloadTriggerMixer" fillTypes="TARO_CUT CROP_FERMENTED GRASS_FERMENTED SILAGE ALFALFA_FERMENTED CLOVER_FERMENTED STRAW BEANSTRAW CORN_STALKS MISCANTHUS_CUT MANURE SUGARBEET_CUT BEETROOT_CUT CARROT_CUT PARSNIP_CUT POTATO_CUT" >
			<fillTypeConversion ratio="1.5" incomingFillType="ALFALFA_FERMENTED" 	outgoingFillType="SILAGE" />
			<fillTypeConversion ratio="1.5" incomingFillType="CLOVER_FERMENTED" 	outgoingFillType="SILAGE" />
			<fillTypeConversion ratio="0.9" incomingFillType="GRASS_FERMENTED" 	outgoingFillType="SILAGE" />
			<fillTypeConversion ratio="1.7" incomingFillType="CROP_FERMENTED" 	outgoingFillType="SILAGE" />
			<fillTypeConversion ratio="1" incomingFillType="POTATO_CUT" 		outgoingFillType="SUGARBEET_CUT" />
			<fillTypeConversion ratio="1" incomingFillType="PARSNIP_CUT" 		outgoingFillType="SUGARBEET_CUT" />
			<fillTypeConversion ratio="1" incomingFillType="BEETROOT_CUT" 		outgoingFillType="SUGARBEET_CUT" />
			<fillTypeConversion ratio="1" incomingFillType="CARROT_CUT" 		outgoingFillType="SUGARBEET_CUT" />
			<fillTypeConversion ratio="1" incomingFillType="TARO_CUT" 		outgoingFillType="SUGARBEET_CUT" />
			<fillTypeConversion ratio="1" incomingFillType="BEANSTRAW" 		outgoingFillType="STRAW" />
			<fillTypeConversion ratio="1" incomingFillType="CORN_STALKS" 		outgoingFillType="STRAW" />
			</unloadTrigger>
            <baleTrigger triggerNode="baleTrigger" fillTypes="TARO_CUT CROP_FERMENTED GRASS_FERMENTED SILAGE ALFALFA_FERMENTED CLOVER_FERMENTED STRAW BEANSTRAW CORN_STALKS MISCANTHUS_CUT MANURE SUGARBEET_CUT BEETROOT_CUT CARROT_CUT PARSNIP_CUT POTATO_CUT">
			<fillTypeConversion ratio="1.5" incomingFillType="ALFALFA_FERMENTED" 	outgoingFillType="SILAGE" />
			<fillTypeConversion ratio="1.5" incomingFillType="CLOVER_FERMENTED" 	outgoingFillType="SILAGE" />
			<fillTypeConversion ratio="0.9" incomingFillType="GRASS_FERMENTED" 	outgoingFillType="SILAGE" />
			<fillTypeConversion ratio="1.7" incomingFillType="CROP_FERMENTED" 	outgoingFillType="SILAGE" />
			<fillTypeConversion ratio="1" incomingFillType="POTATO_CUT" 		outgoingFillType="SUGARBEET_CUT" />
			<fillTypeConversion ratio="1" incomingFillType="PARSNIP_CUT" 		outgoingFillType="SUGARBEET_CUT" />
			<fillTypeConversion ratio="1" incomingFillType="BEETROOT_CUT" 		outgoingFillType="SUGARBEET_CUT" />
			<fillTypeConversion ratio="1" incomingFillType="CARROT_CUT" 		outgoingFillType="SUGARBEET_CUT" />
			<fillTypeConversion ratio="1" incomingFillType="TARO_CUT" 		outgoingFillType="SUGARBEET_CUT" />
			<fillTypeConversion ratio="1" incomingFillType="BEANSTRAW" 		outgoingFillType="STRAW" />
			<fillTypeConversion ratio="1" incomingFillType="CORN_STALKS" 		outgoingFillType="STRAW" />
			</baleTrigger>

            <unloadTrigger exactFillRootNode="unloadTriggerInFront" fillTypes="TARO_CUT CROP_FERMENTED GRASS_FERMENTED SILAGE ALFALFA_FERMENTED CLOVER_FERMENTED STRAW BEANSTRAW CORN_STALKS MISCANTHUS_CUT MANURE SUGARBEET_CUT BEETROOT_CUT CARROT_CUT PARSNIP_CUT POTATO_CUT" aiNode="unloadTriggerInFrontAINode">
			<fillTypeConversion ratio="1.5" incomingFillType="ALFALFA_FERMENTED" 	outgoingFillType="SILAGE" />
			<fillTypeConversion ratio="1.5" incomingFillType="CLOVER_FERMENTED" 	outgoingFillType="SILAGE" />
			<fillTypeConversion ratio="0.9" incomingFillType="GRASS_FERMENTED" 	outgoingFillType="SILAGE" />
			<fillTypeConversion ratio="1.7" incomingFillType="CROP_FERMENTED" 	outgoingFillType="SILAGE" />
			<fillTypeConversion ratio="1" incomingFillType="POTATO_CUT" 		outgoingFillType="SUGARBEET_CUT" />
			<fillTypeConversion ratio="1" incomingFillType="PARSNIP_CUT" 		outgoingFillType="SUGARBEET_CUT" />
			<fillTypeConversion ratio="1" incomingFillType="BEETROOT_CUT" 		outgoingFillType="SUGARBEET_CUT" />
			<fillTypeConversion ratio="1" incomingFillType="CARROT_CUT" 		outgoingFillType="SUGARBEET_CUT" />
			<fillTypeConversion ratio="1" incomingFillType="TARO_CUT" 		outgoingFillType="SUGARBEET_CUT" />
			<fillTypeConversion ratio="1" incomingFillType="BEANSTRAW" 		outgoingFillType="STRAW" />
			<fillTypeConversion ratio="1" incomingFillType="CORN_STALKS" 		outgoingFillType="STRAW" />
			</unloadTrigger>
            <baleTrigger triggerNode="baleTriggerInFront" fillTypes="TARO_CUT CROP_FERMENTED GRASS_FERMENTED SILAGE ALFALFA_FERMENTED CLOVER_FERMENTED STRAW BEANSTRAW CORN_STALKS MISCANTHUS_CUT MANURE SUGARBEET_CUT BEETROOT_CUT CARROT_CUT PARSNIP_CUT POTATO_CUT">
			<fillTypeConversion ratio="1.5" incomingFillType="ALFALFA_FERMENTED" 	outgoingFillType="SILAGE" />
			<fillTypeConversion ratio="1.5" incomingFillType="CLOVER_FERMENTED" 	outgoingFillType="SILAGE" />
			<fillTypeConversion ratio="0.9" incomingFillType="GRASS_FERMENTED" 	outgoingFillType="SILAGE" />
			<fillTypeConversion ratio="1.7" incomingFillType="CROP_FERMENTED" 	outgoingFillType="SILAGE" />
			<fillTypeConversion ratio="1" incomingFillType="POTATO_CUT" 		outgoingFillType="SUGARBEET_CUT" />
			<fillTypeConversion ratio="1" incomingFillType="PARSNIP_CUT" 		outgoingFillType="SUGARBEET_CUT" />
			<fillTypeConversion ratio="1" incomingFillType="BEETROOT_CUT" 		outgoingFillType="SUGARBEET_CUT" />
			<fillTypeConversion ratio="1" incomingFillType="CARROT_CUT" 		outgoingFillType="SUGARBEET_CUT" />
			<fillTypeConversion ratio="1" incomingFillType="TARO_CUT" 		outgoingFillType="SUGARBEET_CUT" />
			<fillTypeConversion ratio="1" incomingFillType="BEANSTRAW" 		outgoingFillType="STRAW" />
			<fillTypeConversion ratio="1" incomingFillType="CORN_STALKS" 		outgoingFillType="STRAW" />
			</baleTrigger>
        </sellingStation>

        <loadingStation fillTypes="MANURE LIQUIDMANURE" supportsExtension="true">
            <loadTrigger triggerNode="loadTrigger" fillTypes="DIGESTATE" aiNode="loadTriggerAiNode"/>
        </loadingStation>

        <storage isExtension="false" fillLevelSyncThreshold="100">
            <capacity fillType="SILAGE"        			capacity="104000" />
            <capacity fillType="STRAW"        			capacity="104000" />
            <capacity fillType="MISCANTHUS_CUT"        		capacity="104000" />
            <capacity fillType="LIQUIDMANURE"  			capacity="30000" />
            <capacity fillType="MANURE"        			capacity="30000" />
            <capacity fillType="SUGARBEET_CUT" 			capacity="14000" />
            <capacity fillType="DIGESTATE"     			capacity="516000" />

            <dynamicFillPlane node="bunkerFillVolume" allSidePlanes="false" maxAllowedHeapAngle="10" maxDelta="0.3" defaultFillType="SILAGE" />
        </storage>

        <playerTrigger node="playerTrigger" />

        <sounds>
            <idle template="biogasPlantTemplate" linkNode="0>" outerRadius="50"/>
            <active template="dairyWork" linkNode="0>" outerRadius="50"/>
        </sounds>
