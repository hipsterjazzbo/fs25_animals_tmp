     <husbandry saveId="Animals_GOOSE" hasStatistics="false">
        <storage node="storage" fillTypes="WATER" isExtension="false">
            <capacity fillType="WATER" capacity="0" />
        </storage>

        <unloadingStation supportsExtension="false" hideFromPricesMenu="true" />

        <loadingStation supportsExtension="false" />


        <animals type="GOOSE" baseMaxNumAnimals="150" maxNumAnimals="750" maxNumVisualAnimals="100">
            <navigation shape="navigationMeshShape"/>
            <loadingTrigger node="loadingTrigger" />
        </animals>

        <food capacity="15000" >
            <unloadTrigger exactFillRootNode="exactFillRootNodeFood" />
            <foodPlane node="foodPlane" minY="0.098" maxY="0.210" changeVisibility="true" defaultFillType="WHEAT"/>
        </food>

<water automaticWaterSupply="true" />

        <pallets>
            <palletSpawner fillTypes="DUCK_EGG" maxNumPallets="6">
                <palletTrigger node="palletTrigger" />
                <spawnPlaces>
                    <spawnPlace startNode="palletAreaStart01" endNode="palletAreaEnd01" />
                    <spawnPlace startNode="palletAreaStart02" endNode="palletAreaEnd02" />
                </spawnPlaces>
            </palletSpawner>
        </pallets>

        <fence xmlFilename="$data/placeables/brandless/fences/husbandries/chickenNetFence/chickenNetFence.xml">
            <sections>
                <section segmentId="SEGMENT" customizable="true" >
                    <node node="fence1Node1" />
                    <node node="fence1Node2" />
                    <node node="fence1Node3" />
                    <node node="fence1Node4" />
                </section>
            </sections>
        </fence>

        <meadow>
            <createTask weedState="0">
                <decoFoliage name="grassShort" />
                <ground type="NONE" />
                <terrainGroundType name="grass" />
            </createTask>
        </meadow>
    </husbandry>

