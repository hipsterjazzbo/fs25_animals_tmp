<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="mapGooseHusbandry" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_shopItem_duckGoosePasture</name>
        <image>$data/placeables/brandless/animalHusbandries/chickenBarnSmall/store_chickenBarnSmall.dds</image>
        <price>3450</price>
        <functions>
            <function>$l10n_function_animalPenDuck</function>
            <function>$l10n_function_adjustableMeadow</function>
        </functions>
        <lifetime>1000</lifetime>
        <dailyUpkeep>10</dailyUpkeep>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>animalpens</category>
        <brush>
            <type>husbandry</type>
            <category>animals</category>
            <tab>chickens</tab>
        </brush>
        <vertexBufferMemoryUsage>0</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>0</indexBufferMemoryUsage>
        <textureMemoryUsage>0</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>

        <storeIconRendering>
            <settings cameraXRot="-20" cameraYRot="50" advancedBoundingBox="true"/>
        </storeIconRendering>
    </storeData>

    <base>
        <filename>$data/placeables/brandless/animalHusbandries/chickenBarnSmall/chickenBarnSmall.i3d</filename>
	<boughtWithFarmland>true</boughtWithFarmland>
	<canBeDeleted>true</canBeDeleted>
	<canBeRenamed>true</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testArea1Start" endNode="testArea1End" />
        </testAreas>

        <sounds>
            <place template="smallImp" />
            <placeLayered template="chickenLayer" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearArea1Start" widthNode="clearArea1Width" heightNode="clearArea1Height"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelArea1Start" widthNode="levelArea1Width" heightNode="levelArea1Height" groundType="dirt"/>
        </levelAreas>

        <paintAreas>
            <paintArea startNode="paintArea1Start" widthNode="paintArea1Width" heightNode="paintArea1Height" groundType="grass" />
        </paintAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorArea1Start" widthNode="indoorArea1Width" heightNode="indoorArea1Height" />
    </indoorAreas>

    <foliageAreas>
        <foliageArea startNode="foliageArea1Start" widthNode="foliageArea1Width" heightNode="foliageArea1Height" decoFoliage="grassShort" />
        <foliageArea startNode="foliageArea2Start" widthNode="foliageArea2Width" heightNode="foliageArea2Height" decoFoliage="grassShort" />
    </foliageAreas>

    <triggerMarkers>
        <triggerMarker node="markerFood"    filename="$data/shared/assets/marker/markerIconFood.i3d" />
        <triggerMarker node="markerAnimals" filename="$data/shared/assets/marker/markerIconAnimals.i3d" />
        <triggerMarker node="warningStripes01"/>
    </triggerMarkers>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End" />
        </updateAreas>
    </ai>

  
	<hotspots>
        <hotspot teleportNode="teleportNode" >        
	<customType name="GOOSE" filename="multifruit/placeables/husbandry/mapHotspots1.dds" imageUVs="228 235 100 100" imageResolution="1024 1024" category="ANIMALS"/>
        </hotspot>
    </hotspots>

    <infoTrigger triggerNode="infoTrigger" />

    <husbandry saveId="Animals_GOOSE" hasStatistics="false">

        <animals type="GOOSE" baseMaxNumAnimals="50" maxNumAnimals="150" >
            <navigation rootNode="navigationRootNode" shape="navigationMeshShape" />
            <loadingTrigger node="loadingTrigger" />
        </animals>

        <food capacity="2750" >
            <foodPlane node="foodPlane" minY="0.042" maxY="0.165" changeVisibility="true" defaultFillType="WHEAT"/>
            <unloadTrigger exactFillRootNode="exactFillRootNodeFood" />
            <foodPlaces>
                <foodPlace node="foodPlace1" />
                <foodPlace node="foodPlace2" />
            </foodPlaces>
        </food>

        <pallets>
            <palletSpawner fillTypes="DUCK_EGG" maxNumPallets="8">
                <palletTrigger node="palletTrigger" />
                <spawnPlaces>
                    <spawnPlace startNode="palletArea1Start" endNode="palletArea1End" />
                    <spawnPlace startNode="palletArea2Start" endNode="palletArea2End" />
                </spawnPlaces>
            </palletSpawner>
        </pallets>

        <fence xmlFilename="$data/placeables/brandless/fences/husbandries/chickenNetFence/chickenNetFence.xml">
            <sections>
                <section segmentId="SEGMENT" customizable="false">
                    <node node="fence1Node5" />
                    <node node="fence1Node2" />
                </section>
                <section segmentId="SEGMENT" customizable="true">
                    <node node="fence1Node2" />
                    <node node="fence1Node3" />
                    <node node="fence1Node4" />
                    <node node="fence1Node5" />
                </section>
            </sections>
        </fence>

        <meadow>
            <createTask weedState="0">
                <decoFoliage name="grassShort" />
                <ground type="NONE" />
                <terrainGroundType name="grass" />
            </createTask>
        </meadow>
    </husbandry>

    <i3dMappings>
        <i3dMapping id="clearArea1Start" node="0>0|0" />
        <i3dMapping id="clearArea1Width" node="0>0|0|0" />
        <i3dMapping id="clearArea1Height" node="0>0|0|1" />
        <i3dMapping id="foliageArea1Start" node="0>1|0" />
        <i3dMapping id="foliageArea1Width" node="0>1|0|0" />
        <i3dMapping id="foliageArea1Height" node="0>1|0|1" />
        <i3dMapping id="foliageArea2Start" node="0>1|1" />
        <i3dMapping id="foliageArea2Width" node="0>1|1|0" />
        <i3dMapping id="foliageArea2Height" node="0>1|1|1" />
        <i3dMapping id="levelArea1Start" node="0>2|0" />
        <i3dMapping id="levelArea1Width" node="0>2|0|0" />
        <i3dMapping id="levelArea1Height" node="0>2|0|1" />
        <i3dMapping id="paintArea1Start" node="0>3|0" />
        <i3dMapping id="paintArea1Width" node="0>3|0|0" />
        <i3dMapping id="paintArea1Height" node="0>3|0|1" />
        <i3dMapping id="testArea1Start" node="0>4|0" />
        <i3dMapping id="testArea1End" node="0>4|0|0" />
        <i3dMapping id="indoorArea1Start" node="0>5|0" />
        <i3dMapping id="indoorArea1Width" node="0>5|0|0" />
        <i3dMapping id="indoorArea1Height" node="0>5|0|1" />
        <i3dMapping id="tipOcclusionUpdateArea1Start" node="0>6|0" />
        <i3dMapping id="tipOcclusionUpdateArea1End" node="0>6|0|0" />
        <i3dMapping id="palletTrigger" node="0>7|0" />
        <i3dMapping id="palletArea1Start" node="0>7|1" />
        <i3dMapping id="palletArea1End" node="0>7|1|0" />
        <i3dMapping id="palletArea2Start" node="0>7|2" />
        <i3dMapping id="palletArea2End" node="0>7|2|0" />
        <i3dMapping id="navigationRootNode" node="0>8" />
        <i3dMapping id="navigationMeshShape" node="0>8|0" />
        <i3dMapping id="foodPlane" node="0>9|0" />
        <i3dMapping id="exactFillRootNodeFood" node="0>9|1" />
        <i3dMapping id="foodPlace1" node="0>9|2|0" />
        <i3dMapping id="foodPlace2" node="0>9|2|1" />
        <i3dMapping id="fence1Node1" node="0>10|0|0|0" />
        <i3dMapping id="fence1Node2" node="0>10|0|0|1" />
        <i3dMapping id="fence1Node3" node="0>10|0|0|2" />
        <i3dMapping id="fence1Node4" node="0>10|0|0|3" />
        <i3dMapping id="fence1Node5" node="0>10|0|0|4" />
        <i3dMapping id="markerFood" node="0>10|1|0" />
        <i3dMapping id="warningStripes01" node="0>10|1|1|0" />
        <i3dMapping id="markerAnimals" node="0>10|1|2" />
        <i3dMapping id="teleportNode" node="0>11" />
        <i3dMapping id="infoTrigger" node="0>12" />
        <i3dMapping id="loadingTrigger" node="0>13" />
    </i3dMappings>
</placeable>
