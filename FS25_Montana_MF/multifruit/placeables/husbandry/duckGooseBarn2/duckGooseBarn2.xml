		<i3dMapping id="manureHeap" node="0>8|0" />
		<i3dMapping id="manureLoadingTrigger" node="0>8|0|0" />
		<i3dMapping id="tipArea" node="0>8|0|1" />
		<i3dMapping id="tipAreaStart" node="0>8|0|1|0" />
		<i3dMapping id="tipAreaWidth" node="0>8|0|1|0|0" />
		<i3dMapping id="tipAreaHeight" node="0>8|0|1|0|1" />
		<i3dMapping id="activationTrigger" node="0>8|0|2" />
		
		<i3dMapping id="clearAreaStart" node="0>8|0|3" />
        <i3dMapping id="clearAreaWidth" node="0>8|0|3|0" />
        <i3dMapping id="clearAreaHeight" node="0>8|0|3|1" />
		<i3dMapping id="clearArea1Start" node="0>16|0" />
        <i3dMapping id="clearArea1Width" node="0>16|0|0" />
        <i3dMapping id="clearArea1Height" node="0>16|0|1" />
        <i3dMapping id="levelArea1Start" node="0>17|0" />
        <i3dMapping id="levelArea1Width" node="0>17|0|0" />
        <i3dMapping id="levelArea1Height" node="0>17|0|1" />
